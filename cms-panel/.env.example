# ─────────────────────────────────────────────────────────────────────────────
# Panel CMS de ARCFOX — variables de entorno
# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.
# El sitio usa 4321; el panel usa 4322 para poder correr los dos a la vez.
# ─────────────────────────────────────────────────────────────────────────────

# Puerto del servidor del panel
PORT=4322

# URL pública del panel (subdominio). Ej: https://cms.arcfox.com.ec
PANEL_BASE_URL=http://localhost:4322

# URL pública de PRODUCCIÓN del sitio (para previews de imágenes y enlaces "ver en prod").
SITE_URL=https://arcfox.com.ec
# URL de STAGING (donde el panel publica primero). Los enlaces "ver resultado" del
# agente apuntan aquí. Si se deja vacío, cae a SITE_URL.
STAGE_URL=

# ── Claude / Anthropic ───────────────────────────────────────────────────────
# API key de la consola de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelos por agente (ver src/models.ts para la recomendación y el porqué).
# Si los dejas vacíos, se usan los valores por defecto recomendados.
MODEL_BLOG_AGENT=claude-opus-4-8
MODEL_DESIGN_AGENT=claude-opus-4-8
MODEL_PAGE_AGENT=claude-opus-4-8
MODEL_MEDIA_AGENT=claude-opus-4-8
# Alternativa de costo si el volumen crece: claude-sonnet-5
MODEL_ROUTER=claude-haiku-4-5

# ── Límite de uso del Asistente IA (control de costo/abuso) ──────────────────
# Máx. peticiones al asistente por usuario y por hora (0 = sin límite).
AGENT_RATE_PER_HOUR=30
# Máx. peticiones globales por hora (protege el gasto agregado).
AGENT_RATE_GLOBAL_PER_HOUR=300
# Techo de tokens al mes (input+output). 0 = sin límite; súbelo/bájalo según presupuesto.
AGENT_MONTHLY_TOKEN_BUDGET=0
# (Opcional) Precios para estimar el costo en el escritorio, en USD por millón de
# tokens. Déjalos en 0 para ver solo tokens. Consulta la consola de Anthropic.
AGENT_USD_PER_M_INPUT=0
AGENT_USD_PER_M_OUTPUT=0

# ── GitHub (commits hacia el repo del sitio) ─────────────────────────────────
# Token con permiso de "Contents: Read and write" y "Pull requests: Read and write"
# sobre el repo. Recomendado: GitHub App o fine-grained PAT.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=ARCFOX
# Rama de PUBLICACIÓN: agentes y editor commitean aquí. Por defecto "main" →
# publican DIRECTO a producción ("modo normal"). Para activar el flujo staging
# (publicar a una rama de revisión y promover con el botón "Publicar a producción"),
# pon aquí una rama que tenga su propio deploy (ej. "stage" → stage.iidea.edu.ec)
# y AJUSTA STAGE_URL arriba. Mientras no exista ese deploy, déjalo en "main".
GITHUB_BASE_BRANCH=main
# Rama de PRODUCCIÓN. Si baseBranch == prodBranch, no hay paso de staging.
GITHUB_PROD_BRANCH=main
# Carpeta del sitio Astro dentro del repo (los agentes escriben rutas relativas a esta)
SITE_DIR=

# ── Login con Microsoft 365 (Entra ID) ───────────────────────────────────────
# Registra una app en https://entra.microsoft.com → App registrations → New
# (tipo "Web", redirect URI = PANEL_BASE_URL + /auth/microsoft/callback).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory (tenant) ID. Restringe el login a esa organización.
# Usa el ID del tenant, o "organizations" para cualquier cuenta de trabajo M365.
MICROSOFT_TENANT_ID=organizations
# Solo se permite iniciar sesión a cuentas de este dominio
ALLOWED_EMAIL_DOMAIN=
# Lista opcional de correos permitidos (coma-separados). Si está vacía, basta el dominio.
ALLOWED_EMAILS=
# ── Roles ────────────────────────────────────────────────────────────────────
# Correos (coma-separados) con rol ADMIN. Los admins pueden hacer acciones
# globales/irreversibles: promover a producción, cambiar apariencia/tema,
# gestionar categorías y borrar medios permanentemente. El resto de las cuentas
# autorizadas son EDITORES (editan páginas, carreras y blog, sin esas acciones).
# Si se deja VACÍO, TODOS son admin (compatibilidad con setups de un solo usuario).
ADMIN_EMAILS=
# Secreto para firmar la cookie de sesión (cadena larga y aleatoria).
# OBLIGATORIO en producción (NODE_ENV=production): el arranque falla si falta o
# si es el valor por defecto. Genera uno con: openssl rand -hex 32
SESSION_SECRET=

# Entorno: "production" en el deploy (activa la validación de SESSION_SECRET).
NODE_ENV=

# ── Sesiones persistentes (opcional pero recomendado en producción) ──────────
# Sin esto las sesiones viven en memoria: se pierden al reiniciar y no escalan a
# más de una instancia. Define una URL de Redis para persistirlas. Requiere que
# 'redis' y 'connect-redis' estén instalados (ya son dependencias del panel).
# SESSION_REDIS_URL=redis://default:PASSWORD@host:6379

# ── Monitoreo de errores (opcional) ──────────────────────────────────────────
# Si defines un DSN de Sentry y tienes '@sentry/node' instalado (npm i @sentry/node),
# los errores no manejados se envían a Sentry además de a los logs.
# SENTRY_DSN=

# ── Generación de imágenes por IA ────────────────────────────────────────────
# Proveedor de generación de imágenes: "gemini" | "openai" | "none"
# Claude NO genera imágenes: el agente escribe el prompt y este proveedor lo
# renderiza. Con "none" solo se permite subir/enlazar imágenes manualmente.
IMAGE_PROVIDER=none
# Google Gemini "Nano Banana" (recomendado). API key gratuita en
# https://aistudio.google.com/apikey  →  pon IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=
# Modelo de imagen (opcional). Por defecto gemini-2.5-flash-image; más calidad:
# gemini-3-pro-image (Nano Banana Pro) o gemini-3.1-flash-image.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OpenAI (alternativa, gpt-image-1) → pon IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
