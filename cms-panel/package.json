{
  "name": "arcfox-cms-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panel CMS de ARCFOX: git como base, editor y agentes. No es WordPress ni Storyblok.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "PANEL_LOG_SILENT=1 tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "eval": "PANEL_LOG_SILENT=1 tsx test/evals/run.ts",
    "eval:check": "PANEL_LOG_SILENT=1 tsx test/evals/run.ts --fake && PANEL_LOG_SILENT=1 tsx test/evals/run.ts --fake-sucio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "connect-redis": "^9.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "passport": "^0.7.0",
    "passport-microsoft": "^2.1.0",
    "redis": "^6.1.0",
    "sharp": "^0.35.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
