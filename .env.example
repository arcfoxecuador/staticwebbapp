# Copia este archivo a `.env` y rellena lo que uses. Nada de esto se versiona.

# ── Analítica ───────────────────────────────────────────────────────────────
# Sólo se inyectan tras el consentimiento del visitante (ver Analitica.astro).
# Llevan prefijo PUBLIC_ porque el navegador las necesita; no son secretos.
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=

# ── CMS (opcional) ──────────────────────────────────────────────────────────
# Mientras esté vacío, el sitio construye desde `src/content/`.
# El interruptor de verdad está en src/lib/contenido.ts.
CMS_TOKEN=
CMS_REGION=

# ── Despliegue ──────────────────────────────────────────────────────────────
# Landing teaser (followdafox.com). SOLO_LANDING=1 poda dist/ a la landing.
SOLO_LANDING=
# Dominio canónico del build. Lo lee src/lib/rutas.mjs (sitemap, robots, JSON-LD).
# En el teaser Vercel lo setea (p. ej. https://followdafox.com).
SITE_URL=
# Bot de ioZen en la landing teaser. Vacío = sin chat. El id público es m4zdh.
PUBLIC_IOZEN_BOT=m4zdh
# Alias histórico para previews del sitio principal; rutas.mjs usa SITE_URL.
PUBLIC_SITE_URL=
