---
/* El cierre del formulario de test drive. Aparte de `/gracias` (cotización)
   porque la conversión se marca por URL y son dos conversiones distintas. Como
   la ruta empieza por `/gracias`, queda fuera del sitemap y del robots; el
   `noindex` del <head> lo pone la prop. */
import Base from '../layouts/Base.astro';
import Seccion from '../components/bloques/Seccion.astro';
import Boton from '../components/ui/Boton.astro';
import { FORMULARIO } from '../lib/site';
---

<Base
  titulo="Recibido"
  descripcion="Recibimos tu solicitud de prueba de manejo."
  path={FORMULARIO.graciasPrueba}
  noindex
  barraAccion={false}
>
  <Seccion aire="amplio">
    <div class="max-w-[46ch]">
      <div class="traza mb-8 w-full max-w-[120px]" aria-hidden="true"></div>

      <h1 class="entra equilibra text-h1 font-bold text-marca">Recibido</h1>

      {/* Mismo texto que /gracias, pedido del cliente (19-nov-2026). */}
      <p class="entra entra-2 mt-6 text-lead text-tinta/75">
        ¡Gracias por contactarnos! Un asesor se comunicará contigo.
      </p>

      {/* La salida siempre existe: una página de confirmación sin camino de vuelta
          deja al visitante en un callejón. */}
      <div class="entra entra-3 mt-10 flex flex-wrap gap-4">
        <Boton href="/">Volver al inicio</Boton>
      </div>
    </div>
  </Seccion>
</Base>
