---
/* LA PUERTA DE LANZAMIENTO conserva la composición cerrada de la campaña: una
   sola acción, una sola lectura y el campo azul→morado de la diagramación. El
   cliente decidió no mostrar todavía el vehículo; la intriga queda en el reloj,
   las marcas de registro y el rastro digital, sin identificadores de producto. */

import Teaser from '../layouts/Teaser.astro';
import ProtocoloComando from '../components/ui/ProtocoloComando.astro';
import Marca from '../components/ui/Marca.astro';
import CuentaAtras from '../components/ui/CuentaAtras.astro';
import { LANZAMIENTO } from '../lib/site';
import { grafo, organizacion, pagina, sitioWeb } from '../lib/schema';

interface Props {
  modoFormulario?: 'integrado' | 'flotante';
  pathPagina?: string;
}

const { modoFormulario = 'flotante', pathPagina = LANZAMIENTO.path } = Astro.props;

const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({
    path: pathPagina,
    titulo: LANZAMIENTO.titulo,
    descripcion: LANZAMIENTO.bajada,
  }),
);

/* Las líneas son una decisión de composición, no copias del titular. El
   corte va tras cada coma o punto: «Si esto te encontró, / es para ti.» */
const lineasTitular = LANZAMIENTO.titular.split(/(?<=[,.])\s+/);

---

<Teaser
  titulo={LANZAMIENTO.titulo}
  descripcion={LANZAMIENTO.bajada}
  path={pathPagina}
  {schema}
>
  {/* LA INTRO. Nace `hidden` y sólo el script la enciende: sin JavaScript, o
      con movimiento reducido, la puerta se ve directamente en vez de quedar
      detrás de un velo negro que nadie va a retirar. El `src` también lo pone
      el script, para que esos visitantes no descarguen 3,6 MB que no verán. */}
  <div
    class="intro"
    data-video={LANZAMIENTO.intro.video}
    data-activar={LANZAMIENTO.intro.sonidoActivar}
    data-quitar={LANZAMIENTO.intro.sonidoQuitar}
    hidden
  >
    <video class="intro-video" playsinline preload="auto" aria-hidden="true"></video>

    {/* LA ENTRADA. Tapa el video, que mientras tanto ya se va descargando, y su
        botón es el toque que permite reproducirlo con sonido. */}
    <div class="intro-entrada">
      <div class="entra">
        <Marca tono="blanco" soloSello enlace={false} class="sello-intro" />
      </div>
      <button type="button" class="intro-entrar entra entra-2">
        {LANZAMIENTO.intro.entrar}
      </button>
    </div>

    <button type="button" class="intro-boton intro-sonido" aria-pressed="true">
      {LANZAMIENTO.intro.sonidoQuitar}
    </button>
    <button type="button" class="intro-boton intro-saltar">{LANZAMIENTO.intro.saltar}</button>
  </div>

  {/* Va justo después de la intro y ANTES de la puerta: un script en línea
      detiene el análisis, así que la clase `intro-activa` existe antes de que
      la puerta se pinte y no hay un destello de la página antes del video. */}
  <script is:inline>
    (() => {
      const intro = document.currentScript.previousElementSibling;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return intro.remove();

      const video = intro.querySelector('video');
      const raiz = document.documentElement;
      let cerrada = false;
      let espera;

      /* Al quitar la clase, la puerta se hace visible y sus animaciones de
         entrada —en pausa desde el fotograma cero— arrancan mientras el video
         se desvanece encima: la entrada se ve entera, no terminada a medias. */
      const cerrar = () => {
        if (cerrada) return;
        cerrada = true;
        clearTimeout(espera);
        video.pause();
        raiz.classList.remove('intro-activa');
        intro.classList.add('intro-saliendo');
        setTimeout(() => intro.remove(), 700);
      };

      /* El botón dice lo que HARÁ, no lo que pasa: «Activar sonido» mientras
         está en silencio. `aria-pressed` da el estado al lector de pantalla. */
      const sonido = intro.querySelector('.intro-sonido');
      const pintarSonido = () => {
        sonido.textContent = video.muted ? intro.dataset.activar : intro.dataset.quitar;
        sonido.setAttribute('aria-pressed', String(!video.muted));
      };
      sonido.addEventListener('click', () => {
        video.muted = !video.muted;
        pintarSonido();
      });

      raiz.classList.add('intro-activa');
      intro.hidden = false;
      video.src = intro.dataset.video;
      video.addEventListener('playing', () => clearTimeout(espera), { once: true });
      video.addEventListener('ended', cerrar);
      video.addEventListener('error', cerrar);
      intro.querySelector('.intro-saltar').addEventListener('click', cerrar);

      /* `play()` va DENTRO del clic y sin nada asíncrono delante: el navegador
         sólo permite el sonido si la reproducción nace del gesto. Si aun así
         lo rechaza, se reintenta en silencio y el botón deja activarlo. */
      intro.querySelector('.intro-entrar').addEventListener(
        'click',
        () => {
          intro.classList.add('intro-reproduciendo');
          video.muted = false;
          video
            .play()
            .catch((error) => {
              /* Si la intro ya se cerró, el rechazo es la pausa de `cerrar`:
                 volver a reproducir sonaría con el velo ya retirado. */
              if (cerrada) throw error;
              video.muted = true;
              return video.play();
            })
            .then(pintarSonido, cerrar);

          /* Si en 4 s no ha empezado (red muy lenta), la intro se retira: el
             video es la bienvenida, no un peaje para llegar a la puerta. */
          espera = setTimeout(cerrar, 4000);
        },
        { once: true },
      );
    })();
  </script>

  <section
    data-slot="puerta-lanzamiento"
    class="puerta campo-oscuro relative isolate flex min-h-svh items-center justify-center overflow-clip bg-marca px-5 py-10 text-white"
  >
    {/* El barrido de escaneo. Se quita junto a su bloque de estilos. */}
    <div class="barrido" aria-hidden="true"></div>

    {/* LAS CUATRO MARCAS recuperan el sistema completo de la diapositiva 10:
        cruz central, esquinas incompletas y rastro digital. No son estrellas ni
        partículas; cada grupo marca una coordenada del encuadre. */}
    <div class="marco" aria-hidden="true">
      <span class="marca-registro marca-noroeste" style="--retardo:900ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
      <span class="marca-registro marca-noreste" style="--retardo:1080ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
      <span class="marca-registro marca-suroeste" style="--retardo:1260ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
      <span class="marca-registro marca-sureste" style="--retardo:1440ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
    </div>

    <div class="contenido-puerta relative z-10 flex w-full flex-col items-center text-center">
      <div class="entra">
        <Marca
          tono="blanco"
          soloSello
          enlace={!LANZAMIENTO.soloLanzamiento}
          class="sello-puerta"
        />
      </div>

      {/* El aria-label conserva la frase continua; los tres spans sólo fijan el
          corte editorial que pide la maqueta. */}
      <h1
        class="titulo-puerta entra-titular-hero"
        aria-label={LANZAMIENTO.titular}
      >
        {
          lineasTitular.map((linea) => (
            <span aria-hidden="true">{linea}</span>
          ))
        }
      </h1>

      {/* Orden del cliente: titular grande → ceja (mismo tamaño de siempre) →
          llamada grande. La llamada usa la misma escala que el titular, pero
          es un párrafo: la página tiene un solo h1. */}
      <p class="ceja-puerta entra entra-2">{LANZAMIENTO.ceja}</p>

      <p class="titulo-puerta llamada-puerta entra entra-2">
        <span>{LANZAMIENTO.llamada}</span>
      </p>

      {/* EL RELOJ. Mismo componente y mismo instante que el teaser: quien llega
          por followdafox y luego por el enlace de campaña tiene que ver la misma
          cifra. Centrado, que es la única diferencia de maqueta entre los dos. */}
      <CuentaAtras
        class="cuenta-puerta entra entra-3"
        alineacion="centro"
        destinoISO={LANZAMIENTO.destinoISO}
        fechaVisible={LANZAMIENTO.fechaVisible}
        llegada={LANZAMIENTO.llegada}
        unidades={LANZAMIENTO.unidades}
      />

      <div class="entra entra-4">
        <ProtocoloComando rotulo={LANZAMIENTO.cta} modo={modoFormulario} />
      </div>
    </div>
  </section>
</Teaser>

<style is:global>
  /* EL CAMPO EN TRES CAPAS, y el orden es el de antes de que la luz se moviera:
     base → luz → retícula. Mientras fue un único `background` bastaba con
     listarlas; ahora la luz se anima y un gradiente no se puede mover con
     `transform`, así que sale a su propio pseudo-elemento. La retícula tiene que
     salir con ella: si se quedara en el fondo de `.puerta`, la luz —que es opaca
     en su centro— la taparía justo en el lado izquierdo. Las dos van a
     `z-index: -1`, que dentro del `isolate` de la sección pinta sobre el fondo y
     bajo el contenido; entre ellas decide el orden del árbol, `::before` primero. */
  .puerta {
    min-height: 100svh;
    background: linear-gradient(
      112deg,
      color-mix(in oklab, var(--color-campana-fria) 54%, var(--color-marca)) 0%,
      color-mix(in oklab, var(--color-campana-fria) 18%, var(--color-marca)) 43%,
      color-mix(in oklab, var(--color-campana-calida) 72%, var(--color-marca)) 78%,
      color-mix(in oklab, var(--color-campana-calida) 46%, var(--color-marca)) 100%
    );
  }

  /* LA LUZ QUE RESPIRA. Sobresale un 12% por cada lado para que el recorrido
     nunca deje ver su borde: la luz ya se cortaba en el canto izquierdo del
     encuadre, y sin ese margen el corte viajaría con ella. Con la caja más
     grande, la elipse se reescala para que en reposo sea la MISMA de la
     diagramación: `64% 105% at 8% 52%` sobre el encuadre equivale a
     `51.6% 84.7% at 16.1% 51.6%` sobre una caja del 124%.

     `ease-in-out` de fábrica y no `--ease-in-out`: la curva del sistema es
     fuerte a propósito, y en 22 segundos se quedaría quieta casi todo el ciclo
     para cruzar de golpe a la mitad — o sea, un movimiento que se nota. Aquí se
     busca lo contrario. `alternate` hace que vuelva por el mismo camino, así que
     el ciclo nunca salta al reiniciarse. */
  .puerta::before {
    content: '';
    position: absolute;
    inset: -12%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 51.6% 84.7% at 16.1% 51.6%,
      color-mix(in oklab, var(--color-campana-fria) 82%, var(--color-marca)) 0%,
      color-mix(in oklab, var(--color-campana-fria) 38%, var(--color-marca)) 38%,
      transparent 74%
    );
    animation: respirar-luz 22s ease-in-out infinite alternate;
  }

  /* El fotograma inicial es el reposo aprobado: quien no espere 22 segundos ve
     exactamente la diagramación. */
  @keyframes respirar-luz {
    from {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      opacity: 0.85;
      transform: translate3d(6%, -3%, 0) scale(1.08);
    }
  }

  /* La retícula se queda QUIETA: líneas de 1px en movimiento caen entre píxeles
     y se ven borrosas o parpadean. */
  .puerta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 18px,
        color-mix(in oklab, var(--color-campana-fria) 9%, transparent) 18px 19px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 89px,
        color-mix(in oklab, var(--color-campana-calida) 13%, transparent) 89px 90px
      );
  }

  /* ── BARRIDO DE ESCANEO ─────────────────────────────────────────────────────
     Para quitarlo: este bloque y el `<div class="barrido">` del marcado.

     Una franja que cruza la retícula y descansa: 5,4s de cruce y 3,6s de pausa
     en un ciclo de 9s. `linear` porque es movimiento constante, no una llegada.
     Arranca a los 2,2s, cuando ya terminó la coreografía de entrada — encima de
     ella sería un octavo gesto compitiendo con el titular.

     El recorrido va de -100% a 360% de su propio ancho: con una franja del 28%
     del encuadre, 360% es justo el punto en que sale entera por la derecha. El
     `overflow: clip` de la sección recorta lo que sobra sin crear scroll.

     28% y no 10%: con el fotograma congelado a mitad de cruce, a 10% la captura
     era idéntica a la de sin barrido — azul sobre azul no se ve. El blanco al 8%
     tampoco se distinguía. A 28% es un velo que se nota quieto, así que en
     movimiento se lee sin tener que buscarlo.

     SE REPITE SIN FIN, y la luz de `::before` también, por decisión tomada el
     2026-09-10 sabiendo lo que cuesta: WCAG 2.2.2 pide poder pausar un
     movimiento automático de más de 5s que convive con el contenido, y aquí
     sólo lo apaga `prefers-reduced-motion`. Si hay que cumplirla, la salida
     barata es acotar las repeticiones: 3 pasadas aquí y 2 ciclos en la luz, que
     con `alternate` terminan justo en el reposo.

     El selector va anclado a `.puerta` porque este bloque es `is:global` y
     `.barrido` es un nombre que cualquier otra página podría querer. */
  .puerta > .barrido {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 28%;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in oklab, var(--color-campana-fria) 28%, transparent) 50%,
      transparent
    );
    transform: translateX(-100%);
    animation: escanear 9s linear 2.2s infinite;
  }

  @keyframes escanear {
    from {
      transform: translateX(-100%);
    }
    60%,
    to {
      transform: translateX(360%);
    }
  }

  /* ── LA INTRO ───────────────────────────────────────────────────────────────
     `black` y no un token: el fondo del video es negro puro, y cualquier otro
     tono —`marca` incluido— dibujaría el borde del video en los márgenes del
     celular. Es el color del archivo, no uno de la paleta. */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: clip;
    background: black;
    transition: opacity 700ms var(--ease-out);
  }

  .intro[hidden] {
    display: none;
  }

  .intro-saliendo {
    opacity: 0;
    pointer-events: none;
  }

  /* CUBRE LA PANTALLA SIN PERDER EL LOGO. `cover` puro llena cualquier
     pantalla, pero en un celular vertical deja ver sólo la cuarta parte central
     del cuadro y el logo final, que ocupa 420 de sus 1390 px, perdería las
     orejas. Así que el video cubre (el `max`) hasta el punto en que la franja
     visible baja de 450 px del original (el `min`): en escritorio llena todo;
     en vertical llena el ancho con el logo entero y deja negro arriba y abajo,
     que se funde con el negro del propio video. 1390/720 y 1390/450 son esas
     dos proporciones.

     Centrado con `translate` y no con `place-items`: un video más ancho que la
     pantalla estira su pista de grid y queda pegado a la izquierda. */
  .intro-video {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: min(max(100vw, 100svh * 1390 / 720), 100vw * 1390 / 450);
    max-width: none;
    height: auto;
    aspect-ratio: 1280 / 664;
  }

  /* LA ENTRADA: el sello arriba y una sola acción, grande. Fondo negro opaco
     para tapar el primer fotograma del video, que ya está cargado detrás. */
  .intro-entrada {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 7svh, 4.5rem);
    padding: 1.5rem;
    background: black;
    transition: opacity 600ms var(--ease-out), visibility 600ms;
  }

  .sello-intro img {
    width: clamp(6rem, 22vw, 9rem);
    height: auto;
  }

  .intro-entrar {
    min-height: 64px;
    min-width: min(18rem, 100%);
    padding: 1.25rem 3.5rem;
    border: 1px solid var(--color-superficie);
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    font-weight: 600;
    letter-spacing: 0.4em;
    /* El tracking también se pinta tras la última letra: sin compensarlo, la
       palabra queda corrida a la izquierda dentro del botón. */
    text-indent: 0.4em;
    text-transform: uppercase;
    color: var(--color-superficie);
    transition: background-color 250ms var(--ease-out), color 250ms var(--ease-out);
  }

  .intro-entrar:hover,
  .intro-entrar:focus-visible {
    background: var(--color-superficie);
    color: black;
  }

  .intro-reproduciendo .intro-entrada {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Los dos controles en las esquinas inferiores, lejos del logo: sonido a la
     izquierda y salida a la derecha, donde el pulgar los encuentra. Sólo
     existen mientras corre el video; en la entrada, la única acción es entrar. */
  .intro-boton {
    position: absolute;
    visibility: hidden;
    opacity: 0;
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    min-height: 44px;
    padding-inline: 1.25rem;
    border: 1px solid color-mix(in oklab, var(--color-superficie) 35%, transparent);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-superficie) 78%, transparent);
    transition:
      opacity 400ms 300ms,
      visibility 0s 300ms,
      color 200ms,
      border-color 200ms;
  }

  .intro-reproduciendo .intro-boton {
    visibility: visible;
    opacity: 1;
  }

  .intro-sonido {
    left: max(1.25rem, env(safe-area-inset-left));
  }

  .intro-saltar {
    right: max(1.25rem, env(safe-area-inset-right));
  }

  .intro-boton:hover,
  .intro-boton:focus-visible {
    border-color: var(--color-superficie);
    color: var(--color-superficie);
  }

  /* Mientras corre el video la puerta está oculta —fuera del orden de
     tabulación y del lector de pantalla— y con TODAS sus animaciones en pausa,
     retardos incluidos: un retardo en pausa no corre, así que al retirar la
     clase la coreografía de entrada arranca desde su primer fotograma. */
  .intro-activa .puerta {
    visibility: hidden;
  }

  .intro-activa .puerta,
  .intro-activa .puerta::before,
  .intro-activa .puerta *,
  .intro-activa .puerta *::before,
  .intro-activa .puerta *::after {
    animation-play-state: paused !important;
  }

  /* ── EL MARCO Y SUS CUATRO CRUCES ───────────────────────────────────────── */

  .marco {
    position: absolute;
    top: 50%;
    left: 50%;
    /* Crece con el reloj dentro: a 34rem las cruces caían sobre las cifras. */
    width: min(86vw, 68rem);
    height: min(74svh, 40rem);
    z-index: 1;
    color: color-mix(in oklab, var(--color-superficie) 42%, transparent);
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .marca-registro {
    position: absolute;
    width: 3.5rem;
    height: 3.5rem;
    color: currentColor;
  }

  /* Las esquinas se trazan primero. `scale` nace desde el vértice que les
     corresponde para que parezca que el marco se calibra, no que aparece una
     caja decorativa. */
  .esquina {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    opacity: 0;
    animation: trazar-esquina 520ms var(--ease-out) var(--retardo) both;
  }

  .esquina-noroeste {
    top: 0;
    left: 0;
    border-top: 1px solid currentColor;
    border-left: 1px solid currentColor;
    transform-origin: top left;
  }

  .esquina-noreste {
    top: 0;
    right: 0;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform-origin: top right;
  }

  .esquina-suroeste {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid currentColor;
    border-left: 1px solid currentColor;
    transform-origin: bottom left;
  }

  .esquina-sureste {
    right: 0;
    bottom: 0;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform-origin: bottom right;
  }

  @keyframes trazar-esquina {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 0.8;
      transform: scale(1);
    }
  }

  .cruz {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 1.125rem;
    height: 1.125rem;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.65);
    animation: registrar-cruz 420ms var(--ease-out) calc(var(--retardo) + 320ms) both;
  }

  .cruz::before,
  .cruz::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .cruz::before {
    width: 100%;
    height: 1px;
  }

  .cruz::after {
    width: 1px;
    height: 100%;
  }

  @keyframes registrar-cruz {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.65);
    }
    to {
      opacity: 1;
