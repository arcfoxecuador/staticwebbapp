---
/* LA PUERTA DE LANZAMIENTO conserva la composición cerrada de la campaña: una
   sola acción, una sola lectura y el campo azul→morado de la diagramación. El
   cliente decidió no mostrar todavía el vehículo; la intriga queda en el reloj,
   las marcas de registro y el rastro digital, sin identificadores de producto. */

import Teaser from '../layouts/Teaser.astro';
import ProtocoloComando from '../components/ui/ProtocoloComando.astro';
import Marca from '../components/ui/Marca.astro';
import CuentaAtras from '../components/ui/CuentaAtras.astro';
import { LANZAMIENTO } from '../lib/site';
import { grafo, organizacion, pagina, sitioWeb } from '../lib/schema';

interface Props {
  modoFormulario?: 'integrado' | 'flotante';
  pathPagina?: string;
}

const { modoFormulario = 'flotante', pathPagina = LANZAMIENTO.path } = Astro.props;

const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({
    path: pathPagina,
    titulo: LANZAMIENTO.titulo,
    descripcion: LANZAMIENTO.bajada,
  }),
);

/* Las líneas son una decisión de composición, no tres copias del titular.
   Partir la única cadena conserva `site.ts` como fuente cuando cambie el copy. */
const palabras = LANZAMIENTO.titular.split(' ');
const lineasTitular = [
  palabras.slice(0, 3).join(' '),
  palabras.slice(3, 7).join(' '),
  palabras.slice(7).join(' '),
];

---

<Teaser
  titulo={LANZAMIENTO.titulo}
  descripcion={LANZAMIENTO.bajada}
  path={pathPagina}
  {schema}
>
  <section
    data-slot="puerta-lanzamiento"
    class="puerta campo-oscuro relative isolate flex min-h-svh items-center justify-center overflow-clip bg-marca px-5 py-10 text-white"
  >
    {/* LAS CUATRO MARCAS recuperan el sistema completo de la diapositiva 10:
        cruz central, esquinas incompletas y rastro digital. No son estrellas ni
        partículas; cada grupo marca una coordenada del encuadre. */}
    <div class="marco" aria-hidden="true">
      <span class="marca-registro marca-noroeste" style="--retardo:900ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
      <span class="marca-registro marca-noreste" style="--retardo:1080ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
      <span class="marca-registro marca-suroeste" style="--retardo:1260ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
      <span class="marca-registro marca-sureste" style="--retardo:1440ms">
        <span class="esquina esquina-noroeste"></span>
        <span class="esquina esquina-noreste"></span>
        <span class="esquina esquina-suroeste"></span>
        <span class="esquina esquina-sureste"></span>
        <span class="cruz"></span>
        <span class="rastro-registro"></span>
      </span>
    </div>

    <div class="contenido-puerta relative z-10 flex w-full flex-col items-center text-center">
      <div class="entra">
        <Marca
          tono="blanco"
          soloSello
          enlace={!LANZAMIENTO.soloLanzamiento}
          class="sello-puerta"
        />
      </div>

      <p class="ceja-puerta entra entra-2">{LANZAMIENTO.ceja}</p>

      {/* El aria-label conserva la frase continua; los tres spans sólo fijan el
          corte editorial que pide la maqueta. */}
      <h1
        class="titulo-puerta entra-titular-hero"
        aria-label={LANZAMIENTO.titular}
      >
        {
          lineasTitular.map((linea) => (
            <span aria-hidden="true">{linea}</span>
          ))
        }
      </h1>

      {/* EL RELOJ. Mismo componente y mismo instante que el teaser: quien llega
          por followdafox y luego por el enlace de campaña tiene que ver la misma
          cifra. Centrado, que es la única diferencia de maqueta entre los dos. */}
      <CuentaAtras
        class="cuenta-puerta entra entra-3"
        alineacion="centro"
        destinoISO={LANZAMIENTO.destinoISO}
        fechaVisible={LANZAMIENTO.fechaVisible}
        llegada={LANZAMIENTO.llegada}
        unidades={LANZAMIENTO.unidades}
      />

      <div class="entra entra-4">
        <ProtocoloComando rotulo={LANZAMIENTO.cta} modo={modoFormulario} />
      </div>
    </div>
  </section>
</Teaser>

<style is:global>
  .puerta {
    min-height: 100svh;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 18px,
        color-mix(in oklab, var(--color-campana-fria) 9%, transparent) 18px 19px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0 89px,
        color-mix(in oklab, var(--color-campana-calida) 13%, transparent) 89px 90px
      ),
      radial-gradient(
        ellipse 64% 105% at 8% 52%,
        color-mix(in oklab, var(--color-campana-fria) 82%, var(--color-marca)) 0%,
        color-mix(in oklab, var(--color-campana-fria) 38%, var(--color-marca)) 38%,
        transparent 74%
      ),
      linear-gradient(
        112deg,
        color-mix(in oklab, var(--color-campana-fria) 54%, var(--color-marca)) 0%,
        color-mix(in oklab, var(--color-campana-fria) 18%, var(--color-marca)) 43%,
        color-mix(in oklab, var(--color-campana-calida) 72%, var(--color-marca)) 78%,
        color-mix(in oklab, var(--color-campana-calida) 46%, var(--color-marca)) 100%
      );
  }

  /* ── EL MARCO Y SUS CUATRO CRUCES ───────────────────────────────────────── */

  .marco {
    position: absolute;
    top: 50%;
    left: 50%;
    /* Crece con el reloj dentro: a 34rem las cruces caían sobre las cifras. */
    width: min(86vw, 68rem);
    height: min(74svh, 40rem);
    z-index: 1;
    color: color-mix(in oklab, var(--color-superficie) 42%, transparent);
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .marca-registro {
    position: absolute;
    width: 3.5rem;
    height: 3.5rem;
    color: currentColor;
  }

  /* Las esquinas se trazan primero. `scale` nace desde el vértice que les
     corresponde para que parezca que el marco se calibra, no que aparece una
     caja decorativa. */
  .esquina {
    position: absolute;
    width: 0.7rem;
    height: 0.7rem;
    opacity: 0;
    animation: trazar-esquina 520ms var(--ease-out) var(--retardo) both;
  }

  .esquina-noroeste {
    top: 0;
    left: 0;
    border-top: 1px solid currentColor;
    border-left: 1px solid currentColor;
    transform-origin: top left;
  }

  .esquina-noreste {
    top: 0;
    right: 0;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform-origin: top right;
  }

  .esquina-suroeste {
    bottom: 0;
    left: 0;
    border-bottom: 1px solid currentColor;
    border-left: 1px solid currentColor;
    transform-origin: bottom left;
  }

  .esquina-sureste {
    right: 0;
    bottom: 0;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform-origin: bottom right;
  }

  @keyframes trazar-esquina {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
    to {
      opacity: 0.8;
      transform: scale(1);
    }
  }

  .cruz {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 1.125rem;
    height: 1.125rem;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.65);
    animation: registrar-cruz 420ms var(--ease-out) calc(var(--retardo) + 320ms) both;
  }

  .cruz::before,
  .cruz::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .cruz::before {
    width: 100%;
    height: 1px;
  }

  .cruz::after {
    width: 1px;
    height: 100%;
  }

  @keyframes registrar-cruz {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.65);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* Tres columnas discontinuas bastan para citar el rastro digital de la
     referencia. Son parte de la marca y se quedan quietas al terminar; no hay
     lluvia ni partículas en movimiento continuo. */
  .rastro-registro {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 4.5rem;
    color: currentColor;
    background: repeating-linear-gradient(to bottom, currentColor 0 2px, transparent 2px 6px);
    box-shadow: -0.75rem 0.5rem 0 currentColor, 0.85rem -0.35rem 0 currentColor;
    opacity: 0;
    transform: translate(-50%, -50%) scaleY(0.45);
    animation: revelar-rastro 620ms var(--ease-out) calc(var(--retardo) + 470ms) both;
  }

  @keyframes revelar-rastro {
    to {
      opacity: 0.1;
      transform: translate(-50%, -50%) scaleY(1);
    }
  }

  .marca-noroeste {
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }

  .marca-noreste {
    top: 0;
    right: 0;
    transform: translate(50%, -50%);
  }

  .marca-suroeste {
    bottom: 0;
    left: 0;
    transform: translate(-50%, 50%);
  }

  .marca-sureste {
    right: 0;
    bottom: 0;
    transform: translate(50%, 50%);
  }

  /* ── EL CONTENIDO ───────────────────────────────────────────────────────── */

  .contenido-puerta {
    max-width: 68rem;
  }

  .sello-puerta img {
    width: 3.5rem;
    height: 3.5rem;
  }

  .ceja-puerta {
    max-width: 62rem;
    margin-block-start: clamp(1.5rem, 4svh, 2.75rem);
    font-family: var(--font-sans);
    font-size: clamp(0.625rem, 0.55rem + 0.25vw, 0.75rem);
    font-weight: 300;
    line-height: 1.65;
    letter-spacing: 0.27em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-superficie) 78%, transparent);
  }

  .titulo-puerta {
    margin-block: clamp(1.25rem, 3.5svh, 2.5rem) clamp(1.5rem, 4svh, 2.5rem);
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.72rem + 1.1vw, 1.85rem);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: clamp(0.12em, 0.42vw, 0.3em);
    text-transform: uppercase;
    color: var(--color-superficie);
  }

  .titulo-puerta span {
    display: block;
    white-space: nowrap;
  }

  /* El reloj respira menos que en el teaser: allí cierra la página, aquí es el
     paso entre el titular y la única acción, y separarlo más rompe la lectura
     en dos mitades. */
  .cuenta-puerta {
    margin-block-end: clamp(1.5rem, 4svh, 2.75rem);
  }

  [data-slot='boton'].puerta-cta {
    min-height: 44px;
    border-radius: 0;
    padding-inline: 1.75rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  /* El salto empieza donde la línea más larga conserva su corte editorial:
     antes de 64rem, agrandar el tracking rompería el `nowrap` central. */
  @media (width >= 64rem) {
    .sello-puerta img {
      width: 6.25rem;
      height: 6.25rem;
    }

    .ceja-puerta {
      margin-block-start: clamp(2rem, 4svh, 3.25rem);
      font-size: 0.875rem;
      letter-spacing: 0.3em;
    }

    .titulo-puerta {
      margin-block: clamp(1.75rem, 3.5svh, 3rem) clamp(1.75rem, 4svh, 3rem);
      font-size: clamp(2.4rem, 1.4rem + 1.7vw, 3.05rem);
      line-height: 1.35;
      letter-spacing: clamp(0.16em, 0.35vw, 0.22em);
    }

    [data-slot='boton'].puerta-cta {
      min-height: 48px;
      padding-inline: 2.25rem;
      font-size: 0.8125rem;
      letter-spacing: 0.31em;
    }
  }

  @media (width < 30rem) {
    .puerta {
      padding-inline: 1rem;
    }

    .marco {
      width: calc(100vw - 2rem);
      height: min(80svh, 40rem);
    }

    .ceja-puerta {
      max-width: 34ch;
      letter-spacing: 0.16em;
    }

    .titulo-puerta {
      font-size: 0.925rem;
      letter-spacing: 0.1em;
    }

  }

  @media (height < 38rem) {
    .sello-puerta img {
      width: 2.75rem;
      height: 2.75rem;
    }

    .ceja-puerta {
      margin-block-start: 1rem;
    }

    .titulo-puerta {
      margin-block: 0.9rem 1rem;
      line-height: 1.3;
    }

    .cuenta-puerta {
      margin-block-end: 1rem;
    }
  }

  /* REDUCED MOTION: se conserva lo que informa y se quita lo que se mueve. El
     reloj sigue contando: unas cifras que cambian son información, no motion. */
  @media (prefers-reduced-motion: reduce) {
    .puerta .entra,
    .puerta .entra-titular-hero {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      clip-path: none !important;
    }

    .puerta .esquina {
      animation: none !important;
      opacity: 0.8 !important;
      transform: scale(1) !important;
    }

    .puerta .cruz {
      animation: none !important;
      opacity: 1 !important;
      transform: translate(-50%, -50%) scale(1) !important;
    }

    .puerta .rastro-registro {
      animation: none !important;
      opacity: 0.1 !important;
      transform: translate(-50%, -50%) scaleY(1) !important;
    }
  }
</style>
