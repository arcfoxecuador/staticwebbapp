---
/* Ficha de modelo: ocho escenas. Los datos salen del markdown; las fotos, de
   `imagenPorArchivo`. Si falta una, esa escena no se pinta — no hay placeholder. */
import Base from '../../layouts/Base.astro';
import Hero from '../../components/bloques/Hero.astro';
import Escena from '../../components/bloques/Escena.astro';
import Seccion from '../../components/bloques/Seccion.astro';
import Encabezado from '../../components/bloques/Encabezado.astro';
import Conmutador from '../../components/bloques/Conmutador.astro';
import Metricas from '../../components/bloques/Metricas.astro';
import Mosaico from '../../components/bloques/Mosaico.astro';
import Destacados from '../../components/bloques/Destacados.astro';
import Cierre from '../../components/bloques/Cierre.astro';
import Formulario from '../../components/bloques/Formulario.astro';

import { coleccion, renderizar } from '../../lib/contenido';
import { imagenDeEntrada, imagenPorArchivo } from '../../lib/imagenes';
import { AVISO_CIFRAS } from '../../lib/site';
import { grafo, migas, organizacion, pagina, servicio, sitioWeb } from '../../lib/schema';

import cotizar from '../../assets/cotizar.webp';

export async function getStaticPaths() {
  const modelos = await coleccion('modelos');
  return modelos.map((entrada) => ({ params: { slug: entrada.id }, props: { entrada } }));
}

const { entrada } = Astro.props;
const { data } = entrada;
const { Content } = await renderizar(entrada);

/* La foto es de ESTE slug. Un fallback a otro modelo enseñaría el auto
   equivocado si este no tiene archivo local. */
const archivoHero = data.angulos[0]?.archivo ?? data.variantes[0]?.archivo;
const heroLocal = archivoHero
  ? imagenPorArchivo(archivoHero, data.alt ?? data.nombre)
  : undefined;
const heroCms = heroLocal
  ? undefined
  : imagenDeEntrada('modelos', entrada.id, { asset: data.imagen, alt: data.alt, generada: data.portadaGenerada });
const heroSrc =
  heroLocal ??
  (heroCms && typeof heroCms.fuente.src !== 'string' ? heroCms.fuente.src : undefined);

const variantes = data.variantes
  .map((v) => {
    const imagen = imagenPorArchivo(v.archivo, v.alt);
    return imagen ? { etiqueta: v.etiqueta, imagen, alt: v.alt, muestra: v.muestra } : null;
  })
  .filter((v) => v !== null);

/* El texto aprobado da sección «Colores» a los tres modelos. Mientras no lleguen
   las fotos por color de la versión local, la sección enseña la primera vista
   del modelo sola: el Conmutador no dibuja selector con un único ítem. */
const colores =
  variantes.length > 0
    ? variantes
    : data.angulos
        .map((a) => {
          const imagen = imagenPorArchivo(a.archivo, a.alt);
          return imagen ? { etiqueta: data.nombre, imagen, alt: a.alt } : null;
        })
        .filter((v) => v !== null)
        .slice(0, 1);

const interiores = data.interior
  .map((v) => {
    const imagen = imagenPorArchivo(v.archivo, v.alt);
    return imagen ? { etiqueta: v.etiqueta, imagen, alt: v.alt } : null;
  })
  .filter((v) => v !== null);

/* Un interior solo se pinta como escena; dos o más, como conmutador.
   Pintar los dos enseña la primera foto dos veces — Conductor, otra vez. */
const escenaInterior = interiores.length === 1 ? interiores[0] : undefined;
const conmutadorInterior = interiores.length >= 2 ? interiores : [];
const llenoInterior = data.interior.some((v) =>
  /habitaculo|tablero|cabina|traseras|techo|estudio/.test(v.archivo),
);

const mosaico = data.galeria
  .map((g) => {
    const imagen = imagenPorArchivo(g.archivo, g.alt);
    return imagen ? { imagen, alt: g.alt } : null;
  })
  .filter((g) => g !== null);

const destacados = data.destacados
  .map((d) => {
    const imagen = d.archivo && d.alt ? imagenPorArchivo(d.archivo, d.alt) : undefined;
    return { titulo: d.titulo, puntos: d.puntos, imagen, alt: d.alt };
  });

const cotas = data.cotas.map((c) => ({ valor: c.valor, unidad: c.unidad, etiqueta: c.etiqueta }));

/* La ficha técnica pinta SIEMPRE sus cuatro grupos, aunque alguno esté vacío:
   el cliente pidió conservar el espacio hasta cargar la ficha validada para
   Ecuador. Un grupo vacío lo dice en vez de desaparecer. */
const textos = data.textos;
const corto = data.nombre.replace(/^ARCFOX\s+/, '');

const path = `/modelos/${entrada.id}`;

const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({ path, titulo: data.nombre, descripcion: data.seoDescripcion }),
  migas([
    { nombre: 'Modelos', path: '/modelos' },
    { nombre: data.nombre, path },
  ]),
  servicio({
    slug: entrada.id,
    nombre: data.nombre,
    descripcion: data.seoDescripcion,
    categoria: data.categoria,
  }),
);
---

<Base
  titulo={data.nombre}
  descripcion={data.seoDescripcion}
  {path}
  {schema}
  noindex={!data.publico}
  cabeceraFlotante={Boolean(heroSrc)}
>
  {
    heroSrc ? (
      <Escena
        imagen={heroSrc}
        alt={data.alt ?? data.nombre}
        rotulo={data.rotuloFicha ?? (data.rotulo ? `${data.rotulo} 100% eléctrico` : data.categoria)}
        titulo={data.nombre}
        bajada={data.descripcion ?? data.bajada}
        transicion={`modelo-${entrada.id}`}
        primera
        altura="completa"
      />
    ) : (
      <Hero
        rotulo={data.rotuloFicha ?? data.rotulo ?? data.categoria}
        titulo={data.nombre}
        bajada={data.bajada}
      />
    )
  }

  {
    colores.length > 0 && (
      <Seccion campo="tinte">
        <Conmutador
          rotulo="Colores"
          titulo={textos.colores ?? 'Elige el que te representa'}
          marca={entrada.id.toUpperCase()}
          items={colores}
          forma="circulo"
          nombre={`color-${entrada.id}`}
        />
      </Seccion>
    )
  }

  {
    cotas.length > 0 && (
      <Seccion campo="superficie" aire="apretado">
        <Metricas items={cotas} forma="tira" nota={AVISO_CIFRAS} />
      </Seccion>
    )
  }

  {
    escenaInterior && (
      <Escena
        imagen={escenaInterior.imagen}
        alt={escenaInterior.alt}
        titulo={textos.interior ?? 'Dentro'}
        bajada={textos.interiorTexto}
        altura="completa"
        anclaje="pie"
      />
    )
  }

  {
    conmutadorInterior.length > 0 && (
      <Seccion campo="tinte" aire="apretado" contenido={false}>
        <Conmutador
          titulo={textos.interior ?? 'Míralo desde dentro'}
          items={conmutadorInterior}
          forma="texto"
          nombre={`interior-${entrada.id}`}
          lleno={llenoInterior}
        />
      </Seccion>
    )
  }

  {
    mosaico.length > 0 && (
      <Seccion aire="apretado" contenido={false}>
        <Mosaico items={mosaico} patron="destacado" />
      </Seccion>
    )
  }

  {
    destacados.length > 0 && (
      <Seccion>
        <Encabezado
          rotulo="Diseño y tecnología"
          titulo={textos.tecnologia ?? 'Lo que hace distinto a este modelo'}
          bajada={textos.tecnologiaIntro}
        />
        <Destacados items={destacados} etiqueta={`Tecnología del ${data.nombre}`} class="mt-10" />
        <div class="prosa mt-16">
          <Content />
        </div>
      </Seccion>
    )
  }

  {
    destacados.length === 0 && (
      <Seccion>
        <div class="prosa">
          <Content />
        </div>
      </Seccion>
    )
  }

  {
    data.especificaciones.length > 0 && (
      <Seccion campo="tinte">
        <Encabezado rotulo="Especificaciones" titulo={`Conoce el ${corto} en detalle`} />
        <div class="mt-12 grid gap-10 md:grid-cols-2 lg:gap-14">
          {data.especificaciones.map((grupo) => (
            <section class="revela">
              <h3 class="border-b border-linea pb-3 text-h3 font-bold text-marca">{grupo.grupo}</h3>
              {grupo.items.length > 0 ? (
                <dl class="mt-2">
                  {grupo.items.map((item) => (
                    <div class="flex items-baseline justify-between gap-6 border-b border-linea/60 py-3 text-small">
                      <dt class="text-tinta/65">{item.clave}</dt>
                      <dd class="text-right font-medium text-marca">{item.valor}</dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <p class="mt-4 text-small text-tinta/55">[pendiente]</p>
              )}
            </section>
          ))}
        </div>
        <p class="mt-10 max-w-[68ch] text-small text-tinta/50">{AVISO_CIFRAS}</p>
      </Seccion>
    )
  }

  <Cierre
    id="cotizalo"
    imagen={cotizar}
    alt="ARCFOX, fondo de la ficha de cotización."
  >
    <Formulario
      titulo={textos.cotizacion ?? `Cotiza tu ${data.nombre}`}
      bajada={textos.cotizacionTexto}
      origen={path}
      cotizacion
      boton={`Cotizar ${corto}`}
      compacto
    />
  </Cierre>
</Base>
