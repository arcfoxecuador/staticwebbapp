---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/bloques/Hero.astro';
import Seccion from '../../components/bloques/Seccion.astro';
import Encabezado from '../../components/bloques/Encabezado.astro';
import GamaModelos from '../../components/bloques/GamaModelos.astro';
import Cierre from '../../components/bloques/Cierre.astro';

import { coleccion } from '../../lib/contenido';
import { CTA } from '../../lib/site';
import { grafo, listaDeServicios, migas, organizacion, pagina, sitioWeb } from '../../lib/schema';

const modelos = (await coleccion('modelos', ({ data }) => data.publico)).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const titulo = 'Modelos';
const descripcion =
  'Descubre el T1, T5 y S5. Tres propuestas 100% eléctricas para encontrar el ARCFOX que va contigo.';

const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({ path: '/modelos', titulo, descripcion, tipo: 'CollectionPage' }),
  migas([{ nombre: titulo, path: '/modelos' }]),
  listaDeServicios(modelos.map((s) => ({ slug: s.id, nombre: s.data.nombre }))),
);
---

<Base {titulo} {descripcion} path="/modelos" {schema}>
  <Hero rotulo="Nuestros modelos" titulo="Tres formas de moverte. Una nueva energía." bajada={descripcion} />

  <Seccion>
    <Encabezado titulo="Encuentra tu ARCFOX" />
    <GamaModelos class="mt-14" />
  </Seccion>

  <Cierre
    titulo="¿Cuál va contigo?"
    bajada="Cuéntanos qué buscas en tu próximo vehículo. Te ayudamos a conocer la gama y elegir tu ARCFOX."
    accion={{ texto: 'Solicitar asesoría', href: CTA.href }}
  />
</Base>
