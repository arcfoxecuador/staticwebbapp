---
/* La portada es un recorrido de producto, no un índice de marca: un auto abre,
   el escenario permite explorarlo y el resto del scroll demuestra la experiencia. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import HeroImagen from '../components/bloques/HeroImagen.astro';
import EscenarioModelo from '../components/bloques/EscenarioModelo.astro';
import Mosaico from '../components/bloques/Mosaico.astro';
import Cierre from '../components/bloques/Cierre.astro';
import Formulario from '../components/bloques/Formulario.astro';

import hero from '../assets/hero.webp';
import t5Habitaculo from '../assets/t5-habitaculo.webp';
import t5Rueda from '../assets/t5-rueda.webp';
import t5Cabina from '../assets/t5-cabina.webp';
import sobre from '../assets/sobre.webp';
import cotizar from '../assets/cotizar.webp';

import { coleccion } from '../lib/contenido';
import { imagenPorArchivo } from '../lib/imagenes';
import { ORG, PILARES, PORTADA } from '../lib/site';
import { grafo, listaDeServicios, organizacion, pagina, sitioWeb } from '../lib/schema';

const entradas = (await coleccion('modelos', ({ data }) => data.publico)).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const resolverFotogramas = (items: { archivo: string; alt: string }[]) =>
  items
    .map((item) => {
      const imagen = imagenPorArchivo(item.archivo, item.alt);
      return imagen ? { imagen, alt: item.alt } : undefined;
    })
    .filter((item): item is { imagen: ImageMetadata; alt: string } => Boolean(item));

const modelos = entradas.map((entrada) => {
  const angulos = resolverFotogramas(entrada.data.angulos);
  const variantes = entrada.data.variantes
    .map((variante, indice) => {
      const propia = resolverFotogramas([{ archivo: variante.archivo, alt: variante.alt }]);
      return {
        etiqueta: variante.etiqueta,
        muestra: variante.muestra,
        /* Sólo el primer color comparte la secuencia: mezclar ángulos grises
           con una carrocería blanca fingiría que ese color fue fotografiado. */
        fotogramas: indice === 0 && angulos.length ? angulos : propia,
      };
    })
    .filter((color) => color.fotogramas.length > 0);
  const colores = variantes.length
    ? variantes
    : [{ etiqueta: 'Disponible', fotogramas: angulos }];
  const datos = [
    ...entrada.data.datos,
    ...entrada.data.cotas.map((cota) => ({
      clave: cota.etiqueta,
      valor: `${cota.valor}${cota.unidad ? ` ${cota.unidad}` : ''}`,
    })),
  ];
  return {
    id: entrada.id,
    nombre: entrada.data.nombre,
    colores,
    datos,
  };
}).filter((modelo) => modelo.colores.some((color) => color.fotogramas.length > 0));

const descripcion = ORG.descripcion;
const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({ path: '/', titulo: `${ORG.nombreCorto} · ${ORG.tagline}`, descripcion }),
  ...(entradas.length ? [listaDeServicios(entradas.map((s) => ({ slug: s.id, nombre: s.data.nombre })))] : []),
);
---

<Base titulo={`${ORG.nombreCorto} · ${ORG.tagline}`} {descripcion} path="/" {schema} cabeceraFlotante>
  <HeroImagen
    titulo={PORTADA.titular}
    insignia="100% eléctrico"
    imagen={hero}
    alt="SUV ARCFOX eléctrico en carretera al anochecer."
    generada={false}
  />

  <EscenarioModelo {modelos} />

  <section class="campo-oscuro overflow-clip bg-marca" aria-label="Rasgos ARCFOX">
    <Mosaico
      items={[
        { titulo: PILARES[0]?.titulo, bajada: PILARES[0]?.texto },
        { imagen: t5Habitaculo, alt: 'Puesto de conducción y pantallas del ARCFOX T5.' },
        { imagen: t5Rueda, alt: 'Llanta y sistema de frenado del ARCFOX T5.' },
        { imagen: t5Cabina, alt: 'Plazas traseras y techo panorámico del ARCFOX T5.' },
        { titulo: PILARES[1]?.titulo, bajada: PILARES[1]?.texto },
        { titulo: PILARES[2]?.titulo, bajada: PILARES[2]?.texto },
      ]}
    />
  </section>

  <section class="sobre-portada campo-oscuro relative isolate overflow-clip bg-marca">
    <Image
      src={sobre}
      alt="ARCFOX en un paisaje nocturno junto al zorro, emblema de la marca."
      widths={[800, 1440, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-marca/35" aria-hidden="true"></div>
    <a href="/nosotros" class="medida flex min-h-[72svh] flex-col items-center justify-center py-20 text-center text-white">
      <span class="revela text-eyebrow uppercase tracking-[0.18em]">Sobre ARCFOX</span>
      <img
        src="/marca/sello-blanco.png"
        alt="Sello ARCFOX"
        width="120"
        height="120"
        class="revela mt-8 h-24 w-24 object-contain md:h-30 md:w-30"
      />
      <span class="revela mt-8 enlace-subrayado text-small uppercase tracking-[0.16em]">Conoce la marca</span>
    </a>
  </section>

  <Cierre id="cotizalo" imagen={cotizar} alt="ARCFOX T5 en el escenario oscuro de cotización.">
    <Formulario titulo="Cotízalo" bajada="Elige tu ARCFOX. Te contactamos desde Quito." origen="/" compacto />
  </Cierre>
</Base>

<style>
  .sobre-portada a {
    text-decoration: none;
  }
</style>
