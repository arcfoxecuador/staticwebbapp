---
/* La portada es un recorrido de producto, no un índice de marca: un auto abre,
   el escenario permite explorarlo y el resto del scroll demuestra la experiencia.
   Cambiar de modelo pinta hero, plato, mosaico, cierre y cabecera a la vez. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroImagen from '../components/bloques/HeroImagen.astro';
import EscenarioModelo from '../components/bloques/EscenarioModelo.astro';
import Mosaico, { type ColumnaExtra } from '../components/bloques/Mosaico.astro';
import Cierre from '../components/bloques/Cierre.astro';
import Boton from '../components/ui/Boton.astro';
import Zorro from '../components/ui/Zorro.astro';

import hero from '../assets/hero.webp';
import t5Cuarto from '../assets/t5-45-gris.webp';
import t1Kv2 from '../assets/t1-kv2.webp';
import s5Cuarto from '../assets/s5-45.webp';
import s5Bajo from '../assets/s5-bajo.webp';
import cotizar from '../assets/t5-340.webp';

import { coleccion } from '../lib/contenido';
import { imagenPorArchivo } from '../lib/imagenes';
import { resolverOrbita } from '../lib/orbitas';
import { CTA, ORG, PILARES, PORTADA } from '../lib/site';
import { grafo, listaDeServicios, organizacion, pagina, sitioWeb } from '../lib/schema';

const entradas = (await coleccion('modelos', ({ data }) => data.publico)).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const resolverFotogramas = (items: { archivo: string; alt: string }[]) =>
  items
    .map((item) => {
      const imagen = imagenPorArchivo(item.archivo, item.alt);
      return imagen ? { imagen, alt: item.alt, archivo: item.archivo } : undefined;
    })
    .filter((item): item is { imagen: ImageMetadata; alt: string; archivo: string } => Boolean(item));

const heroPorId: Record<string, { imagen: ImageMetadata; alt: string }> = {
  /* hero.webp es el T1 en el pabellón: en 390 el auto queda en un rincón
     y el morro se pierde. El tres cuartos del T5 pone la trompa en el
     encuadre. */
  t5: { imagen: t5Cuarto, alt: 'ARCFOX T5 gris, vista de tres cuartos delanteros.' },
  /* t1-kv es la misma escena de pabellón que hero.webp: a sangre se leen
     como el mismo auto. kv2 es la toma de dos T1 frente a la ciudad. */
  t1: { imagen: t1Kv2, alt: 'Dos ARCFOX T1 en el escenario de marca junto al agua.' },
  s5: { imagen: s5Cuarto, alt: 'ARCFOX S5, SUV fastback 100% eléctrico.' },
};

const cierrePorId: Record<string, { imagen: ImageMetadata; alt: string }> = {
  t5: { imagen: cotizar, alt: 'ARCFOX T5, vista de tres cuartos para cotizar.' },
  t1: { imagen: t1Kv2, alt: 'ARCFOX T1, toma de marca para cotizar.' },
  s5: { imagen: s5Bajo, alt: 'ARCFOX S5, vista baja para cotizar.' },
};

/* El zorro es el emblema y no cambia. El auto de esta losa SÍ: si se
   quedara el T5 al elegir T1, la isla mentiría. Toma frontal o tres
   cuartos para que la placa se lea junto al animal. */
const sobrePorId: Record<string, { imagen: ImageMetadata; alt: string }> = {
  t5: { imagen: t5Cuarto, alt: 'ARCFOX T5 gris, trompa junto al emblema de la marca.' },
  /* kv2 pone la placa del T1 a un tamaño de lectura; kv es el pabellón
     entero y en 390 el auto se perdía detrás del zorro. */
  t1: { imagen: t1Kv2, alt: 'ARCFOX T1 celeste, trompa junto al emblema de la marca.' },
  s5: { imagen: s5Cuarto, alt: 'ARCFOX S5, trompa junto al emblema de la marca.' },
};

/* LAS COLUMNAS DE LA DERECHA DEL TABLERO. Tres por modelo: la cuarta función
   con su foto y dos cifras de la ficha. Las fotos no repiten las tres primeras
   columnas. La cifra se busca por su nombre en datos, cotas o especificaciones:
   si cambia en la ficha, cambia aquí. Cada foto lleva reserva real: las
   generadas del T1 se usan cuando existen y, mientras no, sale la de reserva. */
type FotoTablero = { archivo: string; alt: string; generada?: boolean };
type ColumnaTablero = ({ destacado: number } | { dato: string }) & { fotos: FotoTablero[] };

const tableroExtraPorId: Record<string, ColumnaTablero[]> = {
  t5: [
    { destacado: 3, fotos: [{ archivo: 't5-llanta', alt: 'Llanta y pinza de freno del T5.' }] },
    { dato: 'Potencia', fotos: [{ archivo: 't5-faro', alt: 'Faro delantero del T5.' }] },
    { dato: 'Velocidad máx.', fotos: [{ archivo: 't5-material', alt: 'Habitáculo del T5 bajo el techo panorámico.' }] },
  ],
  t1: [
    { destacado: 3, fotos: [{ archivo: 't1-carretera', alt: 'T1 en marcha por una carretera junto al mar.' }] },
    {
      dato: 'Maletero',
      fotos: [
        { archivo: 't1-maletero-plegado', alt: 'Maletero del T1 con los asientos traseros abatidos.', generada: true },
        { archivo: 't1-kv2', alt: 'Dos ARCFOX T1 en el escenario de marca junto al agua.' },
      ],
    },
    {
      dato: 'Largo',
      fotos: [
        { archivo: 't1-perfil', alt: 'T1 de perfil en el pabellón de marca.', generada: true },
        { archivo: 't1-kv', alt: 'T1 celeste en el pabellón de marca.' },
      ],
    },
  ],
  s5: [
    { destacado: 3, fotos: [{ archivo: 's5-puerta', alt: 'Volante y tablero del S5 vistos desde la puerta sin marco.' }] },
    { dato: 'Autonomía WLTC', fotos: [{ archivo: 's5-aleta', alt: 'Aleta trasera y pilotos del S5.' }] },
    { dato: 'Carga rápida 30–80%', fotos: [{ archivo: 's5-llanta', alt: 'Llanta del S5 con la pinza de freno verde.' }] },
  ],
};

const colorDesdeFotos = (
  etiqueta: string,
  muestra: string | undefined,
  fotos: { imagen: ImageMetadata; alt: string }[],
) => {
  const primera = fotos[0];
  if (!primera) return undefined;
  return {
    etiqueta,
    muestra,
    imagen: primera.imagen,
    alt: primera.alt,
    urls: fotos.map((foto) => foto.imagen.src),
  };
};

const modelos = entradas.map((entrada) => {
  const angulos = resolverFotogramas(entrada.data.angulos);
  const variantes = entrada.data.variantes
    .map((variante, indice) => {
      if (variante.orbita && variante.fotogramas) {
        const orbita = resolverOrbita(variante.orbita, variante.fotogramas);
        if (orbita) {
          return {
            etiqueta: variante.etiqueta,
            muestra: variante.muestra,
            imagen: orbita.imagen,
            alt: variante.alt,
            urls: orbita.urls,
          };
        }
      }
      const propia = resolverFotogramas([{ archivo: variante.archivo, alt: variante.alt }]);
      return colorDesdeFotos(
        variante.etiqueta,
        variante.muestra,
        indice === 0 && angulos.length ? angulos : propia,
      );
    })
    .filter((color): color is NonNullable<typeof color> => Boolean(color));
  const sinVariante = colorDesdeFotos('Disponible', undefined, angulos);
  const colores = variantes.length ? variantes : sinVariante ? [sinVariante] : [];
  const datos = [
    ...entrada.data.datos,
    ...entrada.data.cotas.map((cota) => ({
      clave: cota.etiqueta,
      valor: `${cota.valor}${cota.unidad ? ` ${cota.unidad}` : ''}`,
    })),
  ];

  /* Habitáculo + un detalle de galería (rueda, faro) + otra toma de
     interior. Tres interiores seguidos leen como catálogo de asientos
     y no como el tablero de la maqueta. */
  const interiores = resolverFotogramas(
    entrada.data.interior.map((item) => ({ archivo: item.archivo, alt: item.alt })),
  );
  const usados = new Set(interiores.map((foto) => foto.archivo));
  const detalles = resolverFotogramas(entrada.data.galeria).filter((foto) => {
    if (usados.has(foto.archivo)) return false;
    usados.add(foto.archivo);
    return true;
  });
  const fotosMosaico = [
    interiores[0],
    detalles[0],
    interiores[2] ?? interiores[1] ?? detalles[1],
  ].filter((foto): foto is NonNullable<typeof foto> => Boolean(foto));

  const textos = (entrada.data.destacados.length ? entrada.data.destacados : PILARES)
    .slice(0, 3)
    .map((item, i) => ({
      titulo: 'titulo' in item ? item.titulo : PILARES[i]?.titulo,
      bajada: 'puntos' in item ? item.puntos[0] : PILARES[i]?.texto,
    }));

  return {
    id: entrada.id,
    nombre: entrada.data.nombre,
    rotulo: entrada.data.rotulo,
    colores,
    datos,
    mosaico: [
      textos[0],
      fotosMosaico[0] ? { imagen: fotosMosaico[0].imagen, alt: fotosMosaico[0].alt } : undefined,
      fotosMosaico[1] ? { imagen: fotosMosaico[1].imagen, alt: fotosMosaico[1].alt } : undefined,
      fotosMosaico[2] ? { imagen: fotosMosaico[2].imagen, alt: fotosMosaico[2].alt } : undefined,
      textos[1],
      textos[2],
    ].filter((item): item is NonNullable<typeof item> => Boolean(item)),
    tableroExtra: (() => {
      const cifras = new Map<string, string>([
        ...datos.map((dato) => [dato.clave, dato.valor] as const),
        ...(entrada.data.especificaciones ?? []).flatMap((grupo) =>
          grupo.items.map((item) => [item.clave, item.valor] as const),
        ),
      ]);
      return (tableroExtraPorId[entrada.id] ?? []).flatMap((columna): ColumnaExtra[] => {
        const foto = columna.fotos
          .map((f) => ({ ...f, imagen: imagenPorArchivo(f.archivo, f.alt) }))
          .find((f) => f.imagen);
        if (!foto?.imagen) return [];
        const base = { imagen: foto.imagen, alt: foto.alt, generada: foto.generada };
        if ('destacado' in columna) {
          const destacado = entrada.data.destacados[columna.destacado];
          return destacado ? [{ ...base, titulo: destacado.titulo }] : [];
        }
        const valor = cifras.get(columna.dato);
        return valor ? [{ ...base, cifra: valor, etiqueta: columna.dato }] : [];
      });
    })(),
  };
}).filter((modelo) => modelo.colores.length > 0);

const descripcion = ORG.descripcion;
const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({ path: '/', titulo: `${ORG.nombreCorto} · ${ORG.tagline}`, descripcion }),
  ...(entradas.length ? [listaDeServicios(entradas.map((s) => ({ slug: s.id, nombre: s.data.nombre })))] : []),
);
---

<Base titulo={`${ORG.nombreCorto} · ${ORG.tagline}`} {descripcion} path="/" {schema} cabeceraFlotante>
  <HeroImagen
    titulo={PORTADA.titular}
    insignia="100% eléctrico"
    imagen={t5Cuarto}
    alt="ARCFOX T5 gris, vista de tres cuartos delanteros."
    fondos={modelos.map((modelo) => ({
      id: modelo.id,
      imagen: heroPorId[modelo.id]?.imagen ?? hero,
      alt: heroPorId[modelo.id]?.alt ?? modelo.nombre,
    }))}
    generada={false}
    siguiente={{ href: '#escenario', etiqueta: 'El auto' }}
  />

  <EscenarioModelo {modelos} />

  <section class="campo-oscuro overflow-clip bg-marca" aria-label="Rasgos del modelo">
    {
      modelos.map((modelo, indice) => (
        <Mosaico
          modelo={modelo.id}
          activo={indice === 0}
          items={modelo.mosaico}
          columnasExtra={modelo.tableroExtra}
          patron="tablero"
        />
      ))
    }
  </section>

  <section id="sobre" class="sobre-portada campo-oscuro relative isolate overflow-clip bg-marca">
    <div class="relative min-h-[72svh] overflow-clip">
      {
        modelos.map((modelo, indice) => (
          <Image
            src={sobrePorId[modelo.id]?.imagen ?? t5Cuarto}
            alt={sobrePorId[modelo.id]?.alt ?? modelo.nombre}
            widths={[800, 1440, 1920]}
            sizes="100vw"
            loading="lazy"
            data-modelo-vista={modelo.id}
            data-activo={indice === 0 ? '' : undefined}
            class="sobre-fondo absolute inset-0 h-full w-full object-cover"
          />
        ))
      }
      {/* Recorte generado: el material local no trae un zorro de campaña.
          La llegada la decide `.llega-zorro`, no esta caja. El animal
          no se conmuta: es la marca, no el modelo. */}
      <Zorro class="sobre-zorro absolute bottom-0 left-0 z-0" />
      <a
        href="/nosotros"
        class="losa-entra group absolute inset-x-0 bottom-0 z-10 flex min-h-[10.5rem] flex-col items-end justify-end bg-marca px-6 py-8 text-right text-white md:inset-x-auto md:right-0 md:w-[min(24rem,38vw)] md:px-8"
      >
        <span class="text-eyebrow uppercase tracking-[0.18em]">Sobre ARCFOX</span>
        <span class="sobre-titular mt-3 font-display text-subtitulo font-semibold uppercase">
          Conoce la marca
        </span>
        {/* El subrayado del enlace, no un indicador: con un tercio lleno se leía
            como una barra de scroll a medias. En reposo la pista entera y tenue;
            al pasar o con el foco del teclado se llena de izquierda a derecha. */}
        <span class="relative mt-8 block h-px w-full max-w-[14ch] bg-marca-clara/55" aria-hidden="true">
          <span class="absolute inset-0 origin-left scale-x-0 bg-marca-clara transition-transform duration-500 ease-out group-hover:scale-x-100 group-focus-visible:scale-x-100 motion-reduce:transition-none"></span>
        </span>
      </a>
    </div>
  </section>

  <Cierre
    id="cotizalo"
    tablero
    imagen={cotizar}
    alt="ARCFOX T5, vista de tres cuartos para cotizar."
    fondos={modelos.map((modelo) => ({
      id: modelo.id,
      imagen: cierrePorId[modelo.id]?.imagen ?? cotizar,
      alt: cierrePorId[modelo.id]?.alt ?? modelo.nombre,
    }))}
  >
    {/* La ficha vive en `/cotizalo`, como Contact Us en Global. Aquí
        sólo se abre la puerta: un formulario embebido competiría con
        la página dedicada y el ancla `/#cotizalo` seguiría existiendo. */}
    <div>
      <h2 class="revela-titular equilibra font-display text-h2 font-semibold uppercase tracking-[0.14em] text-white">
        Cotízalo
      </h2>
      <p class="revela mt-4 max-w-[46ch] text-lead text-white/75">
        Elige tu ARCFOX. Te contactamos desde el concesionario.
      </p>
      <div class="revela mt-8">
        <Boton href={CTA.href} tamano="lg">{CTA.texto}</Boton>
      </div>
    </div>
  </Cierre>
</Base>

<style>
  /* El zorro es fijo. El auto se conmuta con data-activo: si el recorte
     apuntara al vacío de la toma (15 % a la izquierda), en 390 sólo se
     leía suelo y el emblema quedaba tapado por la losa. */
  .sobre-fondo {
    transition: opacity 480ms var(--ease-out);
  }
  .sobre-fondo:not([data-activo]) {
    opacity: 0;
  }
  .sobre-fondo[data-activo] {
    opacity: 1;
  }

  .sobre-portada :global(.sobre-zorro) {
    width: clamp(7rem, 18vw, 16rem);
    max-width: 24svh;
  }

  .sobre-titular {
    max-width: 14ch;
    letter-spacing: 0.08em;
  }

  @media (width >= 48rem) {
    .sobre-fondo {
      object-position: 78% 55%;
    }
  }

  @media (width < 48rem) {
    .sobre-portada > div {
      min-height: 88svh;
    }
    /* A sangre el 3/4 llena la izquierda y el zorro se sentaba encima
       del techo. El auto es una losa a la derecha: trompa y placa,
       el animal se queda. `top: auto` + bottom lo encogía contra la losa. */
    .sobre-fondo {
      inset: auto;
      top: 8%;
      right: 0;
      width: 76%;
      height: 68%;
      mask-image: linear-gradient(to right, transparent, var(--color-marca) 14%);
    }
    .sobre-fondo[data-modelo-vista='t5'] {
      object-position: 16% 50%;
    }
    /* kv2 trae el wordmark de la toma arriba: un Y bajo lo colaba
       en el recorte. */
    .sobre-fondo[data-modelo-vista='t1'] {
      object-position: 30% 90%;
    }
    .sobre-fondo[data-modelo-vista='s5'] {
      object-position: 72% 52%;
    }
    /* Encima de la losa, no detrás: si comparte el borde inferior,
       las patas desaparecen detrás de «Conoce la marca». */
    .sobre-portada :global(.sobre-zorro) {
      bottom: 12.25rem;
      left: 0.25rem;
      width: 9.25rem;
      max-width: 32svh;
      z-index: 1;
    }
    /* 0.08 em en 390 come la A de MARCA y pega CONOCE LA. */
    .sobre-titular {
      max-width: none;
      letter-spacing: 0.04em;
      font-size: clamp(1.35rem, 6.4vw, 1.85rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sobre-fondo {
      transition: none;
    }
  }

  .sobre-portada a {
    text-decoration: none;
  }
</style>
