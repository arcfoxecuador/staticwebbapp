---
/* FOLLOW THE FOX publica el protocolo como experiencia principal. No hay auto,
   marca, contador, redes ni widget: en esta variante la encuesta ES la landing
   y ocupa el centro del campo azul→morado sin abrir ninguna capa adicional. */
import Teaser from '../layouts/Teaser.astro';
import ProtocoloComando from '../components/ui/ProtocoloComando.astro';
import { TEASER } from '../lib/site';
import { grafo, organizacion, pagina, sitioWeb } from '../lib/schema';

const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({ path: TEASER.path, titulo: TEASER.titulo, descripcion: TEASER.bajada }),
);
---

<Teaser titulo={TEASER.titulo} descripcion={TEASER.bajada} {schema}>
  <section
    data-slot="teaser"
    class="protocolo-landing campo-oscuro relative isolate grid min-h-svh place-items-center overflow-clip bg-marca"
  >
    <h1 class="sr-only">Follow the fox</h1>
    <div class="campo-protocolo" aria-hidden="true"></div>
    <div class="marcas-protocolo" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <div class="relative z-10 w-full">
      <ProtocoloComando modo="integrado" />
    </div>
  </section>
</Teaser>

<style>
  .protocolo-landing {
    padding-block: max(1rem, env(safe-area-inset-top)) max(1rem, env(safe-area-inset-bottom));
  }

  .campo-protocolo {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        90deg,
        transparent 0 34px,
        color-mix(in oklab, var(--color-campana-fria) 8%, transparent) 34px 35px
      ),
      radial-gradient(
        ellipse 68% 110% at 5% 50%,
        color-mix(in oklab, var(--color-campana-fria) 72%, var(--color-marca)),
        transparent 72%
      ),
      linear-gradient(
        112deg,
        color-mix(in oklab, var(--color-campana-fria) 48%, var(--color-marca)),
        var(--color-marca) 52%,
        color-mix(in oklab, var(--color-campana-calida) 50%, var(--color-marca))
      );
  }

  .marcas-protocolo {
    position: absolute;
    inset: clamp(1rem, 5vw, 4rem);
    pointer-events: none;
  }

  .marcas-protocolo span {
    position: absolute;
    width: 1rem;
    height: 1rem;
    opacity: 0.3;
  }

  .marcas-protocolo span::before,
  .marcas-protocolo span::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-superficie);
  }

  .marcas-protocolo span::after {
    transform: rotate(90deg);
  }

  .marcas-protocolo span:nth-child(2) {
    right: 0;
  }

  .marcas-protocolo span:nth-child(3) {
    bottom: 0;
  }

  .marcas-protocolo span:nth-child(4) {
    right: 0;
    bottom: 0;
  }
</style>
