---
/* La marca, no el catálogo. El texto es el aprobado por el cliente (nov. 2026):
   once bloques que cuentan quién es ARCFOX sin introducir otros modelos ni
   fechas de lanzamiento local sin confirmar. La única cronología es la que
   escribió el cliente —los hitos con HUAWEI, 2017-2021—, que sustituye a las
   tres cifras que pidió eliminar (ajustes en naranja, 10-nov-2026). */
import Base from '../layouts/Base.astro';
import Hero from '../components/bloques/Hero.astro';
import Seccion from '../components/bloques/Seccion.astro';
import Encabezado from '../components/bloques/Encabezado.astro';
import Rejilla from '../components/bloques/Rejilla.astro';
import Tarjeta from '../components/bloques/Tarjeta.astro';
import Escena from '../components/bloques/Escena.astro';
import GamaModelos from '../components/bloques/GamaModelos.astro';
import Faq from '../components/bloques/Faq.astro';
import Cierre from '../components/bloques/Cierre.astro';

import sobre from '../assets/sobre.webp';

import { CRONOLOGIA, CTA, FAQ, ORG } from '../lib/site';
import { faq, grafo, migas, organizacion, pagina, sitioWeb } from '../lib/schema';

const titulo = 'Sobre ARCFOX';
const descripcion =
  'ARCFOX es la marca de vehículos eléctricos premium de BAIC Group. Una propuesta que reúne diseño, innovación y confort para explorar una nueva forma de moverte.';

const NOMBRE = [
  {
    titulo: 'ARC',
    texto: 'Inspirado en el Ártico, expresa exploración y la decisión de avanzar hacia nuevas posibilidades.',
  },
  {
    titulo: 'FOX',
    texto: 'El zorro representa inteligencia y agilidad: cualidades que inspiran la personalidad de la marca.',
  },
];

const FILOSOFIA = [
  {
    titulo: 'Diseño con propósito',
    texto: 'Líneas limpias y espacios funcionales que hacen de cada vehículo un lugar para disfrutar.',
  },
  {
    titulo: 'Innovación para las personas',
    texto: 'Una visión de la movilidad que conecta tecnología, comodidad y necesidades cotidianas.',
  },
  {
    titulo: 'Espíritu libre',
    texto: 'La invitación a moverte a tu manera y descubrir nuevas posibilidades.',
  },
];

const ORIGEN = [
  {
    titulo: 'BAIC',
    texto: 'Fundado en 1958, BAIC Group aporta una trayectoria en la industria automotriz que acompaña la evolución de ARCFOX.',
  },
  {
    titulo: 'BAIC y Magna',
    texto: 'La colaboración entre BAIC y Magna forma parte de la historia industrial de ARCFOX y del desarrollo de su propuesta eléctrica.',
  },
];

const PROPUESTA = [
  { titulo: 'Diseño', texto: 'Una identidad reconocible, con líneas que expresan personalidad.' },
  { titulo: 'Espacio', texto: 'Interiores pensados para las personas y sus planes.' },
  { titulo: 'Confort', texto: 'Detalles que invitan a disfrutar cada trayecto.' },
  { titulo: 'Movilidad eléctrica', texto: 'Una nueva forma de vivir la conducción.' },
  { titulo: 'Elección', texto: 'T1, T5 y S5: encuentra el ARCFOX que va contigo.' },
];

const schema = grafo(
  organizacion(),
  sitioWeb(),
  pagina({ path: '/nosotros', titulo, descripcion, tipo: 'AboutPage' }),
  migas([{ nombre: titulo, path: '/nosotros' }]),
  faq(FAQ),
);
---

<Base {titulo} {descripcion} path="/nosotros" {schema}>
  <Hero
    rotulo="La marca"
    titulo="Inspirados en la libertad"
    bajada={descripcion}
    accion={{ texto: 'Explora los modelos', href: '/modelos' }}
    secundaria={{ texto: 'Cotiza tu ARCFOX', href: CTA.href }}
  />

  <Escena
    imagen={sobre}
    alt="ARCFOX en un paisaje nocturno junto al zorro, emblema de la marca."
    rotulo="Nuestra esencia"
    titulo={ORG.tagline}
    bajada="Creemos en una movilidad que refleje tu personalidad. En el valor de los detalles, la libertad de elegir y la emoción de descubrir nuevos caminos."
    altura="media"
    anclaje="centro"
  />

  <Seccion>
    <Encabezado
      rotulo="Nuestro nombre"
      titulo="Una identidad que mira más allá"
      bajada="ARCFOX reúne la inspiración del Ártico con la inteligencia y agilidad del zorro."
    />
    <Rejilla columnas={2} class="mt-12">
      {NOMBRE.map((item) => <Tarjeta titulo={item.titulo} bajada={item.texto} brillo={false} />)}
    </Rejilla>
  </Seccion>

  <Seccion campo="tinte">
    <Encabezado rotulo="Nuestra filosofía" titulo="Lo que nos mueve" />
    <Rejilla columnas={3} class="mt-12">
      {FILOSOFIA.map((item) => <Tarjeta titulo={item.titulo} bajada={item.texto} brillo={false} />)}
    </Rejilla>
  </Seccion>

  <Seccion>
    <Encabezado
      rotulo="Identidad"
      titulo="Diseño que encuentra lo esencial"
      bajada="Walter de’Silva participó junto con EDAG en el desarrollo del concepto y la identidad de ARCFOX. Su enfoque minimalista busca reducir lo innecesario para crear una experiencia visual limpia y armoniosa."
    />
    <blockquote class="revela mt-12 max-w-[30ch] border-l-2 border-marca-clara pl-6 font-display text-subtitulo font-semibold text-marca">
      Cada línea tiene una intención. Cada espacio, una posibilidad.
    </blockquote>
  </Seccion>

  <Seccion campo="tinte">
    <Encabezado
      rotulo="Nuestro origen"
      titulo="Experiencia que impulsa una nueva movilidad"
      bajada="ARCFOX forma parte del desarrollo de la movilidad eléctrica de BAIC Group."
    />
    <Rejilla columnas={2} class="mt-12">
      {ORIGEN.map((item) => <Tarjeta titulo={item.titulo} bajada={item.texto} brillo={false} />)}
    </Rejilla>
  </Seccion>

  <Seccion>
    <Encabezado
      rotulo="Nuestra propuesta"
      titulo="Una experiencia que empieza contigo"
      bajada="Cinco ideas que dan forma a nuestra manera de entender la movilidad."
    />
    <Rejilla columnas={3} class="mt-12">
      {
        PROPUESTA.map((item, i) => (
          <Tarjeta
            etiqueta={String(i + 1).padStart(2, '0')}
            titulo={item.titulo}
            bajada={item.texto}
            brillo={false}
          />
        ))
      }
    </Rejilla>
  </Seccion>

  {/* Sección 8 del documento: la cabecera se queda y las tres cifras se
      cambiaron por la cronología con HUAWEI (ajustes en naranja). Es una
      `<ol>` porque el orden es el contenido: leída fuera de orden, la historia
      deja de tener sentido. */}
  <Seccion campo="tinte">
    <Encabezado
      rotulo="ARCFOX en Ecuador"
      titulo="Una nueva energía para tus caminos"
      bajada="Conoce una propuesta que une la experiencia automotriz de BAIC con tres formas de vivir la movilidad eléctrica."
    />
    <ol class="revela-grupo mt-12 flex flex-col">
      {
        CRONOLOGIA.map((hito) => (
          <li class="grid gap-3 border-t border-linea py-6 last:border-b md:grid-cols-[12rem_1fr] md:gap-10">
            <time datetime={hito.iso} class="text-small font-semibold tracking-[0.08em] tabular-nums text-marca">
              {hito.fecha}
            </time>
            <p class="max-w-[68ch] text-small text-tinta/75">{hito.texto}</p>
          </li>
        ))
      }
    </ol>
  </Seccion>

  <Seccion>
    <Encabezado
      rotulo="Elige tu ARCFOX"
      titulo="Tres modelos. Tu propia forma de avanzar."
      bajada="Descubre la versatilidad del T1, la amplitud del T5 y el carácter deportivo del S5."
    />
    <GamaModelos class="mt-12" />
  </Seccion>

  <Seccion campo="tinte">
    <Encabezado titulo="Conoce más sobre ARCFOX" />
    <div class="mt-10">
      <Faq items={FAQ} />
    </div>
  </Seccion>

  <Cierre
    titulo="Tu siguiente camino empieza aquí"
    bajada="Conoce nuestros modelos y encuentra una nueva forma de moverte."
    accion={{ texto: 'Encuentra tu ARCFOX', href: '/modelos' }}
  />
</Base>
