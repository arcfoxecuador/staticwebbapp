---
/* La cabecera. El cajón de móvil y el desplegable de Modelos son `<details>`.
   En la portada queda fija: cambiar de auto es un estado de toda la página, no
   un enlace a otra URL, y el selector tiene que seguir a la vista al bajar. */
import Marca from '../ui/Marca.astro';
import { NAV } from '../../lib/site';

interface Props {
  /** Flota sobre el hero en vez de ocupar su propia banda. */
  flotante?: boolean;
  /** La ruta canónica de la página. En el build estático `Astro.url.pathname`
      no siempre es `/` en la portada, y el recorte del sello depende de eso. */
  ruta?: string;
}
const { flotante = false, ruta = Astro.url.pathname } = Astro.props;
const enPortada = ruta === '/';
const activa = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return ruta === '/' || ruta.startsWith('/modelos');
  return ruta.startsWith(href);
};
const idDeHijo = (href: string) => href.replace(/^\/(?:modelos\/|#)/, '');
---

<header
  class:list={[
    'z-50 w-full',
    enPortada
      ? 'fixed inset-x-0 top-0 bg-marca campo-oscuro'
      : flotante
        ? 'absolute inset-x-0 top-0 campo-oscuro'
        : 'relative border-b border-linea bg-superficie',
  ]}
>
  <div
    class:list={[
      'medida items-center',
      enPortada
        ? 'grid grid-cols-[auto_minmax(0,1fr)_auto] py-3 pt-[max(0.75rem,env(safe-area-inset-top))] lg:flex lg:justify-between lg:gap-6 lg:py-4 lg:pt-4'
        : 'flex justify-between gap-4 py-3 pt-[max(0.75rem,env(safe-area-inset-top))] lg:py-4 lg:pt-4',
    ]}
  >
    <Marca class="justify-self-start" tono={flotante || enPortada ? 'blanco' : 'marca'} />

    {
      enPortada && (
        <div class="selector-cabecera flex items-center justify-self-center lg:hidden" role="group" aria-label="Cambiar modelo">
          <button type="button" data-modelo-anterior aria-label="Modelo anterior">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </button>
          <p data-modelo-nombre-corto class="min-w-[3.5rem] text-center text-small font-medium uppercase tracking-[0.14em] text-white">
            T5
          </p>
          <button type="button" data-modelo-siguiente aria-label="Modelo siguiente">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M4.5 2.5 8 6 4.5 9.5" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </button>
        </div>
      )
    }

    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-7">
        {
          NAV.map((zona) => (
            <li class="relative">
              {zona.hijos ? (
                enPortada ? (
                  <div class="flex items-center gap-1" role="group" aria-label="Cambiar modelo">
                    <button type="button" data-modelo-anterior class="selector-flecha" aria-label="Modelo anterior">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.3" />
                      </svg>
                    </button>
                    <details class="group/nav">
                      <summary class="flex cursor-pointer list-none items-center gap-1.5 text-small font-medium uppercase tracking-[0.14em] text-white/85 hover:text-white">
                        <span data-modelo-nombre-corto>T5</span>
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                          <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.4" />
                        </svg>
                      </summary>
                      <ul class="absolute left-1/2 top-full z-50 mt-3 min-w-64 -translate-x-1/2 border border-linea bg-superficie campo-claro py-2">
                        {zona.hijos.map((hijo) => (
                          <li>
                            <a
                              href={hijo.href}
                              data-cambia-modelo={idDeHijo(hijo.href)}
                              class="block px-4 py-3 text-small text-tinta hover:bg-tinte"
                            >
                              <span class="block font-semibold text-marca">{hijo.texto}</span>
                              {hijo.bajada && (
                                <span class="mt-0.5 block text-tinta/55">{hijo.bajada}</span>
                              )}
                            </a>
                          </li>
                        ))}
                        <li>
                          <a href="/modelos" class="block px-4 py-3 text-small text-tinta/70 hover:bg-tinte">
                            Ver la gama
                          </a>
                        </li>
                      </ul>
                    </details>
                    <button type="button" data-modelo-siguiente class="selector-flecha" aria-label="Modelo siguiente">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M4.5 2.5 8 6 4.5 9.5" stroke="currentColor" stroke-width="1.3" />
                      </svg>
                    </button>
                  </div>
                ) : (
                <details class="group/nav">
                  <summary
                    class:list={[
                      'flex cursor-pointer list-none items-center gap-1.5 text-small font-medium uppercase tracking-[0.14em]',
                      flotante ? 'text-white/85 hover:text-white' : 'text-tinta/75 hover:text-marca',
                      activa(zona.href) && (flotante ? 'text-white' : 'text-marca'),
                    ]}
                  >
                    {zona.texto}
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  </summary>
                  <ul class="absolute left-0 top-full z-50 mt-3 min-w-64 border border-linea bg-superficie campo-claro py-2">
                    {zona.hijos.map((hijo) => (
                      <li>
                        <a
                          href={hijo.href}
                          class="block px-4 py-3 text-small text-tinta hover:bg-tinte"
                        >
                          <span class="block font-semibold text-marca">{hijo.texto}</span>
                          {hijo.bajada && (
                            <span class="mt-0.5 block text-tinta/55">{hijo.bajada}</span>
                          )}
                        </a>
                      </li>
                    ))}
                    <li>
                      <a href="/modelos" class="block px-4 py-3 text-small text-tinta/70 hover:bg-tinte">
                        Ver la gama
                      </a>
                    </li>
                  </ul>
                </details>
                )
              ) : (
                <a
                  href={zona.href}
                  aria-current={activa(zona.href) ? 'page' : undefined}
                  class:list={[
                    'text-small font-medium uppercase tracking-[0.14em]',
                    flotante || enPortada ? 'text-white/85 hover:text-white' : 'text-tinta/75 hover:text-marca',
                    activa(zona.href) && (flotante || enPortada ? 'text-white' : 'text-marca'),
                  ]}
                >
                  {zona.texto}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="group justify-self-end lg:hidden">
      <summary
        class:list={[
          'flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-[var(--radius-md)]',
          flotante || enPortada ? 'text-white' : 'text-marca',
        ]}
        aria-label="Abrir el menú"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            class="transition-opacity group-open:opacity-0"
          />
          <path
            d="M6 6l12 12M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            class="opacity-0 transition-opacity group-open:opacity-100"
          />
        </svg>
      </summary>

      <div class="absolute inset-x-0 top-full z-50 border-b border-linea bg-superficie campo-claro">
        <nav class="medida py-6" aria-label="Navegación principal">
          <ul class="flex flex-col gap-1">
            {
              NAV.map((zona) => (
                <li>
                  <a
                    href={enPortada && zona.hijos ? '/#escenario' : zona.href}
                    aria-current={activa(zona.href) ? 'page' : undefined}
                    class:list={[
                      'flex min-h-[44px] items-center text-lead font-medium uppercase tracking-[0.12em]',
                      activa(zona.href) ? 'text-marca' : 'text-tinta/80',
                    ]}
                  >
                    {zona.texto}
                  </a>
                  {zona.hijos && (
                    <ul class="mb-2 ml-3 border-l border-linea pl-4">
                      {zona.hijos.map((hijo) => (
                        <li>
                          <a
                            href={hijo.href}
                            data-cambia-modelo={enPortada ? idDeHijo(hijo.href) : undefined}
                            class="flex min-h-[44px] items-center text-small text-tinta/70"
                          >
                            {hijo.texto}
                          </a>
                        </li>
                      ))}
                      <li>
                        <a href="/modelos" class="flex min-h-[44px] items-center text-small text-tinta/50">
                          Ver la gama
                        </a>
                      </li>
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </details>
  </div>
</header>

<style>
  .selector-cabecera button,
  .selector-flecha {
    display: inline-grid;
    width: 44px;
    min-height: 44px;
    place-items: center;
    border: 0;
    background: transparent;
    color: white;
    cursor: pointer;
  }
</style>
