---
/* Pie del look aprobado: superficie oscura, marca a la izquierda, redes a la
   derecha. El aviso legal —cuando existe— va debajo, no dentro de una columna
   de marketing: es la letra chica, no un párrafo de venta. */
import Marca from '../ui/Marca.astro';
import Zorro from '../ui/Zorro.astro';
import { ORG, NAV, AVISO_LEGAL, DOCUMENTOS_LEGALES } from '../../lib/site';

const anio = new Date().getFullYear();

/* El nombre de la red como se escribe, no como sale del dominio: «tiktok»
   en versales se lee TIKTOK, y la marca es TikTok. */
const NOMBRES_RED: Record<string, string> = {
  instagram: 'Instagram',
  tiktok: 'TikTok',
  facebook: 'Facebook',
};
const nombreRed = (url: string) => {
  const clave = new URL(url).hostname.replace('www.', '').split('.')[0];
  return NOMBRES_RED[clave] ?? clave;
};
---

<footer class="campo-oscuro relative overflow-clip border-t border-white/15 bg-marca text-white/70">
  {/* El pie ya lleva el wordmark. El zorro es rastro, no un segundo logo. */}
  <Zorro tamano="marca" decorativo class="absolute bottom-0 left-2 z-0 opacity-35 max-md:left-0" />
  <div class="medida relative z-10 flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
    <Marca tono="blanco" enlace={false} />

    {
      ORG.redes.length > 0 && (
        <ul class="flex gap-5">
          {ORG.redes.map((red) => (
            <li>
              <a
                href={red}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-small tracking-[0.04em] hover:text-white"
              >
                {nombreRed(red)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="medida relative z-10 border-t border-white/15 py-6">
    <nav aria-label="Navegación del pie" class="flex flex-wrap gap-x-6 gap-y-2 text-small">
      {
        NAV.map((zona) => (
          <a href={zona.href} class="inline-flex min-h-11 items-center hover:text-white">
            {zona.texto}
          </a>
        ))
      }
    </nav>

    {
      AVISO_LEGAL && (
        <p class="mt-6 max-w-[80ch] text-small text-white/50">{AVISO_LEGAL}</p>
      )
    }

    <div class="mt-6 flex flex-col gap-2 text-small text-white/45 md:flex-row md:justify-between">
      <p>© {anio} {ORG.nombreLegal}. Todos los derechos reservados.</p>
      {
        DOCUMENTOS_LEGALES.length > 0 && (
          <ul class="flex flex-wrap gap-x-6 gap-y-2">
            {DOCUMENTOS_LEGALES.map((documento) => (
              <li>
                <a href={documento.ruta} class="hover:text-white">
                  {documento.etiqueta}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</footer>
