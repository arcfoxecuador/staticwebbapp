---
/* La barra de acción fija de móvil. Sólo por debajo de `lg`: en escritorio el
   CTA ya vive en la cabecera y esto sería una segunda copia del mismo botón.

   Mide 85px reales (52 de botón + 32 de relleno + 1 de filete) y ESE número está
   escrito en global.css, que reserva el hueco en el <body> y ajusta
   `scroll-padding-bottom` para que la barra no tape el elemento enfocado (WCAG
   2.2, SC 2.4.11). Si cambias la altura del botón, cambian los dos sitios.

   Se apaga con `barraAccion={false}` en las páginas donde el CTA ES el contenido
   —la de contacto, sobre todo—: allí la barra tapa el formulario que promociona. */
import Boton from '../ui/Boton.astro';
import { CTA, ORG } from '../../lib/site';
---

<div
  class="barra-accion fixed inset-x-0 bottom-0 z-40 border-t border-linea bg-superficie px-5 py-4 pb-[calc(1rem+env(safe-area-inset-bottom))] lg:hidden print:hidden"
>
  <div class="flex items-center gap-3">
    <Boton href={CTA.href} ancho>{CTA.texto}</Boton>
    {/* `noopener` no es opcional en un enlace externo con `target="_blank"`: sin
        él la página destino recibe una referencia a esta ventana. Y el comentario
        va AQUÍ y no entre los atributos: dentro de la etiqueta, Astro lo parsea
        como si fuera una lista de atributos más. */}
    {
      ORG.whatsapp && (
        <a
          href={`https://wa.me/${ORG.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Escribir por WhatsApp"
          class="flex min-h-[52px] min-w-[52px] shrink-0 items-center justify-center rounded-[var(--radius-pill)] border border-marca/60 text-marca"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M17.5 14.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.1s-.8 1-1 1.2c-.2.2-.4.2-.7.1a7.3 7.3 0 0 1-2.2-1.4 8.2 8.2 0 0 1-1.5-1.9c-.2-.3 0-.5.1-.6l.6-.7c.2-.2.1-.4 0-.6l-.9-2.1c-.2-.5-.4-.4-.6-.4h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 1.5 2.3 3.6 3.2 2.1.9 2.5.7 2.9.7.4 0 1.4-.5 1.6-1.1.2-.6.2-1 .1-1.1zM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.3A10 10 0 1 0 12 2z"
            />
          </svg>
        </a>
      )
    }
  </div>
</div>
