---
/* Vitrina de un modelo en la portada. Un auto, una foto, los datos que sí
   podemos afirmar. Los círculos de color son la paleta que se ve en ficha, no
   un configurador: sin stock local confirmado, cambiar de swatch mentiría. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nombre: string;
  href: string;
  imagen: ImageMetadata;
  alt: string;
  color?: string;
  datos: { valor: string; etiqueta: string }[];
}

const { nombre, href, imagen, alt, color = 'Gris', datos } = Astro.props;
---

<div data-slot="vitrina-modelo" class="revela">
  <div class="flex items-center justify-between gap-4">
    <h2 class="font-display text-h2 font-semibold uppercase tracking-[0.18em] text-marca">{nombre}</h2>
    <a href={href} class="text-small uppercase tracking-[0.14em] text-marca/70 hover:text-marca">
      Ver ficha →
    </a>
  </div>

  <div class="mt-10">
    <Image
      src={imagen}
      {alt}
      widths={[640, 1024, 1440]}
      sizes="(min-width: 1024px) 70vw, 100vw"
      class="mx-auto h-auto max-h-[420px] w-full object-contain"
    />

    <p class="mt-8 text-center text-eyebrow uppercase tracking-[0.16em] text-tinta/55">{color}</p>
  </div>

  <dl class="mt-12 grid grid-cols-2 gap-8 border-t border-linea pt-8 md:grid-cols-4">
    {
      datos.map((d) => (
        <div>
          <dt class="text-eyebrow uppercase tracking-[0.16em] text-tinta/50">{d.etiqueta}</dt>
          <dd class="mt-2 font-display text-stat font-semibold text-marca">{d.valor}</dd>
        </div>
      ))
    }
  </dl>
</div>
