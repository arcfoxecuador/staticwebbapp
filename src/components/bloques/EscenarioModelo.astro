---
/* El escenario imita un plato de estudio, pero conserva la verdad del material:
   cambia fotografías ordenadas; no dibuja una órbita WebGL donde no hay malla. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Fotograma = {
  imagen: ImageMetadata;
  alt: string;
};

export type ColorModelo = {
  etiqueta: string;
  muestra?: string;
  fotogramas: Fotograma[];
};

export type ModeloEscenario = {
  id: string;
  nombre: string;
  rotulo?: string;
  colores: ColorModelo[];
  datos: { clave: string; valor: string }[];
};

interface Props {
  modelos: ModeloEscenario[];
}

const { modelos } = Astro.props;
---

{
  modelos.length > 0 && (
    <section id="escenario" data-slot="escenario-modelo" class="escenario-modelo campo-claro bg-fondo">
      <div class="plano" aria-hidden="true"></div>
      <div class="medida relative py-16 md:py-24">
        <div class="selector-modelo sticky top-16 z-20 revela-titular" role="group" aria-label="Cambiar modelo">
          <button type="button" data-modelo-anterior aria-label="Modelo anterior">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </button>
          <p data-modelo-nombre aria-live="polite">{modelos[0]?.nombre}</p>
          <button type="button" data-modelo-siguiente aria-label="Modelo siguiente">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M4.5 2.5 8 6 4.5 9.5" stroke="currentColor" stroke-width="1.3" />
            </svg>
          </button>
        </div>

        {modelos.map((modelo, indiceModelo) => (
          <article
            id={modelo.id}
            aria-label={modelo.nombre}
            data-modelo-panel={modelo.id}
            data-modelo-corto={modelo.nombre.replace(/^ARCFOX\s+/i, '')}
            data-rotulo={modelo.rotulo}
            hidden={indiceModelo !== 0}
          >
            <div
              class="plato"
              tabindex="0"
              data-giro
              aria-label={`Gira el ${modelo.nombre} arrastrando o con las flechas del teclado`}
            >
              <div class="marco" aria-hidden="true"></div>
              {modelo.colores.map((color, indiceColor) => (
                <div
                  class:list={['fotogramas', indiceColor === 0 && 'esta-activo']}
                  data-color={color.etiqueta}
                  aria-hidden={indiceColor === 0 ? 'false' : 'true'}
                >
                  {color.fotogramas.map((fotograma, indiceFotograma) => (
                    <Image
                      src={fotograma.imagen}
                      alt={fotograma.alt}
                      widths={[640, 960, 1280]}
                      sizes="(min-width: 768px) 70vw, 100vw"
                      loading={indiceModelo === 0 && indiceColor === 0 && indiceFotograma === 0 ? 'eager' : 'lazy'}
                      class:list={['fotograma', indiceFotograma === 0 && 'esta-activo']}
                      data-fotograma
                    />
                  ))}
                </div>
              ))}
              <p class="aviso-giro">Arrastra para girar</p>
            </div>

            {modelo.colores.length > 1 && (
              <fieldset class="colores">
                <legend>Color</legend>
                {modelo.colores.map((color, indiceColor) => (
                  <button
                    type="button"
                    class:list={['muestra', indiceColor === 0 && 'esta-activo']}
                    style={color.muestra ? `--muestra:${color.muestra}` : undefined}
                    data-color-control={color.etiqueta}
                    aria-label={`Ver ${modelo.nombre} en ${color.etiqueta}`}
                    aria-pressed={indiceColor === 0 ? 'true' : 'false'}
                  >
                    <span>{color.etiqueta}</span>
                  </button>
                ))}
              </fieldset>
            )}

            <dl class="barra-datos revela-grupo">
              {modelo.datos.slice(0, 4).map((dato) => (
                <div>
                  <dt>{dato.clave}</dt>
                  <dd>{dato.valor}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>
  )
}

<script>
  import '../../lib/escenario-modelo';
</script>

<style>
  .escenario-modelo {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .plano {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--color-marca) 8%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--color-marca) 8%, transparent) 1px, transparent 1px);
    background-size: min(25vw, 20rem) 100%, 100% 14rem;
    /* La retícula se abre con la sección: si naciera ya dibujada, el
       plato parece un fondo estático y no un estudio que se enciende. */
    animation: abrir-plano linear both;
    animation-timeline: view();
    animation-range: cover 0% cover 38%;
  }
  @keyframes abrir-plano {
    from { clip-path: inset(10% 6%); opacity: 0; }
    to   { clip-path: inset(0); opacity: 1; }
  }
  .selector-modelo {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 44px;
    background: color-mix(in srgb, var(--color-fondo) 92%, transparent);
  }
  .selector-modelo button {
    display: inline-grid;
    width: 44px;
    min-height: 44px;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--color-marca);
    cursor: pointer;
  }
  .selector-modelo p {
    display: flex;
    min-width: min(65vw, 16rem);
    min-height: 44px;
    align-items: center;
    justify-content: center;
    color: var(--color-marca);
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .plato {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(22rem, 52vw, 39rem);
    margin-top: 1rem;
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }
  /* Marco, no plato: el óvalo de estudio pelea con las losas del
     mosaico. El auto se lee dentro de una casilla, como el resto. */
  .marco {
    position: absolute;
    left: 50%;
    top: 52%;
    width: min(78%, 54rem);
    aspect-ratio: 16 / 10;
    border: 1px solid color-mix(in srgb, var(--color-marca) 22%, transparent);
    transform: translate(-50%, -50%);
    animation: posar-marco linear both;
    animation-timeline: view();
    animation-range: cover 8% cover 42%;
  }
  @keyframes posar-marco {
    from { transform: translate(-50%, -50%) scale(0.92); opacity: 0; }
    to   { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  }
  .marco::after {
    content: '';
    position: absolute;
    inset: 8%;
    border: 1px solid color-mix(in srgb, var(--color-marca) 10%, transparent);
  }
  .fotogramas {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
  }
  .fotogramas.esta-activo {
    display: grid;
  }
  .fotograma {
    position: absolute;
    width: min(88%, 62rem);
    max-height: 80%;
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
  }
  .fotograma.esta-activo {
    opacity: 1;
  }
  .aviso-giro {
    position: absolute;
    right: 0;
    bottom: 1rem;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-tinta) 60%, transparent);
  }
  .colores {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: -1rem;
    border: 0;
  }
  .colores legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: clip;
    clip-path: inset(50%);
  }
  .muestra {
    display: grid;
    place-items: center;
    width: 52px;
    min-height: 58px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .muestra::before {
    content: '';
    width: 22px;
    height: 22px;
    border: 1px solid color-mix(in srgb, var(--color-marca) 25%, transparent);
    background: var(--muestra, var(--color-superficie));
    outline: 1px solid transparent;
    outline-offset: 4px;
  }
  .muestra.esta-activo::before {
    outline-color: var(--color-marca);
  }
  .muestra span {
    margin-top: 5px;
    font-size: var(--text-eyebrow);
    color: var(--color-tinta);
  }
  .barra-datos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 3rem;
    background: color-mix(in srgb, var(--color-marca-clara) 45%, transparent);
  }
  .barra-datos > div {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    min-height: 8.5rem;
    padding: 1.5rem;
    text-align: right;
    background: var(--color-marca);
    color: white;
  }
  .barra-datos dt {
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, white 55%, transparent);
  }
  .barra-datos dd {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: var(--text-dato);
    font-weight: 600;
    color: white;
  }
  @media (width < 48rem) {
    .plano {
      background-size: 50vw 100%, 100% 11rem;
    }
    .plato {
      min-height: 22rem;
      margin-top: 0;
    }
    .fotograma {
      width: 100%;
      max-height: 72%;
    }
    .marco {
      top: 50%;
      width: 92%;
    }
    .aviso-giro {
      right: 50%;
      bottom: 0;
      transform: translateX(50%);
      white-space: nowrap;
    }
    .barra-datos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .barra-datos > div {
      min-height: 7rem;
      padding: 1.15rem 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plano,
    .marco {
      animation: none;
      clip-path: none;
      opacity: 1;
      transform: none;
    }
    .marco {
      transform: translate(-50%, -50%);
    }
  }
</style>
