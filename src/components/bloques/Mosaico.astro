---
/* `tablero` es el look de portada: casillas iguales que se intercalan,
   no una franja de fotos sobre una barra de specs. `trenzado` queda para
   cuando el copy no puede competir en superficie. overflow-clip (no hidden)
   para que las fotos revelen. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type CeldaMosaico = {
  texto?: string;
  titulo?: string;
  bajada?: string;
  imagen?: ImageMetadata;
  alt?: string;
  ancho?: 1 | 2;
};

interface Props {
  items: CeldaMosaico[];
  patron?: 'trenzado' | 'destacado' | 'tablero';
  class?: string;
  /** Identificador del modelo dueño de esta rejilla en la portada. */
  modelo?: string;
  activo?: boolean;
}

const { items, patron = 'trenzado', class: extra, modelo, activo = true } = Astro.props;

const FOTO_TRAMO = [
  'md:col-span-5 md:row-start-1',
  'md:col-span-4 md:row-start-1',
  'md:col-span-3 md:row-start-1',
] as const;
const TEXTO_TRAMO = [
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
] as const;

const columnas = patron === 'trenzado' ? 'md:grid-cols-12' : 'md:grid-cols-3';
const tablero = patron === 'tablero';
---

{
  items.length > 0 && (
    <div
      data-slot="mosaico"
      data-modelo-vista={modelo}
      data-oculta={modelo ? '' : undefined}
      hidden={Boolean(modelo) && !activo}
      class:list={['tira tira-casilla grid gap-px bg-marca-clara/20', columnas, extra]}
    >
      {items.map((celda, i) => {
        const destacado = patron === 'destacado' && i === 0;
        const ancho = celda.ancho === 2 || destacado;
        const esFoto = Boolean(celda.imagen && celda.alt);
        const indiceFoto = items.slice(0, i).filter((c) => c.imagen && c.alt).length;
        const indiceTexto = items.slice(0, i).filter((c) => !c.imagen && (c.texto || c.titulo)).length;
        const ultimoTexto =
          items.filter((c) => !c.imagen && (c.texto || c.titulo)).length - 1;
        const tramo = tablero
          ? undefined
          : patron === 'trenzado'
            ? esFoto
              ? (FOTO_TRAMO[indiceFoto] ?? 'md:col-span-4 md:row-start-1')
              : (TEXTO_TRAMO[indiceTexto] ?? 'md:col-span-4 md:row-start-2')
            : ancho
              ? 'md:col-span-2'
              : undefined;
        const ancha = tablero ? false : patron === 'trenzado' ? indiceFoto === 0 : Boolean(ancho);

        if (esFoto && celda.imagen && celda.alt) {
          return (
            <div
              class:list={[
                'celda-foto overflow-clip',
                /* La foto llena la losa: el aspect lo marca el hueco, no
                   el intrínseco del archivo — si no, tres tomas distintas
                   descuadran el tablero. */
                tablero && 'relative min-h-56 md:aspect-[4/5] md:min-h-0',
                tramo,
              ]}
            >
              <Image
                src={celda.imagen}
                alt={celda.alt}
                widths={[480, 800, 1200]}
                sizes={
                  tablero
                    ? '(min-width: 768px) 33vw, 100vw'
                    : ancha
                      ? '(min-width: 768px) 42vw, 100vw'
                      : '(min-width: 768px) 28vw, 100vw'
                }
                class:list={[
                  'h-full min-h-56 w-full object-cover',
                  /* En tablero la losa ya se abre con `.tira-casilla`. Un
                     segundo recorte (`.revela-imagen`) deja la foto a media
                     máscara justo cuando se lee el tablero. */
                  tablero
                    ? 'absolute inset-0 min-h-0'
                    : [
                        'revela-imagen',
                        patron === 'trenzado'
                          ? 'md:min-h-[32rem] md:aspect-[4/3]'
                          : 'md:min-h-[22rem]',
                      ],
                ]}
              />
            </div>
          );
        }
        if (celda.texto || celda.titulo) {
          return (
            <div
              class:list={[
                'celda-texto flex flex-col bg-marca text-white',
                tablero
                  ? 'min-h-56 items-end justify-end px-6 py-8 text-right md:aspect-[4/5] md:min-h-0 md:px-8 md:py-10'
                  : 'justify-center px-5 py-6 md:px-6 md:py-7',
                tramo,
              ]}
            >
              <p
                class:list={[
                  'font-display font-semibold uppercase',
                  /* En tablero el recorte de `.revela-titular` deja la losa
                     negra y el copy invisible: la casilla YA entra con
                     `.tira-casilla`. El título viaja con ella. */
                  tablero
                    ? 'max-w-[14ch] text-subtitulo tracking-[0.08em]'
                    : 'revela-titular text-small tracking-[0.08em]',
                ]}
              >
                {celda.titulo ?? celda.texto}
              </p>
              {
                !tablero && celda.bajada && (
                  <p class="revela mt-2 text-small text-white/60">{celda.bajada}</p>
                )
              }
              {
                tablero && indiceTexto === ultimoTexto && (
                  <span
                    class="relative mt-10 block h-px w-full max-w-[14ch] bg-marca-clara/35"
                    aria-hidden="true"
                  >
                    <span class="absolute inset-y-0 left-0 w-1/3 bg-marca-clara"></span>
                  </span>
                )
              }
            </div>
          );
        }
        return null;
      })}
    </div>
  )
}

<style>
  /* Al cambiar de modelo el mosaico ya está en pantalla: view() no vuelve a
     disparar. El reloj recorre el mismo gesto que `.tira`, una vez. */
  .prende > * {
    animation: entrar-casilla 720ms var(--ease-out) both;
  }
  .prende > *:nth-child(2) { animation-delay: 60ms; }
  .prende > *:nth-child(3) { animation-delay: 120ms; }
  .prende > *:nth-child(4) { animation-delay: 180ms; }
  .prende > *:nth-child(5) { animation-delay: 240ms; }
  .prende > *:nth-child(6) { animation-delay: 300ms; }
  .prende .revela-imagen {
    animation: revelar-imagen 980ms var(--ease-out) both;
  }
  .prende .revela-titular {
    animation: revelar-titular 720ms var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .prende > *,
    .prende .revela-imagen,
    .prende .revela-titular {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
  }
</style>
