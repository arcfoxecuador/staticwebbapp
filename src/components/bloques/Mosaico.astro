---
/* `tablero` es el look de portada: tres columnas donde la FOTO es la
   losa larga y el texto es la losa corta. Un 3×2 de casillas iguales
   aplasta esa jerarquía — la maqueta no reparte la altura a medias.
   `trenzado` queda para cuando el copy no puede competir en superficie.
   overflow-clip (no hidden) para que las fotos revelen. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type CeldaMosaico = {
  texto?: string;
  titulo?: string;
  bajada?: string;
  imagen?: ImageMetadata;
  alt?: string;
  ancho?: 1 | 2;
};

/** Columnas del tablero que viven a la derecha, fuera de la vista inicial:
    una casilla de texto (título o cifra) y su foto. */
export type ColumnaExtra = {
  titulo?: string;
  cifra?: string;
  etiqueta?: string;
  imagen: ImageMetadata;
  alt: string;
  /** Foto generada con IA: queda declarada en el HTML con `data-generada`. */
  generada?: boolean;
};

interface Props {
  items: CeldaMosaico[];
  patron?: 'trenzado' | 'destacado' | 'tablero';
  class?: string;
  /** Identificador del modelo dueño de esta rejilla en la portada. */
  modelo?: string;
  activo?: boolean;
  /** Sólo `tablero`: columnas que se descubren arrastrando. */
  columnasExtra?: ColumnaExtra[];
}

const {
  items,
  patron = 'trenzado',
  class: extra,
  modelo,
  activo = true,
  columnasExtra = [],
} = Astro.props;

const FOTO_TRAMO = [
  'md:col-span-5 md:row-start-1',
  'md:col-span-4 md:row-start-1',
  'md:col-span-3 md:row-start-1',
] as const;
const TEXTO_TRAMO = [
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
] as const;

const columnas = patron === 'trenzado' ? 'md:grid-cols-12' : 'md:grid-cols-3';
const tablero = patron === 'tablero';

const esFoto = (celda: CeldaMosaico) => Boolean(celda.imagen && celda.alt);
const esTexto = (celda: CeldaMosaico) => Boolean(!celda.imagen && (celda.texto || celda.titulo));

const fotos = items.filter(esFoto);
const textos = items.filter(esTexto);

/* Columna 1: titular + foto baja. 2 y 3: foto alta + titular.
   Así la foto mide de más y el texto no se hincha al aspect de la foto. */
const grupos = tablero
  ? (
      [
        [textos[0], fotos[2]].filter(Boolean),
        [fotos[0], textos[1]].filter(Boolean),
        [fotos[1], textos[2]].filter(Boolean),
      ] as CeldaMosaico[][]
    ).filter((grupo) => grupo.length > 0)
  : [];
---

{
  items.length > 0 && tablero && (
    <div
      data-slot="mosaico"
      data-modelo-vista={modelo}
      data-oculta={modelo ? '' : undefined}
      hidden={Boolean(modelo) && !activo}
      class:list={['tablero-caja', extra]}
    >
    <div class="tira tira-casilla mosaico-tablero grid gap-px" tabindex="0" role="group" aria-label="Rasgos del modelo">
      {grupos.map((grupo) => (
        <div class="flex flex-col gap-px" data-foto-arriba={esFoto(grupo[0]) ? '' : undefined}>
          {grupo.map((celda) => {
            if (esFoto(celda) && celda.imagen && celda.alt) {
              return (
                <div class="celda-foto relative min-h-64 flex-1 overflow-clip md:aspect-[4/5] md:max-h-[58svh] md:min-h-0 md:flex-none">
                  <Image
                    src={celda.imagen}
                    alt={celda.alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
              );
            }
            if (esTexto(celda)) {
              return (
                <div class="celda-texto flex min-h-[9.5rem] flex-col items-end justify-end bg-marca px-6 py-7 text-right text-white md:min-h-[11rem] md:px-8">
                  <p class="max-w-[14ch] font-display text-subtitulo font-semibold uppercase tracking-[0.08em]">
                    {celda.titulo ?? celda.texto}
                  </p>
                </div>
              );
            }
            return null;
          })}
        </div>
      ))}
      {/* Las columnas de la derecha alternan: texto arriba, foto arriba. En el
          DOM el texto va primero; `flex-col-reverse` sube la foto cuando toca. */}
      {columnasExtra.map((col, i) => (
        <div
          class:list={['flex gap-px', i % 2 === 1 ? 'flex-col-reverse' : 'flex-col']}
          data-foto-arriba={i % 2 === 1 ? '' : undefined}
        >
          <div class="celda-texto flex min-h-[9.5rem] flex-col items-end justify-end bg-marca px-6 py-7 text-right text-white md:min-h-[11rem] md:px-8">
            {col.cifra ? (
              <Fragment>
                <p class="tablero-cifra" style={`--letras: ${col.cifra.length}`}>{col.cifra}</p>
                {col.etiqueta && <p class="tablero-etiqueta">{col.etiqueta}</p>}
              </Fragment>
            ) : (
              <p class="max-w-[14ch] font-display text-subtitulo font-semibold uppercase tracking-[0.08em]">
                {col.titulo}
              </p>
            )}
          </div>
          <div
            class="celda-foto relative min-h-64 flex-1 overflow-clip md:aspect-[4/5] md:max-h-[58svh] md:min-h-0 md:flex-none"
            data-generada={col.generada ? 'true' : undefined}
          >
            <Image
              src={col.imagen}
              alt={col.alt}
              widths={[480, 800, 1200]}
              sizes="(min-width: 768px) 33vw, 86vw"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </div>
      ))}
    </div>
    {/* La línea es la barra de progreso del tablero: vive en la franja oscura de
        abajo y no dentro de una casilla, porque al llegar al final quedaba
        encima de una foto clara y dejaba de verse. */}
    <div class="tablero-linea" aria-hidden="true"><span></span></div>
    {/* LA PISTA DEL TABLERO. La pidió el cliente: tres columnas quietas no
        dicen que hay seis. Va en la franja oscura, frente a la línea, y se
        apaga en cuanto alguien mueve el tablero, igual que la pista de giro. */}
    <p class="aviso-tablero" aria-hidden="true">
      <span class="aviso-tactil">Desliza para ver más</span>
      <span class="aviso-mouse">Arrastra para ver más</span>
      <svg width="26" height="10" viewBox="0 0 26 10" fill="none">
        <path d="M0 5h24M20 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </p>
    </div>
  )
}

{
  items.length > 0 && !tablero && (
    <div
      data-slot="mosaico"
      data-modelo-vista={modelo}
      data-oculta={modelo ? '' : undefined}
      hidden={Boolean(modelo) && !activo}
      class:list={['tira tira-casilla grid gap-px bg-marca-clara/20', columnas, extra]}
    >
      {items.map((celda, i) => {
        const destacado = patron === 'destacado' && i === 0;
        const ancho = celda.ancho === 2 || destacado;
        const foto = esFoto(celda);
        const indiceFoto = items.slice(0, i).filter(esFoto).length;
        const indiceTexto = items.slice(0, i).filter(esTexto).length;
        const tramo =
          patron === 'trenzado'
            ? foto
              ? (FOTO_TRAMO[indiceFoto] ?? 'md:col-span-4 md:row-start-1')
              : (TEXTO_TRAMO[indiceTexto] ?? 'md:col-span-4 md:row-start-2')
            : ancho
              ? 'md:col-span-2'
              : undefined;
        const ancha = patron === 'trenzado' ? indiceFoto === 0 : Boolean(ancho);

        if (foto && celda.imagen && celda.alt) {
          return (
            <div class:list={['celda-foto overflow-clip', tramo]}>
              <Image
                src={celda.imagen}
                alt={celda.alt}
                widths={[480, 800, 1200]}
                sizes={
                  ancha
                    ? '(min-width: 768px) 42vw, 100vw'
                    : '(min-width: 768px) 28vw, 100vw'
                }
                class:list={[
                  'revela-imagen h-full min-h-56 w-full object-cover',
                  patron === 'trenzado'
                    ? 'md:min-h-[32rem] md:aspect-[4/3]'
                    : 'md:min-h-[22rem]',
                ]}
              />
            </div>
          );
        }
        if (celda.texto || celda.titulo) {
          return (
            <div
              class:list={[
                'celda-texto flex flex-col justify-center bg-marca px-5 py-6 text-white md:px-6 md:py-7',
                tramo,
              ]}
            >
              <p class="revela-titular font-display text-small font-semibold uppercase tracking-[0.08em]">
                {celda.titulo ?? celda.texto}
              </p>
              {
                celda.bajada && (
                  <p class="revela mt-2 text-small text-white/60">{celda.bajada}</p>
                )
              }
            </div>
          );
        }
        return null;
      })}
    </div>
  )
}

<style>
  /* El filete es marca-clara al 55 y no /20: sobre marca el 20% desaparece
     y el tablero se lee como un bloque único, sin casillas. */
  .mosaico-tablero {
    background: color-mix(in srgb, var(--color-marca-clara) 55%, transparent);
  }
  .mosaico-tablero > * {
    background: color-mix(in srgb, var(--color-marca-clara) 55%, transparent);
  }

  /* En tableta las tres columnas conservan su geometría, pero «inteligente»
     no cabe con la escala de escritorio. La letra depende del ancho útil. */
  .mosaico-tablero .celda-texto {
    container-type: inline-size;
  }
  .mosaico-tablero .celda-texto > p {
    font-size: min(var(--text-subtitulo), calc(100cqi / 11));
  }

  /* EL TABLERO COMO FILA. Tres columnas a la vista (una en móvil) y el resto a
     la derecha. Se agarra con el mouse, se desliza con el dedo o la rueda, y
     con foco responde a las flechas. El snap deja cada parada en el borde de
     una columna; mientras se arrastra se apaga para que no tire hacia atrás. */
  .tablero-caja {
    position: relative;
    padding-block-end: 2.75rem;
    /* La línea de tiempo de la entrada móvil vive aquí, FUERA del scroll
       horizontal. Con `view()` cada casilla medía su entrada contra el propio
       tablero, que ya la contiene entera, y en móvil nacía terminada. */
    view-timeline-name: --tablero-entrada;
    view-timeline-axis: block;
  }
  @media (width < 48rem) {
    .mosaico-tablero .celda-foto,
    .mosaico-tablero .celda-texto {
      animation-timeline: --tablero-entrada;
    }
  }
  .mosaico-tablero {
    /* Referencia de `offsetLeft` para el script. */
    position: relative;
    grid-auto-flow: column;
    grid-auto-columns: 86%;
    overflow-x: auto;
    /* `clip` y no `hidden`: ver el comentario de `.riel` en motion.css. */
    overflow-y: clip;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .mosaico-tablero::-webkit-scrollbar {
    display: none;
  }
  .mosaico-tablero > * {
    scroll-snap-align: start;
  }
  @media (width >= 48rem) {
    .mosaico-tablero {
      grid-auto-columns: calc((100% - 2px) / 3);
    }
  }
  @media (pointer: fine) {
    .tablero-caja:not([data-sin-recorrido]) .mosaico-tablero {
      cursor: grab;
    }
  }
  .mosaico-tablero.esta-arrastrando {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .mosaico-tablero img {
    -webkit-user-drag: none;
  }

  /* LA LÍNEA, DE VUELTA. Pista tenue y un tramo encendido que mide lo que se
     ve del tablero y se corre al avanzar. Alineada con el texto de las losas. */
  .tablero-linea {
    position: absolute;
    right: 1.5rem;
    bottom: 1.25rem;
    width: 7rem;
    height: 1px;
    background: color-mix(in srgb, var(--color-marca-clara) 55%, transparent);
  }
  .tablero-linea > span {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 33%;
    background: var(--color-marca-clara);
    /* Sólo `transform`: el ancho del tramo cambia al redimensionar o al cambiar
       de modelo, no al arrastrar, y animarlo recalcularía la maqueta. */
    transition: transform 160ms var(--ease-out);
  }
  .tablero-caja[data-sin-recorrido] .tablero-linea {
    display: none;
  }
  @media (width >= 48rem) {
    .tablero-linea {
      right: 2rem;
    }
  }

  /* El aviso comparte renglón con la línea, a la izquierda: la franja dice
     «hay más» y «cuánto falta» a la vez. Blanco y no `acento`, que es del CTA. */
  .aviso-tablero {
    position: absolute;
    left: 1.5rem;
    bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-size: var(--text-eyebrow);
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-white);
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
  }
  .aviso-tablero svg {
    animation: empujar-aviso 1.4s var(--ease-out) infinite;
  }
  @keyframes empujar-aviso {
    0%, 100% { transform: translateX(0); }
    50%      { transform: translateX(6px); }
  }
  .aviso-mouse {
    display: none;
  }
  @media (pointer: fine) {
    .aviso-tactil { display: none; }
    .aviso-mouse { display: inline; }
  }
  .tablero-caja[data-deslizado] .aviso-tablero,
  .tablero-caja[data-sin-recorrido] .aviso-tablero {
    opacity: 0;
  }
  .tablero-caja[data-deslizado] .aviso-tablero svg {
    animation: none;
  }
  @media (width >= 48rem) {
    .aviso-tablero {
      left: 2rem;
    }
  }
  /* Durante el amago el snap se apaga: si no, cada cuadro del scroll
     programado se acomodaría de vuelta en la columna y no se vería nada. */
  .mosaico-tablero.esta-amagando {
    scroll-snap-type: none;
  }

  /* LA LOSA DE CIFRA. La cifra no se parte («459–1.352 L» con la L sola en
     otra línea se leía rota): mide lo que cabe en la casilla según sus letras. */
  .mosaico-tablero .celda-texto > p.tablero-cifra {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    font-size: min(2.5rem, calc(100cqi / (var(--letras) * 0.92)));
  }
  .mosaico-tablero .celda-texto > p.tablero-etiqueta {
    margin-top: 0.9rem;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-marca-clara);
  }

  /* LA FOTO SE ABRE HACIA LA LOSA. Al pasar el mouse, la foto toma espacio de
     la losa negra de su columna: la losa baja de 11rem a 4.5rem y su texto se
     desvanece. La columna no cambia de alto, así que el resto del tablero no
     se mueve. Se anima el reparto de filas (`grid-template-rows`), no el alto
     de cada casilla. Sólo con puntero fino y desde 768 px: en táctil el primer
     toque ya es otro gesto, y mientras se arrastra no se abre nada. */
  @media (width >= 48rem) and (hover: hover) and (pointer: fine) {
    .tablero-caja {
      container-type: inline-size;
    }
    .mosaico-tablero {
      /* El mismo alto que daban la foto 4:5 (tope 58svh) y la losa de 11rem. */
      grid-template-rows: calc(11rem + 1px + min((100cqw - 2px) / 3 * 1.25, 58svh));
    }
    .mosaico-tablero > * {
      display: grid;
      grid-template-rows: 11rem 1fr;
      transition: grid-template-rows 520ms var(--ease-out);
    }
    .mosaico-tablero > [data-foto-arriba] {
      grid-template-rows: 1fr 11rem;
    }
    /* En las columnas nuevas el texto va primero en el DOM; la foto sube. */
    .mosaico-tablero > [data-foto-arriba] > .celda-foto {
      order: -1;
    }
    .mosaico-tablero .celda-foto {
      aspect-ratio: auto;
      max-height: none;
      min-height: 0;
    }
    .mosaico-tablero .celda-texto {
      min-height: 0;
      overflow: clip;
    }
    .mosaico-tablero .celda-texto > * {
      transition: opacity 220ms var(--ease-out);
    }
    .mosaico-tablero:not(.esta-arrastrando) > :has(> .celda-foto:hover) {
      grid-template-rows: 4.5rem 1fr;
    }
    .mosaico-tablero:not(.esta-arrastrando) > [data-foto-arriba]:has(> .celda-foto:hover) {
      grid-template-rows: 1fr 4.5rem;
    }
    .mosaico-tablero:not(.esta-arrastrando) > :has(> .celda-foto:hover) > .celda-texto > * {
      opacity: 0;
    }
  }

  /* Al cambiar de modelo el mosaico ya está en pantalla: view() no vuelve a
     disparar. El reloj recorre el mismo gesto que `.tira`, una vez. `.prende`
     cae en la caja del tablero; las columnas son hijas del tablero. */
  .prende .mosaico-tablero > * {
    animation: entrar-casilla 720ms var(--ease-out) both;
  }
  .prende .mosaico-tablero > *:nth-child(2) { animation-delay: 80ms; }
  .prende .mosaico-tablero > *:nth-child(3) { animation-delay: 160ms; }
  .prende .celda-foto,
  .prende .celda-texto {
    animation: entrar-casilla 720ms var(--ease-out) both;
  }
  .prende .mosaico-tablero > *:nth-child(1) .celda-foto,
  .prende .mosaico-tablero > *:nth-child(1) .celda-texto { animation-delay: 40ms; }
  .prende .mosaico-tablero > *:nth-child(2) .celda-foto,
  .prende .mosaico-tablero > *:nth-child(2) .celda-texto { animation-delay: 120ms; }
  .prende .mosaico-tablero > *:nth-child(3) .celda-foto,
  .prende .mosaico-tablero > *:nth-child(3) .celda-texto { animation-delay: 200ms; }
  .prende .revela-imagen {
    animation: revelar-imagen 980ms var(--ease-out) both;
  }
  .prende .revela-titular {
    animation: revelar-titular 720ms var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .prende .mosaico-tablero > *,
    .prende .celda-foto,
    .prende .celda-texto,
    .prende .revela-imagen,
    .prende .revela-titular {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
    .mosaico-tablero > *,
    .mosaico-tablero .celda-texto > *,
    .tablero-linea > span,
    .aviso-tablero {
      transition: none;
    }
    .aviso-tablero svg {
      animation: none;
    }
  }
</style>

<script>
  /* EL TABLERO SE ARRASTRA. El dedo, la rueda y las flechas ya mueven un
     contenedor con scroll; el mouse no: arrastrar encima sólo selecciona. Aquí
     se suman el arrastre, el acomodo en la columna más cercana al soltar y la
     línea que dice qué tramo del tablero se está viendo. Sin JS el tablero
     sigue desplazándose con la rueda y el dedo. */
  const reducido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const comportamiento = (): ScrollBehavior => (reducido() ? 'auto' : 'smooth');

  /* EL AMAGO. El cliente pidió que se note que el tablero sigue a la derecha:
     al entrar en pantalla la fila se corre un tramo y vuelve, como si alguien
     la empujara. Si nadie la toca, se repite cada `ESPERA` mientras siga a la
     vista y el mouse no esté encima; pasar el mouse por el tablero también la
     dispara, porque es justo cuando alguien lo está mirando. Hasta
     `AMAGOS_MAXIMOS` por tablero: una pista que no se calla nunca se vuelve
     ruido. Es JavaScript y no `animation-timeline` porque depende del tiempo,
     no del scroll, y porque mueve `scrollLeft`: un `transform` correría las
     casillas por encima del contenedor sin mover la línea de progreso. */
  const ESPERA = 7000;
  const AMAGOS_MAXIMOS = 4;
  const DURACION_IDA = 420;
  const DURACION_VUELTA = 560;
  // Quien ya movió un tablero aprendió el gesto para los tres modelos.
  let aprendido = false;
  const alAprender: Array<() => void> = [];
  const aprender = () => {
    if (aprendido) return;
    aprendido = true;
    alAprender.forEach((fn) => fn());
  };
  const salida = (t: number) => 1 - (1 - t) ** 3;
  const suave = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (-2 * t + 2) ** 3 / 2);

  document.querySelectorAll<HTMLElement>('.mosaico-tablero').forEach((tablero) => {
    const caja = tablero.closest<HTMLElement>('.tablero-caja');
    const linea = caja?.querySelector<HTMLElement>('.tablero-linea');
    const tramo = linea?.firstElementChild as HTMLElement | null;
    const recorrido = () => tablero.scrollWidth - tablero.clientWidth;

    const pintar = () => {
      const total = recorrido();
      caja?.toggleAttribute('data-sin-recorrido', total <= 1);
      if (!linea || !tramo || total <= 1) return;
      const ancho = linea.clientWidth * (tablero.clientWidth / tablero.scrollWidth);
      tramo.style.width = `${ancho}px`;
      tramo.style.transform = `translateX(${(linea.clientWidth - ancho) * (tablero.scrollLeft / total)}px)`;
    };

    // Paradas en el borde de cada columna. `offsetLeft` y no el rectángulo en
    // pantalla: la animación de entrada escala las casillas mientras corre.
    const cercana = () => {
      const tope = recorrido();
      const actual = tablero.scrollLeft;
      return Array.from(tablero.children, (col) => Math.min(tope, (col as HTMLElement).offsetLeft)).reduce(
        (mejor, p) => (Math.abs(p - actual) < Math.abs(mejor - actual) ? p : mejor),
        0,
      );
    };

    let inicioX = 0;
    let inicioScroll = 0;
    let apretado = false;
    let movio = false;
    tablero.addEventListener('pointerdown', (evento) => {
      // Cualquier toque, con dedo o mouse, enseña el gesto y corta el amago
      // donde vaya: el arrastre sigue desde ahí y el snap lo acomoda.
      aprender();
      if (evento.pointerType !== 'mouse' || evento.button !== 0 || caja?.hasAttribute('data-sin-recorrido')) return;
      apretado = true;
      movio = false;
      inicioX = evento.clientX;
      inicioScroll = tablero.scrollLeft;
    });
    tablero.addEventListener('pointermove', (evento) => {
      if (!apretado) return;
      // Soltó fuera antes de que el tablero capturara el puntero: no llegó
      // `pointerup`, pero el botón ya no está apretado. Sin esto, al volver a
      // pasar el mouse el tablero se movía solo.
      if ((evento.buttons & 1) === 0) {
        soltar();
        return;
      }
      const dx = evento.clientX - inicioX;
      // Cuatro píxeles de tolerancia: un clic con pulso tembloroso sigue siendo clic.
      if (!movio && Math.abs(dx) < 4) return;
      if (!movio) {
        movio = true;
        tablero.setPointerCapture(evento.pointerId);
        tablero.classList.add('esta-arrastrando');
      }
      tablero.scrollLeft = inicioScroll - dx;
    });
    const soltar = () => {
      if (!apretado) return;
      apretado = false;
      if (!movio) return;
      const destino = cercana();
      tablero.classList.remove('esta-arrastrando');
      tablero.scrollTo({ left: destino, behavior: comportamiento() });
    };
    tablero.addEventListener('pointerup', soltar);
    tablero.addEventListener('pointercancel', soltar);
    tablero.addEventListener('lostpointercapture', soltar);
    // La foto no se «agarra»: el navegador la arrastraría como archivo.
    tablero.addEventListener('dragstart', (evento) => evento.preventDefault());

    tablero.addEventListener('scroll', pintar, { passive: true });
    // Los tableros de los modelos inactivos nacen ocultos (0 px): al mostrarse
    // cambian de tamaño y el observador repinta la línea.
    new ResizeObserver(pintar).observe(tablero);
    pintar();

    if (!caja) return;
    let amagos = 0;
    let visible = false;
    let encima = false;
    let cuadro = 0;
    let reloj = 0;
    let ultimo = 0;

    const cortar = () => {
      cancelAnimationFrame(cuadro);
      cuadro = 0;
      tablero.classList.remove('esta-amagando');
    };
    const programar = (ms: number) => {
      clearTimeout(reloj);
      reloj = window.setTimeout(() => {
        // Con el mouse encima no se repite: el amago de hover ya habló.
        if (encima) programar(ESPERA);
        else amagar();
      }, ms);
    };
    const amagar = () => {
      if (
        aprendido ||
        cuadro ||
        !visible ||
        amagos >= AMAGOS_MAXIMOS ||
        reducido() ||
        caja.hasAttribute('data-sin-recorrido')
      )
        return;
      amagos += 1;
      const desde = tablero.scrollLeft;
      const columna = (tablero.firstElementChild as HTMLElement | null)?.offsetWidth ?? 0;
      // Un cuarto de columna: en 390 son unos 85 px y en escritorio unos 110.
      const tramo = Math.min(columna * 0.28, recorrido() - desde);
      const inicio = performance.now();
      tablero.classList.add('esta-amagando');
      const paso = (ahora: number) => {
        const t = ahora - inicio;
        const avance =
          t < DURACION_IDA
            ? salida(t / DURACION_IDA)
            : 1 - suave(Math.min(1, (t - DURACION_IDA) / DURACION_VUELTA));
        tablero.scrollLeft = desde + tramo * avance;
        if (t < DURACION_IDA + DURACION_VUELTA) {
          cuadro = requestAnimationFrame(paso);
          return;
        }
        cortar();
        ultimo = performance.now();
        if (amagos < AMAGOS_MAXIMOS) programar(ESPERA);
      };
      cuadro = requestAnimationFrame(paso);
    };

    alAprender.push(() => {
      cortar();
      clearTimeout(reloj);
      caja.toggleAttribute('data-deslizado', true);
    });
    // El dedo y el mouse ya avisan en `pointerdown`; faltan la rueda lateral
    // del trackpad y las flechas con el tablero enfocado.
    tablero.addEventListener(
      'wheel',
      (evento) => {
        if (Math.abs(evento.deltaX) > Math.abs(evento.deltaY)) aprender();
      },
      { passive: true },
    );
    tablero.addEventListener('keydown', (evento) => {
      if (evento.key.startsWith('Arrow') || evento.key === 'Home' || evento.key === 'End') aprender();
    });
    tablero.addEventListener('pointerenter', (evento) => {
      if (evento.pointerType !== 'mouse') return;
      encima = true;
      // Tres segundos desde el último: quien entra y sale no lo ve en bucle.
      if (performance.now() - ultimo > 3000) amagar();
    });
    tablero.addEventListener('pointerleave', () => {
      encima = false;
    });
    // Un observador y no `view()`: lo que dispara el amago es «ya está a la
    // vista», un instante, no un tramo del scroll. Los tableros de los modelos
    // inactivos nacen ocultos y entran aquí cuando se muestran.
    new IntersectionObserver(
      ([entrada]) => {
        visible = Boolean(entrada?.isIntersecting);
        if (visible) programar(amagos ? ESPERA : 900);
        else clearTimeout(reloj);
      },
      { threshold: 0.5 },
    ).observe(tablero);
  });
</script>
