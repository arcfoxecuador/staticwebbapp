---
/* En trenzado las fotos ocupan la fila alta y el copy una franja baja: el
   texto deja de competir en superficie. overflow-clip (no hidden) para que
   las fotos revelen. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type CeldaMosaico = {
  texto?: string;
  titulo?: string;
  bajada?: string;
  imagen?: ImageMetadata;
  alt?: string;
  ancho?: 1 | 2;
};

interface Props {
  items: CeldaMosaico[];
  patron?: 'trenzado' | 'destacado';
  class?: string;
  /** Identificador del modelo dueño de esta rejilla en la portada. */
  modelo?: string;
  activo?: boolean;
}

const { items, patron = 'trenzado', class: extra, modelo, activo = true } = Astro.props;

const FOTO_TRAMO = [
  'md:col-span-5 md:row-start-1',
  'md:col-span-4 md:row-start-1',
  'md:col-span-3 md:row-start-1',
] as const;
const TEXTO_TRAMO = [
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
] as const;
---

{
  items.length > 0 && (
    <div
      data-slot="mosaico"
      data-modelo-vista={modelo}
      data-oculta={modelo ? '' : undefined}
      hidden={Boolean(modelo) && !activo}
      class:list={[
        'tira grid gap-px bg-marca-clara/20',
        patron === 'trenzado' ? 'md:grid-cols-12' : 'md:grid-cols-3',
        extra,
      ]}
    >
      {items.map((celda, i) => {
        const destacado = patron === 'destacado' && i === 0;
        const ancho = celda.ancho === 2 || destacado;
        const esFoto = Boolean(celda.imagen && celda.alt);
        const indiceFoto = items.slice(0, i).filter((c) => c.imagen && c.alt).length;
        const indiceTexto = items.slice(0, i).filter((c) => !c.imagen && (c.texto || c.titulo)).length;
        const tramo =
          patron === 'trenzado'
            ? esFoto
              ? (FOTO_TRAMO[indiceFoto] ?? 'md:col-span-4 md:row-start-1')
              : (TEXTO_TRAMO[indiceTexto] ?? 'md:col-span-4 md:row-start-2')
            : ancho
              ? 'md:col-span-2'
              : undefined;
        const ancha = patron === 'trenzado' ? indiceFoto === 0 : Boolean(ancho);

        if (esFoto && celda.imagen && celda.alt) {
          return (
            <div class:list={['celda-foto overflow-clip', tramo]}>
              <Image
                src={celda.imagen}
                alt={celda.alt}
                widths={[480, 800, 1200]}
                sizes={ancha ? '(min-width: 768px) 42vw, 100vw' : '(min-width: 768px) 28vw, 100vw'}
                class:list={[
                  'revela-imagen h-full min-h-56 w-full object-cover',
                  patron === 'trenzado' ? 'md:min-h-[32rem] md:aspect-[4/3]' : 'md:min-h-[22rem]',
                ]}
              />
            </div>
          );
        }
        if (celda.texto || celda.titulo) {
          return (
            <div
              class:list={[
                'celda-texto flex flex-col justify-center bg-marca px-5 py-6 text-white md:px-6 md:py-7',
                tramo,
              ]}
            >
              <p class="revela-titular font-display text-small font-semibold uppercase tracking-[0.08em]">
                {celda.titulo ?? celda.texto}
              </p>
              {celda.bajada && <p class="revela mt-2 text-small text-white/60">{celda.bajada}</p>}
            </div>
          );
        }
        return null;
      })}
    </div>
  )
}

<style>
  /* Al cambiar de modelo el mosaico ya está en pantalla: view() no vuelve a
     disparar. El reloj recorre el mismo gesto que `.tira`, una vez. */
  .prende > * {
    animation: entrar-tira 720ms var(--ease-out) both;
  }
  .prende > *:nth-child(2) { animation-delay: 60ms; }
  .prende > *:nth-child(3) { animation-delay: 120ms; }
  .prende > *:nth-child(4) { animation-delay: 180ms; }
  .prende > *:nth-child(5) { animation-delay: 240ms; }
  .prende > *:nth-child(6) { animation-delay: 300ms; }
  .prende .revela-imagen {
    animation: revelar-imagen 980ms var(--ease-out) both;
  }
  .prende .revela-titular {
    animation: revelar-titular 720ms var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .prende > *,
    .prende .revela-imagen,
    .prende .revela-titular {
      animation: none;
    }
  }
</style>
