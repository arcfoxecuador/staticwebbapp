---
/* `tablero` es el look de portada: tres columnas donde la FOTO es la
   losa larga y el texto es la losa corta. Un 3×2 de casillas iguales
   aplasta esa jerarquía — la maqueta no reparte la altura a medias.
   `trenzado` queda para cuando el copy no puede competir en superficie.
   overflow-clip (no hidden) para que las fotos revelen. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type CeldaMosaico = {
  texto?: string;
  titulo?: string;
  bajada?: string;
  imagen?: ImageMetadata;
  alt?: string;
  ancho?: 1 | 2;
};

interface Props {
  items: CeldaMosaico[];
  patron?: 'trenzado' | 'destacado' | 'tablero';
  class?: string;
  /** Identificador del modelo dueño de esta rejilla en la portada. */
  modelo?: string;
  activo?: boolean;
}

const { items, patron = 'trenzado', class: extra, modelo, activo = true } = Astro.props;

const FOTO_TRAMO = [
  'md:col-span-5 md:row-start-1',
  'md:col-span-4 md:row-start-1',
  'md:col-span-3 md:row-start-1',
] as const;
const TEXTO_TRAMO = [
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
  'md:col-span-4 md:row-start-2',
] as const;

const columnas = patron === 'trenzado' ? 'md:grid-cols-12' : 'md:grid-cols-3';
const tablero = patron === 'tablero';

const esFoto = (celda: CeldaMosaico) => Boolean(celda.imagen && celda.alt);
const esTexto = (celda: CeldaMosaico) => Boolean(!celda.imagen && (celda.texto || celda.titulo));

const fotos = items.filter(esFoto);
const textos = items.filter(esTexto);
const ultimoTexto = textos.length - 1;

/* Columna 1: titular + foto baja. 2 y 3: foto alta + titular.
   Así la foto mide de más y el texto no se hincha al aspect de la foto. */
const grupos = tablero
  ? (
      [
        [textos[0], fotos[2]].filter(Boolean),
        [fotos[0], textos[1]].filter(Boolean),
        [fotos[1], textos[2]].filter(Boolean),
      ] as CeldaMosaico[][]
    ).filter((grupo) => grupo.length > 0)
  : [];
---

{
  items.length > 0 && tablero && (
    <div
      data-slot="mosaico"
      data-modelo-vista={modelo}
      data-oculta={modelo ? '' : undefined}
      hidden={Boolean(modelo) && !activo}
      class:list={['tira tira-casilla mosaico-tablero grid gap-px md:grid-cols-3', extra]}
    >
      {grupos.map((grupo) => (
        <div class="flex flex-col gap-px">
          {grupo.map((celda) => {
            const indiceTexto = textos.indexOf(celda);
            if (esFoto(celda) && celda.imagen && celda.alt) {
              return (
                <div class="celda-foto relative min-h-64 flex-1 overflow-clip md:min-h-[32rem] md:aspect-[3/4] md:flex-none">
                  <Image
                    src={celda.imagen}
                    alt={celda.alt}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 768px) 33vw, 100vw"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                </div>
              );
            }
            if (esTexto(celda)) {
              return (
                <div class="celda-texto flex min-h-[9.5rem] flex-col items-end justify-end bg-marca px-6 py-7 text-right text-white md:min-h-[11rem] md:px-8">
                  <p class="max-w-[14ch] font-display text-subtitulo font-semibold uppercase tracking-[0.08em]">
                    {celda.titulo ?? celda.texto}
                  </p>
                  {
                    indiceTexto === ultimoTexto && (
                      <span
                        class="relative mt-8 block h-px w-full max-w-[14ch] bg-marca-clara/55"
                        aria-hidden="true"
                      >
                        <span class="absolute inset-y-0 left-0 w-1/3 bg-marca-clara"></span>
                      </span>
                    )
                  }
                </div>
              );
            }
            return null;
          })}
        </div>
      ))}
    </div>
  )
}

{
  items.length > 0 && !tablero && (
    <div
      data-slot="mosaico"
      data-modelo-vista={modelo}
      data-oculta={modelo ? '' : undefined}
      hidden={Boolean(modelo) && !activo}
      class:list={['tira tira-casilla grid gap-px bg-marca-clara/20', columnas, extra]}
    >
      {items.map((celda, i) => {
        const destacado = patron === 'destacado' && i === 0;
        const ancho = celda.ancho === 2 || destacado;
        const foto = esFoto(celda);
        const indiceFoto = items.slice(0, i).filter(esFoto).length;
        const indiceTexto = items.slice(0, i).filter(esTexto).length;
        const tramo =
          patron === 'trenzado'
            ? foto
              ? (FOTO_TRAMO[indiceFoto] ?? 'md:col-span-4 md:row-start-1')
              : (TEXTO_TRAMO[indiceTexto] ?? 'md:col-span-4 md:row-start-2')
            : ancho
              ? 'md:col-span-2'
              : undefined;
        const ancha = patron === 'trenzado' ? indiceFoto === 0 : Boolean(ancho);

        if (foto && celda.imagen && celda.alt) {
          return (
            <div class:list={['celda-foto overflow-clip', tramo]}>
              <Image
                src={celda.imagen}
                alt={celda.alt}
                widths={[480, 800, 1200]}
                sizes={
                  ancha
                    ? '(min-width: 768px) 42vw, 100vw'
                    : '(min-width: 768px) 28vw, 100vw'
                }
                class:list={[
                  'revela-imagen h-full min-h-56 w-full object-cover',
                  patron === 'trenzado'
                    ? 'md:min-h-[32rem] md:aspect-[4/3]'
                    : 'md:min-h-[22rem]',
                ]}
              />
            </div>
          );
        }
        if (celda.texto || celda.titulo) {
          return (
            <div
              class:list={[
                'celda-texto flex flex-col justify-center bg-marca px-5 py-6 text-white md:px-6 md:py-7',
                tramo,
              ]}
            >
              <p class="revela-titular font-display text-small font-semibold uppercase tracking-[0.08em]">
                {celda.titulo ?? celda.texto}
              </p>
              {
                celda.bajada && (
                  <p class="revela mt-2 text-small text-white/60">{celda.bajada}</p>
                )
              }
            </div>
          );
        }
        return null;
      })}
    </div>
  )
}

<style>
  /* El filete es marca-clara al 55 y no /20: sobre marca el 20% desaparece
     y el tablero se lee como un bloque único, sin casillas. */
  .mosaico-tablero {
    background: color-mix(in srgb, var(--color-marca-clara) 55%, transparent);
  }
  .mosaico-tablero > * {
    background: color-mix(in srgb, var(--color-marca-clara) 55%, transparent);
  }

  /* Al cambiar de modelo el mosaico ya está en pantalla: view() no vuelve a
     disparar. El reloj recorre el mismo gesto que `.tira`, una vez. */
  .prende > * {
    animation: entrar-casilla 720ms var(--ease-out) both;
  }
  .prende > *:nth-child(2) { animation-delay: 80ms; }
  .prende > *:nth-child(3) { animation-delay: 160ms; }
  .prende .celda-foto,
  .prende .celda-texto {
    animation: entrar-casilla 720ms var(--ease-out) both;
  }
  .prende > *:nth-child(1) .celda-foto,
  .prende > *:nth-child(1) .celda-texto { animation-delay: 40ms; }
  .prende > *:nth-child(2) .celda-foto,
  .prende > *:nth-child(2) .celda-texto { animation-delay: 120ms; }
  .prende > *:nth-child(3) .celda-foto,
  .prende > *:nth-child(3) .celda-texto { animation-delay: 200ms; }
  .prende .revela-imagen {
    animation: revelar-imagen 980ms var(--ease-out) both;
  }
  .prende .revela-titular {
    animation: revelar-titular 720ms var(--ease-out) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .prende > *,
    .prende .celda-foto,
    .prende .celda-texto,
    .prende .revela-imagen,
    .prende .revela-titular {
      animation: none;
      opacity: 1;
      clip-path: none;
    }
  }
</style>
