---
/* La banda de cierre. Va al final de cada página y pide UNA cosa.

   Existe como bloque y no como marcado suelto porque es la pieza que más se
   copia-pega mal: acaba con un titular distinto en cada página, dos botones que
   compiten, o —lo más común— faltando justo en la página que más tráfico recibe.
   Una página sin cierre es una página que deja al visitante en un callejón.

   `imagen` + `<slot>` es el escenario fotográfico (un formulario sobre una
   foto). Sin slot, pinta los CTAs de siempre. Un bloque local sólo para
   cambiar el escenario era un bloque de más. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Boton from '../ui/Boton.astro';
import { CTA, ORG } from '../../lib/site';

interface Props {
  titulo?: string;
  bajada?: string;
  accion?: { texto: string; href: string };
  campo?: 'marca' | 'tinte';
  imagen?: ImageMetadata;
  alt?: string;
  id?: string;
}

const {
  titulo = '¿Hablamos?',
  bajada,
  accion = { texto: CTA.texto, href: CTA.href },
  campo = 'marca',
  imagen,
  alt,
  id,
} = Astro.props;

const oscuro = campo === 'marca';
const conSlot = Astro.slots.has('default');
---

<!-- `data-campo` no es decorativo: global.css lo lee para pegar el pie a este
     bloque cuando los dos comparten color de fondo. -->
<section
  data-slot="cierre"
  data-campo={campo}
  {id}
  class:list={[
    'relative isolate overflow-clip',
    oscuro ? 'bg-marca text-white campo-oscuro' : 'bg-tinte text-marca',
  ]}
>
  {
    imagen && alt && (
      <>
        <Image
          src={imagen}
          {alt}
          widths={[800, 1440, 1920]}
          sizes="100vw"
          class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
        />
        <div class="absolute inset-0 -z-10 bg-marca/55" aria-hidden="true"></div>
      </>
    )
  }
  <div class:list={['medida py-20 md:py-24', conSlot && 'max-w-xl']}>
    {
      !conSlot && (
        <>
          <div class="traza mb-8 w-full max-w-[120px]" aria-hidden="true"></div>
          <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
            <div>
              <h2 class="revela-titular max-w-[24ch] equilibra text-h2 font-bold">{titulo}</h2>
              {bajada && <p class="revela mt-4 max-w-[52ch] text-lead text-current/75">{bajada}</p>}
            </div>
            <div class="revela flex shrink-0 flex-col gap-3 sm:flex-row">
              <Boton href={accion.href} tamano="lg">{accion.texto}</Boton>
              {ORG.whatsapp && (
                <Boton
                  href={`https://wa.me/${ORG.whatsapp}`}
                  tamano="lg"
                  variante={oscuro ? 'fantasma' : 'secundario'}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  WhatsApp
                </Boton>
              )}
            </div>
          </div>
        </>
      )
    }
    {conSlot && <slot />}
  </div>
</section>
