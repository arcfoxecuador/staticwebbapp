---
/* La banda de cierre. Va al final de cada página y pide UNA cosa.

   Existe como bloque y no como marcado suelto porque es la pieza que más se
   copia-pega mal: acaba con un titular distinto en cada página, dos botones que
   compiten, o —lo más común— faltando justo en la página que más tráfico recibe.
   Una página sin cierre es una página que deja al visitante en un callejón.

   `imagen` + `<slot>` es el escenario fotográfico (un formulario sobre una
   foto). Sin slot, pinta los CTAs de siempre. Un bloque local sólo para
   cambiar el escenario era un bloque de más.

   La foto vive en un marco `sticky` del alto de la pantalla, no del bloque:
   el formulario de AYASA mide ~2.500 px y una foto `object-cover` estirada a
   ese alto se recorta hasta verse deformada (lo reportó el cliente el
   11-nov-2026). Así queda a su tamaño y acompaña el scroll del formulario. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Boton from '../ui/Boton.astro';
import { CTA, ORG } from '../../lib/site';

interface Props {
  titulo?: string;
  bajada?: string;
  accion?: { texto: string; href: string };
  campo?: 'marca' | 'tinte';
  imagen?: ImageMetadata;
  alt?: string;
  /** Un fondo por modelo en la portada. El activo se decide en la isla. */
  fondos?: { id: string; imagen: ImageMetadata; alt: string }[];
  id?: string;
  /** Dos losas: foto | ficha. El overlay a sangre no es el tablero. */
  tablero?: boolean;
}

const {
  titulo = '¿Hablamos?',
  bajada,
  accion = { texto: CTA.texto, href: CTA.href },
  campo = 'marca',
  imagen,
  alt,
  fondos = [],
  id,
  tablero = false,
} = Astro.props;

const capas = fondos.length > 0 ? fondos : imagen && alt ? [{ id: 'unico', imagen, alt }] : [];
const oscuro = campo === 'marca';
const conSlot = Astro.slots.has('default');
---

<!-- `data-campo` no es decorativo: global.css lo lee para pegar el pie a este
     bloque cuando los dos comparten color de fondo. -->
<section
  data-slot="cierre"
  data-campo={campo}
  {id}
  class:list={[
    'relative isolate overflow-clip',
    oscuro ? 'bg-marca text-white campo-oscuro' : 'bg-tinte text-marca',
    tablero && 'cierre-tablero',
  ]}
>
  {
    tablero ? (
      <div class="tira tira-casilla grid gap-px bg-marca-clara/20 md:grid-cols-2">
        <div class="relative min-h-[28rem] overflow-clip md:min-h-[40rem]">
          <div class="cierre-marco relative h-full min-h-[28rem] md:sticky md:top-0 md:h-[100svh] md:min-h-0">
            {capas.map((capa, indice) => (
              <Image
                src={capa.imagen}
                alt={capa.alt}
                widths={[800, 1440, 1920]}
                sizes="(min-width: 768px) 50vw, 100vw"
                data-modelo-vista={capa.id}
                data-activo={indice === 0 ? '' : undefined}
                class="cierre-fondo absolute inset-0 h-full w-full object-cover"
              />
            ))}
          </div>
        </div>
        <div class="flex flex-col justify-end bg-marca px-6 py-10 md:px-10 md:py-16">
          {conSlot && <slot />}
        </div>
      </div>
    ) : (
      <>
        {capas.length > 0 && (
          <>
            <div class="absolute inset-0 -z-10">
              <div class="sticky top-0 h-[100svh] max-h-full">
                {capas.map((capa, indice) => (
                  <Image
                    src={capa.imagen}
                    alt={capa.alt}
                    widths={[800, 1440, 1920]}
                    sizes="100vw"
                    data-modelo-vista={capa.id}
                    data-activo={indice === 0 ? '' : undefined}
                    class="cierre-fondo absolute inset-0 h-full w-full object-cover"
                  />
                ))}
              </div>
            </div>
            <div class="absolute inset-0 -z-10 bg-marca/55" aria-hidden="true"></div>
          </>
        )}
        <div class:list={['medida py-20 md:py-24', conSlot && 'max-w-xl']}>
          {
            !conSlot && (
              <>
                <div class="traza mb-8 w-full max-w-[120px]" aria-hidden="true"></div>
                <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
                  <div>
                    <h2 class="revela-titular max-w-[24ch] equilibra text-h2 font-bold">{titulo}</h2>
                    {bajada && <p class="revela mt-4 max-w-[52ch] text-lead text-current/75">{bajada}</p>}
                  </div>
                  <div class="revela flex shrink-0 flex-col gap-3 sm:flex-row">
                    <Boton href={accion.href} tamano="lg">{accion.texto}</Boton>
                    {ORG.whatsapp && (
                      <Boton
                        href={`https://wa.me/${ORG.whatsapp}`}
                        tamano="lg"
                        variante={oscuro ? 'fantasma' : 'secundario'}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        WhatsApp
                      </Boton>
                    )}
                  </div>
                </div>
              </>
            )
          }
          {conSlot && <slot />}
        </div>
      </>
    )
  }
</section>

<style>
  .cierre-fondo:not([data-activo]) {
    opacity: 0;
  }
  .cierre-fondo[data-activo] {
    opacity: 0.4;
  }
  /* En tablero la foto ES la losa: atenuarla 60% la deja sucia y
     destapa el hueco negro del vecino. */
  .cierre-tablero .cierre-fondo[data-activo] {
    opacity: 1;
  }
  .cierre-fondo {
    object-position: 50% 55%;
    transition: opacity 480ms var(--ease-out);
  }

  @media (width < 48rem) {
    .cierre-tablero .cierre-fondo[data-modelo-vista='t5'] {
      object-position: 28% 55%;
    }
    .cierre-tablero .cierre-fondo[data-modelo-vista='t1'] {
      object-position: 62% 60%;
    }
    .cierre-tablero .cierre-fondo[data-modelo-vista='s5'] {
      object-position: 58% 62%;
    }
  }
</style>
