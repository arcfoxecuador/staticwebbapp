---
/* EL FORMULARIO DE CONTACTO. Los campos que necesita la cotización y ni uno más.

   Funciona SIN JavaScript: es un `<form method="post">` de verdad contra el
   endpoint configurado, y sin JS el navegador hace el envío nativo y aterriza en
   `/gracias`. El script que hay abajo sólo MEJORA eso —envía por fetch y pinta el
   acuse sin recargar—, no lo habilita. Un formulario que sólo funciona si el JS
   carga es un formulario que a veces no funciona.

   Tres decisiones que parecen detalles y no lo son:

   · `autocomplete` en cada campo. El navegador rellena nombre, correo y teléfono
     de un tirón, y en móvil eso es la diferencia entre enviar y abandonar.
   · `inputmode` y `type` correctos. `type="tel"` saca el teclado numérico;
     `type="email"` valida sin una línea de JS.
   · La validación se apoya en `:user-invalid` y no en `:invalid`. `:invalid`
     marca en rojo un campo vacío que nadie ha tocado todavía — regaña antes de
     que el visitante haya hecho nada.

   ANTI-SPAM SIN CAPTCHA: campo trampa oculto para lectores de máquina más un
   sello de tiempo. Un bot rellena todo y envía en menos de tres segundos; un
   humano no. Ninguna de las dos cosas pide nada al visitante, que es la razón
   por la que no hay un captcha aquí: el captcha lo paga quien sí es humano. */
import Boton from '../ui/Boton.astro';
import { AVISO_DATOS, FORMULARIO, FORMULARIO_COTIZACION, LEGAL, ORG } from '../../lib/site';

interface Props {
  titulo?: string;
  bajada?: string;
  /** Se envía como campo oculto: sirve para saber DESDE QUÉ página escribió
      alguien sin tener que mirar el referer. */
  origen?: string;
  /** Sin la columna de correo/teléfono: el look de Cotízalo es sólo la ficha. */
  compacto?: boolean;
  /** El texto arriba y el formulario a todo el ancho debajo, en vez de dos
      columnas. Para el test drive de AYASA: su calendario de horarios necesita
      ancho, y en la columna derecha (≈600 px) los botones de hora quedan
      estrechos y el texto toca el borde. */
  apilado?: boolean;
  /** Qué aviso de datos lleva al pie. Test drive pide datos sensibles y legal
      redactó uno propio; el resto usa el general. */
  aviso?: 'general' | 'pruebaManejo';
  /** Texto del botón de envío. Cada página lo nombra por lo que pide. */
  boton?: string;
  /** El acuse tras enviar. Test drive tiene el suyo; el resto, el compartido. */
  confirmacion?: string;
  /** La página a la que se va tras un envío correcto. Cada formulario tiene la
      suya porque la conversión se marca por URL. */
  gracias?: string;
  /** Pinta el formulario de cotización de AYASA en vez del nuestro. Ver
      `FORMULARIO_COTIZACION` en site.ts. */
  cotizacion?: boolean;
  /** Qué formulario de AYASA se pinta con `cotizacion`. Test drive pasa el
      suyo (`FORMULARIO_PRUEBA`). */
  externo?: { url: string; origen: string; titulo: string };
}

const {
  titulo = 'Cotízalo',
  bajada,
  origen = Astro.url.pathname,
  compacto = false,
  apilado = false,
  aviso = 'general',
  boton = 'Solicitar cotización',
  confirmacion = FORMULARIO.confirmacion,
  cotizacion = false,
  gracias = FORMULARIO.gracias,
  externo = FORMULARIO_COTIZACION,
} = Astro.props;
const textoAviso = AVISO_DATOS[aviso];

/* Sin webhook todavía el POST nativo cae al correo. Es peor que un CRM, y
   mejor que un formulario que no se pinta: el look aprobado cierra con esta
   ficha y no podemos esperar al endpoint para que la página tenga conversión. */
const destino = FORMULARIO.endpoint || `mailto:${ORG.email}`;

const modelos = [
  { valor: 't1', etiqueta: 'ARCFOX T1' },
  { valor: 't5', etiqueta: 'ARCFOX T5' },
  { valor: 's5', etiqueta: 'ARCFOX S5' },
];
---

{
  cotizacion || destino ? (
    <div
      data-slot="formulario"
      class:list={[
        compacto ? 'grid gap-8' : apilado ? 'grid gap-12' : 'grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-20',
      ]}
    >
      <div>
        <h2
          class:list={[
            'revela-titular equilibra font-display text-h2 font-semibold uppercase tracking-[0.14em]',
            compacto ? 'text-white' : 'text-marca',
          ]}
        >
          {titulo}
        </h2>
        {bajada && (
          <p class:list={['revela mt-4 max-w-[46ch] text-lead', compacto ? 'text-white/75' : 'text-tinta/75']}>
            {bajada}
          </p>
        )}

        {
          !compacto && (
            <dl class="revela mt-10 flex flex-col gap-4 text-small">
              <div>
                <dt class="text-tinta/55">Correo</dt>
                <dd class="mt-1">
                  <a href={`mailto:${ORG.email}`} class="enlace-subrayado inline-flex min-h-11 items-center text-marca">
                    {ORG.email}
                  </a>
                </dd>
              </div>
              {(ORG.telefono || ORG.telefonoLegible) && (
                <div>
                  <dt class="text-tinta/55">Teléfono</dt>
                  <dd class="mt-1">
                    {ORG.telefono ? (
                      <a href={`tel:${ORG.telefono}`} class="enlace-subrayado inline-flex min-h-11 items-center text-marca">
                        {ORG.telefonoLegible}
                      </a>
                    ) : (
                      <span class="text-marca">{ORG.telefonoLegible}</span>
                    )}
                  </dd>
                </div>
              )}
            </dl>
          )
        }
      </div>

      {cotizacion ? (
        <div
          class:list={['revela cotizacion-externa', apilado && 'cotizacion-externa--apilada']}
          data-origen={externo.origen}
          data-gracias={gracias}
        >
          {/* `loading="lazy"`: el portal pesa y pone sus propias cookies; que
              no cargue hasta que el visitante llegue al bloque. */}
          <iframe
            src={externo.url}
            title={externo.titulo}
            loading="lazy"
            class="block w-full border border-linea bg-superficie"
          ></iframe>
          <p class:list={['mt-3 text-small', compacto ? 'text-white/75' : 'text-tinta/70']}>
            ¿No ves el formulario?{' '}
            <a
              href={externo.url}
              target="_blank"
              rel="noopener"
              class:list={['enlace-subrayado', compacto ? 'text-white' : 'text-marca']}
            >
              Ábrelo en una pestaña nueva
            </a>
          </p>
        </div>
      ) : (
      <form
        class="revela campo-claro border border-linea bg-superficie p-6 md:p-9"
        method="post"
        action={destino}
        data-gracias={gracias}
        data-correo={ORG.email}
        data-confirmacion={confirmacion}
        data-error={FORMULARIO.error}
      >
        <input type="hidden" name="origen" value={origen} />
        {/* El sello de tiempo lo escribe el script al cargar. Sin JS se queda
            vacío y el endpoint no puede aplicar la regla de los tres segundos —
            correcto: mejor aceptar un envío sin comprobar que descartar a alguien
            que navega sin JavaScript. */}
        <input type="hidden" name="sello" value="" />

        {/* El campo trampa. `aria-hidden` + `tabindex="-1"` lo saca del alcance de
            un lector de pantalla y del tabulador; el CSS lo saca de la vista sin
            `display: none`, que es lo primero que detecta un bot decente. */}
        <div class="trampa" aria-hidden="true">
          <label>
            No rellenar
            <input type="text" name={FORMULARIO.trampa} tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="flex flex-col gap-5">
          <label class="flex flex-col gap-2">
            <span class="text-small font-medium text-marca">Nombre y apellido</span>
            <input
              type="text"
              name="nombre"
              required
              autocomplete="name"
              class="campo"
              placeholder="Tu nombre"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-small font-medium text-marca">Celular</span>
            <input
              type="tel"
              name="telefono"
              required
              autocomplete="tel"
              inputmode="tel"
              class="campo"
              placeholder="09…"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-small font-medium text-marca">Correo electrónico</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              inputmode="email"
              class="campo"
              placeholder="tu@correo.com"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-small font-medium text-marca">Ciudad</span>
            <input
              type="text"
              name="ciudad"
              required
              autocomplete="address-level2"
              class="campo"
              placeholder="Quito, Guayaquil…"
            />
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-small font-medium text-marca">Mensaje</span>
            <textarea
              name="mensaje"
              rows="3"
              class="campo"
              placeholder="Cuéntanos cómo podemos ayudarte."
            ></textarea>
          </label>

          <label class="flex flex-col gap-2">
            <span class="text-small font-medium text-marca">¿Qué modelo te interesa?</span>
            <select name="modelo" required class="campo">
              <option value="" disabled selected>Elige un modelo</option>
              {modelos.map((m) => <option value={m.valor}>{m.etiqueta}</option>)}
            </select>
          </label>
        </div>

        {/* El aviso va AL PIE y ENTERO, a la vista, como en la imagen que
            adjuntó legal: plegado tras un «ver más» o metido en una caja con
            scroll, la aceptación deja de ser informada. */}
        <section
          class="aviso-datos mt-7 border border-linea bg-fondo p-4 text-small text-tinta/75"
          aria-labelledby={`aviso-${origen}`}
        >
          <h3 id={`aviso-${origen}`} class="font-medium text-marca">{AVISO_DATOS.titulo}</h3>
          <p class="mt-2">{textoAviso.responsables}</p>
          <p class="mt-2">
            {textoAviso.finalidades} <strong class="font-semibold text-tinta">{AVISO_DATOS.masInformacion}</strong>
          </p>
          <p class="mt-2">
            {AVISO_DATOS.derechos}{' '}
            <a href={`mailto:${AVISO_DATOS.correo}`} class="enlace-subrayado text-marca">{AVISO_DATOS.correo}</a>
          </p>
          <h4 class="mt-3 font-medium text-marca">{AVISO_DATOS.tituloConsentimiento}</h4>
          <p class="mt-2">{textoAviso.consentimiento}</p>
        </section>

        {/* SIN `checked`, nunca: la aceptación la da el titular con su clic.
            `required` hace que el navegador no envíe sin ella, con o sin JS. */}
        <label class="mt-4 flex items-start gap-3 text-small text-tinta">
          <input type="checkbox" name="acepta_datos" value="si" required class="casilla" />
          <span>
            {AVISO_DATOS.casilla}{' '}
            {LEGAL.privacidad ? (
              <a href={LEGAL.privacidad} class="enlace-subrayado text-marca">{AVISO_DATOS.casillaEnlace}</a>
            ) : (
              AVISO_DATOS.casillaEnlace
            )}
          </span>
        </label>

        <div class="mt-7 flex flex-col gap-4">
          <Boton tipo="submit" tamano="lg" class="w-full justify-center">{boton}</Boton>
          {/* `aria-live="polite"` y no `assertive`: el acuse no es una alarma. Y
              vive FUERA del bloque que se oculta al enviar, porque una región
              viva que aparece de la nada a veces no se anuncia. */}
          <p class="acuse text-small" role="status" aria-live="polite"></p>
        </div>
      </form>
      )}
    </div>
  ) : null
}

<style>
  /* Los campos se estilan aquí y no con utilidades repetidas: son controles con
     exactamente el mismo aspecto, y la variante que se olvida
     de una utilidad es el defecto clásico de un formulario. */
  .campo {
    width: 100%;
    /* 44px de alto mínimo (WCAG 2.5.8) y 16px de letra: por debajo de 16px iOS
       hace zoom al enfocar el campo y descuadra la página entera. */
    min-height: 44px;
    padding: 11px 14px;
    font-size: 1rem;
    font-family: inherit;
    color: var(--color-tinta);
    background: var(--color-fondo);
    border: 1px solid var(--color-linea);
    border-radius: 0;
    transition: border-color 180ms var(--ease-out);
  }
  .campo::placeholder {
    color: color-mix(in srgb, var(--color-tinta) 45%, transparent);
  }
  .campo:hover {
    border-color: color-mix(in srgb, var(--color-marca) 40%, var(--color-linea));
  }
  /* `:user-invalid` sólo marca lo que el visitante ya ha tocado o intentado
     enviar. `:invalid` marcaría en rojo un formulario recién cargado. */
  .campo:user-invalid {
    /* La paleta está cerrada: un rojo suelto sería un décimo token. */
    border-color: var(--color-marca);
  }

  /* Fuera de la vista sin `display: none` ni `visibility: hidden`: los dos son la
     primera señal que busca un bot para saber qué campo saltarse. */
  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: clip;
  }

  /* 20px y no el cuadradito de 13px por defecto: es la única casilla del
     formulario y la que más cuesta acertar con el dedo. */
  .casilla {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    accent-color: var(--color-marca);
  }

  /* Alto medido con el formulario de AYASA desplegado (todas las preguntas
     condicionales abiertas): 2.050 px en marcos anchos y hasta 2.450 en los
     intermedios, donde sus columnas se apilan. Si algún día crece, el marco
     hace scroll por dentro en vez de cortarlo. */
  .cotizacion-externa {
    container-type: inline-size;
  }
  .cotizacion-externa iframe {
    height: 2500px;
  }
  @container (max-width: 560px) {
    .cotizacion-externa iframe {
      height: 2300px;
    }
  }
  @container (min-width: 900px) {
    .cotizacion-externa iframe {
      height: 2150px;
    }
  }

  /* El test drive de AYASA a todo el ancho mide ≈1.880 px (medido a 1.280 de
     ventana el 24-nov-2026); con 2.150 quedaba un hueco en blanco bajo «Enviar». */
  @container (min-width: 900px) {
    .cotizacion-externa--apilada iframe {
      height: 1950px;
    }
  }

  .acuse:empty {
    display: none;
  }
  .acuse[data-estado='ok'] {
    color: var(--color-marca);
  }
  .acuse[data-estado='error'] {
    color: var(--color-marca);
  }
</style>

<script>
  /* Mejora progresiva, no requisito. El formulario ya funciona sin esto.

     Va sin `is:inline` para que Astro lo procese y lo agrupe, y SIN condicional
     alrededor: un <script> escrito dentro de `{condición && (…)}` lo parsea Astro
     como JSX y acaba en el HTML como una CADENA de texto que nunca se ejecuta.
     Es un fallo silencioso —el marcado se ve perfecto— y por eso hay un
     verificador en `npm run check` que lo busca en `dist/`. */
  const formularios = document.querySelectorAll<HTMLFormElement>('form[data-gracias]');

  formularios.forEach((form) => {
    const sello = form.querySelector<HTMLInputElement>('input[name="sello"]');
    if (sello) sello.value = String(Date.now());

    const acuse = form.querySelector<HTMLElement>('.acuse');
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (evento) => {
      if (!form.reportValidity()) return;
      evento.preventDefault();

      /* `aria-busy` y no `disabled`: un botón deshabilitado PIERDE EL FOCO, y
         quien navega con teclado se queda sin saber dónde está. Con aria-busy el
         botón sigue enfocable y anuncia que está trabajando. */
      boton?.setAttribute('aria-busy', 'true');
      if (acuse) {
        acuse.textContent = 'Enviando…';
        acuse.removeAttribute('data-estado');
      }

      try {
        const respuesta = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!respuesta.ok) throw new Error(String(respuesta.status));

        form.reset();
        if (acuse) {
          acuse.textContent = form.dataset.confirmacion ?? '';
          acuse.dataset.estado = 'ok';
        }
        /* A la página de gracias de ESTE formulario: la conversión se marca por
           URL. El acuse de arriba queda por si la navegación tarda. */
        if (form.dataset.gracias) window.location.assign(form.dataset.gracias);
      } catch {
        /* El mensaje de error DA UNA SALIDA. «Ha ocurrido un error» deja al
           visitante sin nada que hacer con la información. */
        if (acuse) {
          acuse.textContent = form.dataset.error ?? '';
          acuse.dataset.estado = 'error';
        }
      } finally {
        boton?.removeAttribute('aria-busy');
      }
    });
  });

  /* La cotización de AYASA avisa del envío con un postMessage y deja la
     navegación a esta página (ver `FORMULARIO_COTIZACION` en site.ts). Se acepta
     sólo si viene de SU origen y de uno de NUESTROS iframes, y se va siempre a
     nuestra página de gracias (la de ese bloque: test drive tiene la suya):
     la URL del mensaje no se usa nunca. */
  const marcos = [...document.querySelectorAll<HTMLElement>('.cotizacion-externa[data-origen]')];
  if (marcos.length) {
    window.addEventListener('message', (evento) => {
      const marco = marcos.find(
        (m) => m.querySelector('iframe')?.contentWindow === evento.source,
      );
      if (!marco || evento.origin !== marco.dataset.origen) return;
      const datos = evento.data as { type?: unknown } | null;
      if (datos?.type !== 'redirect') return;
      window.location.assign(marco.dataset.gracias ?? '/gracias');
    });
  }
</script>
