---
/* Pieza destacada de un catálogo: una foto grande, un nombre, un enlace y
   los datos que sí se pueden afirmar. No hardcodea producto —la página le
   pasa la entrada— porque una vitrina cableada a un slug es la que se
   olvida el día que el catálogo cambia de orden. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  nombre: string;
  href: string;
  imagen: ImageMetadata;
  alt: string;
  detalle?: string;
  datos?: { valor: string; etiqueta: string }[];
  class?: string;
}

const { nombre, href, imagen, alt, detalle, datos = [], class: extra } = Astro.props;
---

<div data-slot="vitrina" class:list={['revela', extra]}>
  <div class="flex items-center justify-between gap-4">
    <h2 class="font-display text-h2 font-semibold text-marca">{nombre}</h2>
    <a href={href} class="text-small uppercase tracking-[0.14em] text-marca/70 hover:text-marca">
      Ver ficha →
    </a>
  </div>

  <div class="mt-10">
    <Image
      src={imagen}
      {alt}
      widths={[640, 1024, 1440]}
      sizes="(min-width: 1024px) 70vw, 100vw"
      class="mx-auto h-auto max-h-[420px] w-full object-contain"
    />
    {detalle && (
      <p class="mt-8 text-center text-eyebrow uppercase tracking-[0.16em] text-tinta/55">{detalle}</p>
    )}
  </div>

  {
    datos.length > 0 && (
      <dl class="mt-12 grid grid-cols-2 gap-8 border-t border-linea pt-8 md:grid-cols-4">
        {datos.map((d) => (
          <div>
            <dt class="text-eyebrow uppercase tracking-[0.16em] text-tinta/50">{d.etiqueta}</dt>
            <dd class="mt-2 font-display text-stat font-semibold text-marca">{d.valor}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>
