---
/* El lanzador flotante del asistente conversacional (ioZen u otro embed).

   ES LA ÚNICA SOMBRA DEL SITIO, y la excepción está declarada en `site.ts`. El
   resto de la elevación se hace con el escalón de luminancia entre el suelo y el
   blanco; esto sí flota de verdad sobre el contenido, así que puede decirlo.

   Sin JavaScript: es un `<details>`. Y eso trae gratis lo que más importa aquí —
   el iframe está dentro de un subárbol con `display: none` mientras el panel está
   cerrado, así que EL PROVEEDOR NO SE CARGA hasta que alguien lo abre. Un embed
   de chat cargado en cada visita son cientos de kB y un tercero en la ruta
   crítica de todas las páginas, para una herramienta que usa una fracción de los
   visitantes.

   `.lanzador` lleva `view-transition-name` desde motion.css: sin él, un elemento
   fijo que aparece en el mismo píxel de todas las páginas parpadea en cada
   navegación.

   EL FILETE BLANCO DEL LANZADOR es lo que lo hace un control y no un glifo
   flotando: sobre campo oscuro, un disco `marca` es del color del fondo y su
   sombra —negra— tampoco dibuja un borde, así que el botón sale a 1,0:1 contra
   su propia página. `white/45` da ~4,5:1 sobre `marca`, por encima del 3:1 que
   WCAG 1.4.11 pide para el límite de un componente. Sobre superficie clara el
   filete cae DENTRO del disco negro y no se nota. */
import { ASISTENTE } from '../../lib/site';

/* LAS TRES PROPS SON OPCIONALES Y CAEN A `ASISTENTE`, y esa caída es la razón de
   que existan: la landing de expectativa necesita SU chat encendido —otro
   embed, otro nombre— mientras el del sitio principal sigue apagado. Sin props,
   la única forma de encenderlo allí sería girar `ASISTENTE.activo`, que lo
   montaría en las once páginas del catálogo a la vez.

   Quien no pase nada sigue leyendo `site.ts`, que es lo que hace `Base.astro`. */
interface Props {
  /** URL del iframe del proveedor. Vacía = el panel no carga nada. */
  embed?: string;
  nombre?: string;
  etiqueta?: string;
}

const {
  embed = ASISTENTE.embed,
  nombre = ASISTENTE.nombre,
  etiqueta = ASISTENTE.etiqueta,
} = Astro.props;

if (!embed) {
  /* Un aviso en construcción y no un fallo: montar el asistente sin URL es un
     descuido de configuración, y romper el build por eso dejaría el sitio caído
     por un chat. Pero en silencio nadie se enteraría de que el botón no abre
     nada. */
  console.warn('[asistente] el asistente se montó sin embed: revisa ASISTENTE.embed o la prop');
}
---

<details class="lanzador fixed bottom-5 right-5 z-40 print:hidden">
  <summary
    class="flex min-h-[56px] min-w-[56px] cursor-pointer list-none items-center justify-center rounded-[var(--radius-pill)] border border-white/45 bg-marca text-white shadow-[0_8px_28px_rgb(0_0_0_/_0.18)]"
    aria-label={etiqueta}
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </summary>

  <div
    class="absolute bottom-[72px] right-0 w-[min(380px,calc(100vw-2.5rem))] overflow-clip rounded-[var(--radius-lg)] border border-linea bg-superficie shadow-[0_12px_40px_rgb(0_0_0_/_0.18)]"
  >
    <div class="flex items-center justify-between border-b border-linea px-4 py-3">
      <span class="text-small font-semibold text-marca">{nombre}</span>
    </div>
    {
      embed && (
        <iframe
          src={embed}
          title={nombre}
          loading="lazy"
          class="h-[520px] w-full border-0"
        />
      )
    }
  </div>
</details>
