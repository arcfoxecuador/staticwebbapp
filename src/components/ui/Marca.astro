---
/* La marca. Se monta DOS veces por documento —cabecera y pie—, y ese hecho tiene
   una consecuencia que hay que conocer antes de tocarlo: NO se le puede poner
   `view-transition-name`. Un nombre duplicado hace que Chrome ABORTE la
   transición de página entera, no sólo la de este elemento.

   El lockup oficial es un PNG de 192×28: en cualquier pantalla 2× se lee
   pixelado y las orejas del zorro tocan el borde del lienzo, así que un
   `object-cover` o un redondeo de subpíxel se las come. El sello de 700 px
   sí es material de imprenta; el wordmark se escribe con Eurostile, que es
   la misma familia del brandbook. Recolorear el PNG con filtros deforma
   el trazo y rompe el área de seguridad. */
import { ORG } from '../../lib/site';

interface Props {
  /** En campo oscuro la marca va en blanco. */
  tono?: 'marca' | 'blanco';
  /** La marca del pie no es un enlace a la misma página en la que estás. */
  enlace?: boolean;
  /** Sólo el sello. En el héroe de portada el wordmark del auto ya está en
      la foto: repetir ARCFOX entero es el logo doble. */
  soloSello?: boolean;
  class?: string;
}

const { tono = 'marca', enlace = true, soloSello = false, class: extra } = Astro.props;

const src = tono === 'blanco' ? '/marca/sello-blanco.png' : '/marca/sello.png';
const Etiqueta = enlace ? 'a' : 'span';
---

<Etiqueta
  data-slot="marca"
  href={enlace ? '/' : undefined}
  aria-label={enlace ? `${ORG.nombreCorto} — ir a la portada` : undefined}
  class:list={[
    'marca inline-flex items-center gap-1.5 no-underline',
    enlace && 'marca-enlace',
    tono === 'blanco' ? 'text-white' : 'text-marca',
    extra,
  ]}
>
  <img
    src={src}
    alt={ORG.nombreCorto}
    height="64"
    width="64"
    class="marca-sello h-7 w-7 object-contain"
  />
  {
    !soloSello && (
      <span class="marca-wordmark" aria-hidden="true">
        {ORG.nombreCorto}
      </span>
    )
  }
</Etiqueta>

<style>
  /* El sello puede medir 22 px; el toque no. Agrandar el PNG deforma el
     lockup y come las orejas: la caja crece, el dibujo no. */
  .marca-enlace {
    min-height: 44px;
    min-width: 44px;
  }

  .marca-wordmark {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  @media (width < 48rem) {
    .marca {
      gap: 0.4rem;
    }
    .marca-sello {
      height: 1.35rem;
      width: 1.35rem;
    }
    .marca-wordmark {
      font-size: 0.82rem;
      letter-spacing: 0.14em;
    }
  }
</style>
