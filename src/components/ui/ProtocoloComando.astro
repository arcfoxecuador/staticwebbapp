---
/* LA PUERTA. Una sola pregunta y una sola respuesta ocupan la paleta; nunca se
   construye un historial de chat. Al terminar, `respuestas` sale por POST al
   endpoint de `PROTOCOLO` —la hoja de cálculo, vía Apps Script— y además se
   emite `protocolo:completo`, que es el punto de enganche para ioZen o para
   analítica sin tocar esta interfaz.

   Sin endpoint configurado el flujo funciona igual pero NO dice «registrado»:
   ver `finalizar()`. Prometer un registro que no ha ocurrido es peor que no
   tener formulario, porque nadie se entera de que se está perdiendo gente. */
import Boton from './Boton.astro';
import { ORG, PROTOCOLO } from '../../lib/site';

interface Props {
  rotulo?: string;
  modo?: 'integrado' | 'flotante';
}

const { rotulo = 'Continuar', modo = 'flotante' } = Astro.props;

const protocolo = [
  {
    clave: 'busqueda',
    pregunta: '¿Qué buscas en tu próximo vehículo?',
    opciones: [
      'Tecnología que sorprenda',
      'Diseño que destaque',
      'Confort para todos los días',
      'Rendimiento',
      'No estoy buscando vehículo por ahora',
    ],
  },
  {
    clave: 'momento',
    pregunta: '¿Cuál describe mejor tu momento?',
    opciones: [
      'Estoy pensando cambiar de auto este año.',
      'Tal vez el próximo año.',
      'Solo estoy explorando cosas nuevas.',
    ],
  },
  {
    clave: 'novedad',
    pregunta: 'Cuando ves algo nuevo...',
    opciones: ['Quiero ser de los primeros en probarlo.', 'Espero opiniones antes.', 'Prefiero lo conocido.'],
  },
  {
    clave: 'experiencias',
    pregunta: '¿Qué tipo de experiencias disfrutas más?',
    opciones: [
      'Eventos privados.',
      'Lanzamientos.',
      'Experiencias gastronómicas.',
      'Tecnología e innovación.',
      'Música.',
    ],
  },
  {
    clave: 'tecnologia',
    pregunta: '¿Qué tipo de tecnología optarías en tu próximo auto?',
    opciones: ['Híbrido, eléctrico', 'Combustión', 'Aún no lo decido'],
  },
  {
    clave: 'ciudad',
    pregunta: '¿En qué ciudad estás?',
    opciones: ['Quito', 'Guayaquil', 'Cuenca', 'Otra'],
  },
  {
    clave: 'nombre',
    pregunta: 'Danos tu usuario de Instagram y número de WhatsApp para enviar tu invitación',
    tipo: 'text',
    autocomplete: 'name',
    placeholder: 'Nombre',
  },
  {
    clave: 'correo',
    pregunta: 'Danos tu usuario de Instagram y número de WhatsApp para enviar tu invitación',
    tipo: 'email',
    autocomplete: 'email',
    placeholder: 'Correo',
  },
  {
    clave: 'whatsapp',
    pregunta: 'Danos tu usuario de Instagram y número de WhatsApp para enviar tu invitación',
    tipo: 'tel',
    autocomplete: 'tel',
    placeholder: 'WhatsApp',
  },
  {
    clave: 'instagram',
    pregunta: 'Danos tu usuario de Instagram y número de WhatsApp para enviar tu invitación',
    tipo: 'text',
    placeholder: 'Usuario de Instagram',
  },
] as const;
---

<div class="comando" data-protocolo-comando data-modo={modo}>
  {
    modo === 'flotante' && (
      <Boton
        variante="fantasma"
        class="puerta-cta"
        tipo="button"
        data-abrir-comando
        aria-expanded="false"
        aria-controls="protocolo-flotante"
      >
        {rotulo}
      </Boton>
    )
  }

  <div
    id={modo === 'flotante' ? 'protocolo-flotante' : undefined}
    class:list={['comando-superficie', modo]}
    hidden={modo === 'flotante'}
    aria-label="Protocolo para solicitar una invitación"
  >
    <form
      class="comando-panel"
      data-endpoint={PROTOCOLO.endpoint}
      data-token={PROTOCOLO.token}
      data-instagram={ORG.redes[0]}
    >
      <header class="comando-meta">
        <span>FF/0915</span>
        <span data-progreso>01 / 07</span>
        <button type="button" data-cerrar-comando aria-label="Cerrar protocolo" hidden={modo === 'integrado'}>
          ESC
        </button>
      </header>

      <div class="comando-intercambio" aria-live="polite">
        <p class="comando-mensaje comando-sistema">
          <span class="comando-autor">PROTOCOLO</span>
          <span data-pregunta></span>
        </p>
        <p class="comando-mensaje comando-usuario" data-mensaje-usuario hidden>
          <span data-respuesta></span>
          <span class="comando-autor">TÚ</span>
        </p>
      </div>

      <div class="comando-control">
        <div class="comando-opciones" data-opciones></div>
        <label class="comando-entrada" data-entrada hidden>
          <span class="sr-only">Escribe tu respuesta</span>
          <input data-valor autocomplete="off" aria-describedby="protocolo-error" />
          <button type="submit">↵</button>
        </label>
      </div>

      {/* `role="alert"` y no el `aria-live="polite"` del acuse de contacto: esto
          no es un aviso de cortesía, es la razón por la que el visitante no
          avanza. Si no se anuncia al momento, quien usa lector de pantalla
          vuelve a pulsar Enter contra una pared silenciosa. Vacío no se pinta,
          así que no ocupa sitio mientras no hay error. */}
      <p class="comando-error" id="protocolo-error" data-error role="alert"></p>

      <p class="comando-ayuda" data-ayuda>Elige una respuesta · usa ← → y Enter</p>
    </form>

    <script is:inline type="application/json" data-protocolo-config set:html={JSON.stringify(protocolo)}></script>
  </div>
</div>

<script>
  /* La validación vive en `lib/protocolo.mjs` y no aquí porque
     `scripts/verificar-protocolo.mjs` la prueba dentro de `npm run check`. Un
     `.mjs` es lo único que Node puede importar sin compilar y que Vite puede
     meter en el bundle: la regla se escribe una vez y se prueba la misma que
     corre en el navegador. */
  import { validar } from '../../lib/protocolo.mjs';

  interface PasoComando {
    clave: string;
    pregunta: string;
    opciones?: string[];
    tipo?: string;
    autocomplete?: string;
    placeholder?: string;
  }

  interface EnvioProtocolo {
    id: string;
    token: string;
    origen: string;
    sello: number;
    intentos: number;
    respuestas: Record<string, string>;
  }

  /* LA COLA DE UN SOLO ELEMENTO. Quien completa las diez preguntas y pierde el
     envío por un túnel del metro es exactamente el lead que más caro sale de
     conseguir, así que el registro fallido se guarda y se reintenta al abrir
     cualquier página del sitio. Cinco intentos y se descarta: una entrada
     inmortal reintentando contra un endpoint mal configurado escribe basura en
     la hoja cada vez que el visitante vuelve. */
  const CLAVE_COLA = 'arcfox:protocolo-pendiente';
  const MAXIMO_INTENTOS = 5;

  /* `localStorage` lanza —no devuelve null— en Safari privado y con las cookies
     de terceros bloqueadas. Sin este envoltorio, un navegador con la privacidad
     apretada rompería el flujo entero por no poder guardar un reintento. */
  const guardar = (envio: EnvioProtocolo | null) => {
    try {
      if (envio) localStorage.setItem(CLAVE_COLA, JSON.stringify(envio));
      else localStorage.removeItem(CLAVE_COLA);
    } catch {
      /* Sin almacenamiento no hay reintento. El envío en curso no se ve afectado. */
    }
  };

  const pendiente = (): EnvioProtocolo | null => {
    try {
      const crudo = localStorage.getItem(CLAVE_COLA);
      return crudo ? (JSON.parse(crudo) as EnvioProtocolo) : null;
    } catch {
      return null;
    }
  };

  /** Identificador de envío. Lo usa la hoja para NO escribir dos veces la misma
      fila: sin él, un reintento sobre un POST que en realidad sí llegó duplica
      al invitado, y en una lista de invitaciones eso se nota. */
  const identificador = () =>
    crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`;

  const enviar = async (endpoint: string, envio: EnvioProtocolo) => {
    try {
      const respuesta = await fetch(endpoint, {
        method: 'POST',
        /* `text/plain` a propósito, y no `application/json`: mantiene el POST en
           el terreno de las «peticiones simples», así que el navegador no manda
           el preflight `OPTIONS` que una implementación web de Apps Script no
           contesta. El cuerpo sigue siendo JSON; lo parsea el script de la hoja. */
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(envio),
        /* La pestaña puede cerrarse en cuanto se lee el mensaje final. */
        keepalive: true,
      });
      if (!respuesta.ok) return false;
      const cuerpo = (await respuesta.json().catch(() => null)) as { ok?: boolean } | null;
      return cuerpo?.ok === true;
    } catch {
      return false;
    }
  };

  /* Reintento al cargar. Va fuera del bucle de instancias porque la cola es del
     visitante, no del componente: da igual en qué página aterrice después. */
  const reintentar = async () => {
    const envio = pendiente();
    const endpoint = document.querySelector<HTMLFormElement>('[data-endpoint]')?.dataset.endpoint;
    if (!envio || !endpoint) return;
    if (envio.intentos >= MAXIMO_INTENTOS) return guardar(null);
    guardar({ ...envio, intentos: envio.intentos + 1 });
    if (await enviar(endpoint, envio)) guardar(null);
  };

  document.querySelectorAll<HTMLElement>('[data-protocolo-comando]').forEach((raiz) => {
    const superficie = raiz.querySelector<HTMLElement>('.comando-superficie');
    const formulario = raiz.querySelector<HTMLFormElement>('.comando-panel');
    const config = raiz.querySelector<HTMLScriptElement>('[data-protocolo-config]');
    const pregunta = raiz.querySelector<HTMLElement>('[data-pregunta]');
    const progreso = raiz.querySelector<HTMLElement>('[data-progreso]');
    const opciones = raiz.querySelector<HTMLElement>('[data-opciones]');
    const entrada = raiz.querySelector<HTMLElement>('[data-entrada]');
    const valor = raiz.querySelector<HTMLInputElement>('[data-valor]');
    const mensajeUsuario = raiz.querySelector<HTMLElement>('[data-mensaje-usuario]');
    const respuesta = raiz.querySelector<HTMLElement>('[data-respuesta]');
    const ayuda = raiz.querySelector<HTMLElement>('[data-ayuda]');
    const error = raiz.querySelector<HTMLElement>('[data-error]');
    if (!superficie || !formulario || !config || !pregunta || !progreso || !opciones || !entrada || !valor || !mensajeUsuario || !respuesta || !ayuda || !error) return;

    const pasos = JSON.parse(config.textContent ?? '[]') as PasoComando[];
    const respuestas: Record<string, string> = {};
    let indice = 0;
    let avanzando = false;

    /* Sello anti-bot: milisegundos entre la carga y el envío. Diez preguntas no
       se contestan en tres segundos, así que la hoja puede descartar cualquier
       cosa por debajo de ese umbral sin riesgo de dejar fuera a un humano. Es la
       misma idea del formulario de contacto, y por el mismo motivo: un captcha
       lo paga quien sí es humano. */
    const inicio = Date.now();

    const limpiarError = () => {
      error.textContent = '';
      valor.removeAttribute('aria-invalid');
    };

    const mostrarError = (mensaje: string) => {
      error.textContent = mensaje;
      valor.setAttribute('aria-invalid', 'true');
      /* Ni se borra el campo ni se mueve el foco: quien escribió «ana@correo»
         quiere corregir dos letras, no volver a teclearlo entero. */
      valor.focus({ preventScroll: true });
    };

    /* El error desaparece al primer cambio, no al reenviar. Un mensaje en rojo
       que sigue ahí mientras ya estás corrigiendo dice que sigues equivocado. */
    valor.addEventListener('input', limpiarError);

    /* Un ancestro animado con `transform` redefine el bloque de un elemento
       fixed. Sacar sólo la superficie a `<body>` evita que la paleta se mida
       contra el pequeño contenedor del CTA. */
    if (raiz.dataset.modo === 'flotante') document.body.append(superficie);

    /* En Android el teclado reduce el viewport visual, pero un elemento fixed
       puede seguir anclado al viewport de layout y quedar detrás del teclado.
       La diferencia entre ambos viewports levanta sólo la paleta flotante. */
    const ajustarAlTeclado = () => {
      if (raiz.dataset.modo !== 'flotante') return;
      const vista = window.visualViewport;
      const teclado = vista ? Math.max(0, window.innerHeight - vista.height - vista.offsetTop) : 0;
      superficie.style.setProperty('--desplazamiento-teclado', `${teclado}px`);
    };

    window.visualViewport?.addEventListener('resize', ajustarAlTeclado);
    window.visualViewport?.addEventListener('scroll', ajustarAlTeclado);
    ajustarAlTeclado();

    const numeroVisible = () => Math.min(indice + 1, 7);

    const finalizar = async () => {
      opciones.replaceChildren();
      entrada.hidden = true;
      mensajeUsuario.hidden = true;
      limpiarError();
      formulario.dataset.completo = 'true';
      /* El evento se emite con las respuestas ya normalizadas y ANTES de saber
         si el POST llegó: es el enganche para ioZen y para analítica, y ninguno
         de los dos debería esperar a la hoja de cálculo. */
      formulario.dispatchEvent(new CustomEvent('protocolo:completo', { detail: respuestas }));

      const endpoint = formulario.dataset.endpoint ?? '';
      if (!endpoint) {
        /* Sin endpoint NO se dice «registrado». En local es la señal de que
           falta la variable; en producción, de que alguien la borró. */
        pregunta.textContent = 'Protocolo completado.';
        progreso.textContent = 'SIN DESTINO';
        ayuda.textContent = 'Prototipo local · falta PUBLIC_PROTOCOLO_ENDPOINT';
        return;
      }

      pregunta.textContent = 'Registrando tu perfil…';
      progreso.textContent = 'ENVIANDO';
      ayuda.textContent = '';

      const envio = {
        id: identificador(),
        token: formulario.dataset.token ?? '',
        origen: location.pathname,
        sello: Date.now() - inicio,
        intentos: 1,
        respuestas: { ...respuestas },
      };

      /* Se guarda ANTES de intentarlo. Si el navegador se cierra a mitad del
         POST, el registro sobrevive; si el POST va bien, se borra a la vuelta.
         El `id` hace que un reintento sobre un envío que sí había llegado no
         escriba una segunda fila. */
      guardar(envio);

      if (await enviar(endpoint, envio)) {
        guardar(null);
        pregunta.textContent = 'Tu perfil ha sido registrado. Revisa tus mensajes para recibir la invitación.';
        progreso.textContent = 'ACCESO REGISTRADO';
        ayuda.textContent = 'Te escribiremos por WhatsApp o Instagram';
        return;
      }

      /* El error da una salida y no culpa al visitante: sus datos están
         guardados y el reintento es automático. El enlace es el último recurso. */
      pregunta.textContent = 'No pudimos confirmar tu registro. Lo reintentaremos en cuanto vuelvas a tener conexión.';
      progreso.textContent = 'SIN CONEXIÓN';
      const instagram = formulario.dataset.instagram ?? '';
      ayuda.replaceChildren('Si prefieres, escríbenos por ');
      const enlace = document.createElement('a');
      enlace.href = instagram;
      enlace.target = '_blank';
      enlace.rel = 'noopener';
      enlace.textContent = 'Instagram';
      ayuda.append(enlace);
    };

    const elegir = (texto: string) => {
      if (avanzando) return;
      avanzando = true;
      respuestas[pasos[indice]!.clave] = texto;
      respuesta.textContent = texto;
      mensajeUsuario.hidden = false;
      opciones.querySelectorAll<HTMLButtonElement>('button').forEach((boton) => (boton.disabled = true));
      setTimeout(() => {
        indice += 1;
        mensajeUsuario.hidden = true;
        avanzando = false;
        /* `void`: el envío es asíncrono pero la interfaz ya no depende de él —
           `finalizar()` pinta sus propios estados. */
        if (indice < pasos.length) pintar();
        else void finalizar();
      }, 420);
    };

    const pintar = () => {
      const paso = pasos[indice]!;
      limpiarError();
      pregunta.textContent = paso.pregunta;
      progreso.textContent = `${String(numeroVisible()).padStart(2, '0')} / 07`;
      opciones.replaceChildren();
      formulario.dataset.completo = 'false';

      if (paso.opciones) {
        entrada.hidden = true;
        opciones.hidden = false;
        opciones.dataset.cantidad = String(paso.opciones.length);
        ayuda.textContent = 'Elige una respuesta · usa ← → y Enter';
        paso.opciones.forEach((texto, opcionIndice) => {
          const boton = document.createElement('button');
          boton.type = 'button';
          boton.textContent = texto;
          boton.dataset.indice = String(opcionIndice);
          boton.addEventListener('click', () => elegir(texto));
          opciones.append(boton);
        });
        opciones.querySelector<HTMLButtonElement>('button')?.focus({ preventScroll: true });
      } else {
        opciones.hidden = true;
        delete opciones.dataset.cantidad;
        entrada.hidden = false;
        valor.type = paso.tipo ?? 'text';
        valor.setAttribute('autocomplete', paso.autocomplete ?? 'off');
        valor.value = '';
        valor.placeholder = paso.placeholder ?? 'Escribe aquí…';
        ayuda.textContent = 'Enter para confirmar';
        valor.focus({ preventScroll: true });
        ajustarAlTeclado();
        if (raiz.dataset.modo === 'integrado') {
          superficie.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    };

    const abrir = raiz.querySelector<HTMLElement>('[data-abrir-comando]');
    abrir?.addEventListener('click', () => {
      indice = 0;
      avanzando = false;
      Object.keys(respuestas).forEach((clave) => delete respuestas[clave]);
      superficie.hidden = false;
      abrir.setAttribute('aria-expanded', 'true');
      pintar();
    });

    superficie.querySelector<HTMLElement>('[data-cerrar-comando]')?.addEventListener('click', () => {
      superficie.hidden = true;
      abrir?.setAttribute('aria-expanded', 'false');
      abrir?.focus();
    });

    formulario.addEventListener('submit', (evento) => {
      evento.preventDefault();
      if (entrada.hidden || avanzando) return;

      /* La validación del navegador se queda corta justo donde importa:
         `type="email"` acepta `ana@correo` y `type="tel"` no valida NADA. Por
         eso la regla es nuestra, y por eso normaliza además de comprobar — lo
         que se guarda es lo que alguien va a marcar en WhatsApp una por una. */
      const resultado = validar(pasos[indice]!.clave, valor.value);
      if (!resultado.ok) {
        mostrarError(resultado.error);
        return;
      }

      limpiarError();
      elegir(resultado.valor);
    });

    opciones.addEventListener('keydown', (evento) => {
      if (!['ArrowLeft', 'ArrowRight'].includes(evento.key)) return;
      const botones = [...opciones.querySelectorAll<HTMLButtonElement>('button')];
      const actual = botones.indexOf(document.activeElement as HTMLButtonElement);
      const delta = evento.key === 'ArrowRight' ? 1 : -1;
      botones[(actual + delta + botones.length) % botones.length]?.focus();
      evento.preventDefault();
    });

    if (raiz.dataset.modo === 'integrado') pintar();
  });

  /* Al final y sin `await`: el reintento de un registro anterior no puede
     retrasar el pintado de la puerta. */
  void reintentar();
</script>

<style>
  .comando-superficie {
    width: min(100% - 2rem, 54rem);
    margin: auto;
    border: 1px solid color-mix(in oklab, var(--color-superficie) 30%, transparent);
    color: var(--color-superficie);
    background: color-mix(in oklab, var(--color-marca) 94%, transparent);
    overflow: clip;
  }

  .comando-superficie[hidden] {
    display: none;
  }

  .comando-superficie.integrado {
    width: min(100% - 2rem, 64rem);
  }

  .comando-superficie.flotante {
    position: fixed;
    z-index: 50;
    bottom: max(
      calc(1rem + var(--desplazamiento-teclado, 0px)),
      calc(env(safe-area-inset-bottom) + var(--desplazamiento-teclado, 0px))
    );
    left: 50%;
    width: min(calc(100vw - 2rem), 54rem);
    margin: 0;
    transform: translateX(-50%);
  }

  .comando-panel {
    position: relative;
    display: grid;
    gap: 0;
    width: 100%;
    min-width: 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 34px, color-mix(in oklab, var(--color-campana-fria) 7%, transparent) 34px 35px),
      linear-gradient(108deg, color-mix(in oklab, var(--color-campana-fria) 22%, var(--color-marca)), color-mix(in oklab, var(--color-campana-calida) 15%, var(--color-marca)));
  }

  .comando-meta {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-superficie) 15%, transparent);
    font-family: var(--font-sans);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
  }

  .comando-meta button {
    justify-self: end;
    border: 0;
    color: color-mix(in oklab, var(--color-superficie) 60%, transparent);
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .comando-intercambio {
    display: grid;
    gap: 0.5rem;
    min-width: 0;
    min-height: 7.25rem;
    padding: 1.25rem 1.5rem 1rem;
  }

  .comando-mensaje {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    margin: 0;
  }

  .comando-usuario {
    grid-template-columns: 1fr 2rem;
    justify-self: end;
    max-width: 80%;
    text-align: right;
    color: color-mix(in oklab, var(--color-campana-fria) 42%, var(--color-superficie));
  }

  .comando-autor {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, var(--color-superficie) 40%, transparent);
  }

  [data-pregunta],
  [data-respuesta] {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.4vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .comando-control {
    min-width: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-superficie) 15%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-superficie) 15%, transparent);
  }

  .comando-opciones {
    display: flex;
    gap: 0;
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .comando-opciones::-webkit-scrollbar {
    display: none;
  }

  .comando-opciones :global(button) {
    /* Si las respuestas caben, reparten todo el ancho; si no, conservan su
       tamaño legible y activan el desplazamiento horizontal del contenedor. */
    flex: 1 0 auto;
